@* =====================================================
   DELETE FORM
   ===================================================== *@

<form asp-controller="Allowance"
      asp-action="Delete"
      method="post"
      id="deleteAllowanceForm">

    @Html.AntiForgeryToken()


    <input type="hidden"
           id="deleteAllowanceCode"
           name="code" />

</form>



<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


<script>


    // =====================================================
    // MONTH NAMES
    // =====================================================

    const monthNames = {

        1: "Jan",
        2: "Feb",
        3: "Mar",
        4: "Apr",
        5: "May",
        6: "Jun",
        7: "Jul",
        8: "Aug",
        9: "Sep",
        10: "Oct",
        11: "Nov",
        12: "Dec"

    };



    // Temporary backup if Cancel is clicked

    let previousMonthSelection = "";



    // =====================================================
    // ACTIVE FLAG
    // =====================================================

    $("#ActiveFlag").on(
        "change",
        function () {


            if ($(this).is(":checked")) {

                $("#Active")
                    .val("Yes");


                $("#ActiveFlagText")
                    .text("Yes");

            }
            else {

                $("#Active")
                    .val("No");


                $("#ActiveFlagText")
                    .text("No");

            }

        }
    );



    // =====================================================
    // ADD ALLOWANCE
    // =====================================================

    function openAddAllowance() {


        $("#allowanceModalTitle")
            .text("Add Allowance");


        $("#allowanceForm")
            .attr(
                "action",
                '@Url.Action("Create", "Allowance")'
            );


        $("#allowanceForm")[0]
            .reset();


        $("#Code")
            .prop(
                "readonly",
                false
            );


        // Active Default No

        $("#ActiveFlag")
            .prop(
                "checked",
                false
            );


        $("#Active")
            .val("No");


        $("#ActiveFlagText")
            .text("No");


        // Apply Month Reset

        $("#ApplyMonth")
            .val("");


        $("#selectedMonthText")
            .text(
                "No month selected"
            );


        $(".month-check")
            .prop(
                "checked",
                false
            );


        $("#btnAllowanceSave")
            .removeClass(
                "btn-warning"
            )
            .addClass(
                "btn-success"
            )
            .html(
                '<i class="bi bi-save"></i> Save'
            );


        var modal =
            bootstrap.Modal
                .getOrCreateInstance(
                    document.getElementById(
                        "allowanceModal"
                    )
                );


        modal.show();

    }



    // =====================================================
    // EDIT ALLOWANCE
    // =====================================================

    function editAllowance(code) {


        $.ajax({

            url:
                '@Url.Action("GetAllowance", "Allowance")',

            type:
                "GET",

            data: {

                code: code

            },


            success: function (response) {


                if (!response.success) {

                    alert(
                        response.message
                    );

                    return;

                }


                var data =
                    response.data;


                $("#allowanceModalTitle")
                    .text(
                        "Edit Allowance"
                    );


                $("#allowanceForm")
                    .attr(
                        "action",
                        '@Url.Action("Update", "Allowance")'
                    );


                $("#Code")
                    .val(data.code)
                    .prop(
                        "readonly",
                        true
                    );


                $("#Name")
                    .val(
                        data.name || ""
                    );


                $("#ShortName")
                    .val(
                        data.shortName || ""
                    );


                $("#GLC")
                    .val(
                        data.glc ?? ""
                    );


                $("#Comp")
                    .val(
                        data.comp || ""
                    );


                $("#EffectOnPay")
                    .val(
                        data.effectOnPay || ""
                    );


                $("#EffectOnTrf")
                    .val(
                        data.effectOnTrf || ""
                    );


                $("#TrfMinDays")
                    .val(
                        data.trfMinDays ?? ""
                    );



                // =========================================
                // ACTIVE
                // =========================================

                if (
                    data.active &&
                    data.active
                        .toString()
                        .toLowerCase() === "yes"
                ) {

                    $("#ActiveFlag")
                        .prop(
                            "checked",
                            true
                        );


                    $("#Active")
                        .val("Yes");


                    $("#ActiveFlagText")
                        .text("Yes");

                }
                else {

                    $("#ActiveFlag")
                        .prop(
                            "checked",
                            false
                        );


                    $("#Active")
                        .val("No");


                    $("#ActiveFlagText")
                        .text("No");

                }



                // =========================================
                // APPLY MONTH
                // =========================================

                var applyMonths =
                    data.applyMonth || "";


                $("#ApplyMonth")
                    .val(
                        applyMonths
                    );


                updateSelectedMonthText(
                    applyMonths
                );


                setMonthCheckboxes(
                    applyMonths
                );



                $("#btnAllowanceSave")
                    .removeClass(
                        "btn-success"
                    )
                    .addClass(
                        "btn-warning"
                    )
                    .html(
                        '<i class="bi bi-pencil-square"></i> Update'
                    );


                var modal =
                    bootstrap.Modal
                        .getOrCreateInstance(
                            document.getElementById(
                                "allowanceModal"
                            )
                        );


                modal.show();

            },


            error: function () {

                alert(
                    "Unable to load allowance."
                );

            }

        });

    }



    // =====================================================
    // OPEN MONTH SELECTOR
    // =====================================================

    function openMonthSelector() {


        previousMonthSelection =
            $("#ApplyMonth").val() || "";


        setMonthCheckboxes(
            previousMonthSelection
        );


        // Hide Allowance Modal

        var allowanceModal =
            bootstrap.Modal
                .getInstance(
                    document.getElementById(
                        "allowanceModal"
                    )
                );


        if (allowanceModal) {

            allowanceModal.hide();

        }


        // Wait then show Month Modal

        setTimeout(
            function () {


                var monthModal =
                    bootstrap.Modal
                        .getOrCreateInstance(
                            document.getElementById(
                                "monthModal"
                            )
                        );


                monthModal.show();

            },
            200
        );

    }



    // =====================================================
    // SAVE MONTH SELECTION
    // =====================================================

    function saveMonthSelection() {


        var selectedMonths = [];


        $(".month-check:checked")
            .each(
                function () {


                    selectedMonths.push(
                        parseInt(
                            $(this).val()
                        )
                    );

                }
            );


        selectedMonths.sort(
            function (a, b) {

                return a - b;

            }
        );


        var value =
            selectedMonths.join(",");


        $("#ApplyMonth")
            .val(value);


        updateSelectedMonthText(
            value
        );


        closeMonthModalAndReturn();

    }



    // =====================================================
    // CANCEL MONTH SELECTION
    // =====================================================

    function cancelMonthSelection() {


        setMonthCheckboxes(
            previousMonthSelection
        );


        closeMonthModalAndReturn();

    }



    // =====================================================
    // CLOSE MONTH MODAL AND RETURN
    // =====================================================

    function closeMonthModalAndReturn() {


        var monthModal =
            bootstrap.Modal
                .getInstance(
                    document.getElementById(
                        "monthModal"
                    )
                );


        if (monthModal) {

            monthModal.hide();

        }


        setTimeout(
            function () {


                var allowanceModal =
                    bootstrap.Modal
                        .getOrCreateInstance(
                            document.getElementById(
                                "allowanceModal"
                            )
                        );


                allowanceModal.show();

            },
            200
        );

    }



    // =====================================================
    // SET MONTH CHECKBOXES
    // =====================================================

    function setMonthCheckboxes(
        value
    ) {


        $(".month-check")
            .prop(
                "checked",
                false
            );


        if (!value) {

            return;

        }


        var months =
            value
                .toString()
                .split(",");


        months.forEach(
            function (month) {


                month =
                    month.trim();


                $("#month" + month)
                    .prop(
                        "checked",
                        true
                    );

            }
        );

    }



    // =====================================================
    // DISPLAY SELECTED MONTH NAMES
    // =====================================================

    function updateSelectedMonthText(
        value
    ) {


        if (!value) {

            $("#selectedMonthText")
                .text(
                    "No month selected"
                );

            return;

        }


        var monthNumbers =
            value
                .toString()
                .split(",")
                .filter(
                    function (x) {

                        return x !== "";

                    }
                );


        var names =
            monthNumbers
                .map(
                    function (number) {

                        return monthNames[number];

                    }
                )
                .filter(
                    function (name) {

                        return name != null;

                    }
                );


        if (names.length === 0) {

            $("#selectedMonthText")
                .text(
                    "No month selected"
                );

        }
        else {

            $("#selectedMonthText")
                .text(
                    names.join(", ")
                );

        }

    }



    // =====================================================
    // DELETE
    // =====================================================

    function confirmDelete(
        code,
        name
    ) {


        var result =
            confirm(
                "Are you sure you want to delete allowance?\n\n" +
                "Code: " + code + "\n" +
                "Name: " + name
            );


        if (!result) {

            return;

        }


        $("#deleteAllowanceCode")
            .val(code);


        $("#deleteAllowanceForm")
            .submit();

    }



    // =====================================================
    // SEARCH
    // =====================================================

    $("#allowanceSearch")
        .on(
            "keyup",
            function () {


                var value =
                    $(this)
                        .val()
                        .toLowerCase();


                $("#allowanceTable tbody tr")
                    .filter(
                        function () {


                            $(this)
                                .toggle(
                                    $(this)
                                        .text()
                                        .toLowerCase()
                                        .indexOf(value) > -1
                                );

                        }
                    );

            }
        );


</script>