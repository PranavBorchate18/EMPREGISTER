@model IEnumerable<Employee_Management_System.Models.AllowanceMaster>

@{
    ViewData["Title"] = "Allowance Master";
}


<div class="container mt-4 mb-5">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3 class="text-center mb-0">

                <i class="bi bi-cash-stack me-2"></i>

                Allowance Master

            </h3>

        </div>


        <div class="card-body">


            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }



            <div class="d-flex justify-content-between mb-3">

                <button type="button"
                        class="btn btn-primary"
                        onclick="openAddAllowance()">

                    <i class="bi bi-plus-circle"></i>

                    Add Allowance

                </button>


                <div style="width:300px;">

                    <input type="text"
                           id="allowanceSearch"
                           class="form-control"
                           placeholder="Search Allowance..." />

                </div>

            </div>



            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle"
                       id="allowanceTable">

                    <thead class="table-dark">

                        <tr>

                            <th>Code</th>

                            <th>Name</th>

                            <th>Short Name</th>

                            <th>G/L Code</th>

                            <th>Comp</th>

                            <th>Effect On Pay</th>

                            <th>Effect On Trf</th>

                            <th>Trf Min Days</th>

                            <th>Apply Month</th>

                            <th>Active</th>

                            <th style="width:130px;">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.Code
                                </td>

                                <td>
                                    @item.Name
                                </td>

                                <td>
                                    @item.ShortName
                                </td>

                                <td>
                                    @item.GLC
                                </td>

                                <td>
                                    @item.Comp
                                </td>

                                <td>
                                    @item.EffectOnPay
                                </td>

                                <td>
                                    @item.EffectOnTrf
                                </td>

                                <td>
                                    @item.TrfMinDays
                                </td>


                                <td>
                                    @item.ApplyMonth
                                </td>


                                <td>

                                    @if (
                                        string.Equals(
                                            item.Active,
                                            "Yes",
                                            StringComparison.OrdinalIgnoreCase
                                        )
                                    )
                                    {
                                        <span class="badge bg-success">
                                            Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            No
                                        </span>
                                    }

                                </td>


                                <td>

                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            onclick="editAllowance(@item.Code)">

                                        <i class="bi bi-pencil-square"></i>

                                    </button>


                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            onclick="confirmDelete(
                                                    @item.Code,
                                                    '@Html.Raw(
                                                        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(
                                                            item.Name ?? ""
                                                        )
                                                    )'
                                            )">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>



@* =====================================================
   ADD / EDIT ALLOWANCE MODAL
   ===================================================== *@

<div class="modal fade"
     id="allowanceModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <form method="post"
                  id="allowanceForm">

                @Html.AntiForgeryToken()


                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title"
                        id="allowanceModalTitle">

                        Add Allowance

                    </h5>


                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>



                <div class="modal-body">


                    @* CODE + NAME *@

                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Allowance Code

                                <span class="text-danger">*</span>

                            </label>


                            <input type="number"
                                   id="Code"
                                   name="Code"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">

                                Allowance Name

                                <span class="text-danger">*</span>

                            </label>


                            <input type="text"
                                   id="Name"
                                   name="Name"
                                   maxlength="30"
                                   class="form-control"
                                   required />

                        </div>

                    </div>



                    @* SHORT NAME + G/L *@

                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">
                                Short Name
                            </label>


                            <input type="text"
                                   id="ShortName"
                                   name="ShortName"
                                   maxlength="15"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">
                                G/L Code
                            </label>


                            <input type="number"
                                   id="GLC"
                                   name="GLC"
                                   class="form-control" />

                        </div>

                    </div>



                    @* COMP + EFFECT ON PAY + EFFECT ON TRF *@

                    <div class="row">


                        <div class="col-md-4 mb-3">

                            <label class="form-label fw-bold">
                                Comp
                            </label>


                            <select id="Comp"
                                    name="Comp"
                                    class="form-select">

                                <option value="">
                                    -- Select --
                                </option>

                                <option value="Y">
                                    Yes
                                </option>

                                <option value="N">
                                    No
                                </option>

                            </select>

                        </div>


                        <div class="col-md-4 mb-3">

                            <label class="form-label fw-bold">
                                Effect On Pay
                            </label>


                            <select id="EffectOnPay"
                                    name="EffectOnPay"
                                    class="form-select">

                                <option value="">
                                    -- Select --
                                </option>

                                <option value="Y">
                                    Yes
                                </option>

                                <option value="N">
                                    No
                                </option>

                            </select>

                        </div>


                        <div class="col-md-4 mb-3">

                            <label class="form-label fw-bold">
                                Effect On Trf
                            </label>


                            <select id="EffectOnTrf"
                                    name="EffectOnTrf"
                                    class="form-select">

                                <option value="">
                                    -- Select --
                                </option>

                                <option value="Y">
                                    Yes
                                </option>

                                <option value="N">
                                    No
                                </option>

                            </select>

                        </div>

                    </div>



                    @* ================================================
                       TRF MIN DAYS + ACTIVE
                       ================================================ *@

                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold">
                                Trf Min Days
                            </label>


                            <input type="number"
                                   step="any"
                                   id="TrfMinDays"
                                   name="TrfMinDays"
                                   class="form-control" />

                        </div>



                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold d-block">
                                Active
                            </label>


                            <div class="form-check form-switch mt-2">

                                <input class="form-check-input"
                                       type="checkbox"
                                       role="switch"
                                       id="ActiveFlag"
                                       style="
                                           width:48px;
                                           height:24px;
                                           cursor:pointer;
                                       " />


                                <label class="form-check-label ms-2 fw-bold"
                                       for="ActiveFlag"
                                       id="ActiveFlagText">

                                    No

                                </label>


                                <input type="hidden"
                                       id="Active"
                                       name="Active"
                                       value="No" />

                            </div>

                        </div>

                    </div>



                    @* ================================================
                       APPLY FOR MONTH
                       ================================================ *@

                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-bold d-block">

                                Apply for Month

                            </label>


                            <button type="button"
                                    class="btn btn-outline-primary"
                                    onclick="openMonthSelector()">

                                <i class="bi bi-calendar3"></i>

                                Apply for Month

                            </button>


                            @* Actual numeric values *@

                            <input type="hidden"
                                   id="ApplyMonth"
                                   name="ApplyMonth" />


                            @* Selected month names shown here *@

                            <div id="selectedMonthText"
                                 class="form-control mt-2 bg-light"
                                 style="min-height:38px;">

                                No month selected

                            </div>

                        </div>


                    </div>


                </div>



                <div class="modal-footer">


                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        <i class="bi bi-x-circle"></i>

                        Cancel

                    </button>


                    <button type="submit"
                            id="btnAllowanceSave"
                            class="btn btn-success">

                        <i class="bi bi-save"></i>

                        Save

                    </button>


                </div>


            </form>

        </div>

    </div>

</div>



