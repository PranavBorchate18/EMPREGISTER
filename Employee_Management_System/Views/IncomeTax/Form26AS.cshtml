@{
    ViewData["Title"] = "Form 26AS";
}

<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-1">Form 26AS</h4>
            <div>Tax Credit Statement</div>
        </div>

        <div class="card-body p-4">
            <p>
                Form 26AS provides tax-related information associated
                with your PAN, including available TDS/TCS details,
                tax payments, and other applicable tax credit information.
            </p>

            <div class="alert alert-info">
                <strong>Important:</strong>
                The official Form 26AS must be accessed through the
                Income Tax e-Filing portal. This application page
                does not generate an official government tax statement.
            </div>

            <h5 class="mt-4">How to Access Form 26AS</h5>

            <ol class="mb-4">
                <li>Log in to the Income Tax e-Filing portal.</li>
                <li>Navigate to the e-File section.</li>
                <li>Select the View Form 26AS option, if available.</li>
                <li>
                    Complete the required authentication and view
                    or download your tax statement.
                </li>
            </ol>

            <a href="https://www.incometax.gov.in/"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-primary">
                <i class="bi bi-box-arrow-up-right me-2"></i>
                Open Income Tax Portal
            </a>

            <div class="text-muted small mt-3">
                Portal menu names and navigation steps may change.
                Follow the latest instructions provided on the
                official Income Tax portal.
            </div>
        </div>
    </div>
</div>
