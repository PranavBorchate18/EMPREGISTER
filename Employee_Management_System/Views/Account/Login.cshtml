@model Employee_Management_System.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;

    string workingDateValue =
        ViewBag.WorkingDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login - Employee Management System</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 50%, #e5f0ff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-page {
            width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        .login-card {
            width: 100%;
            max-width: 560px;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(0,0,0,.13);
        }

        .login-header {
            background: linear-gradient(135deg, #0d6efd, #1f78ff);
            color: white;
            text-align: center;
            padding: 35px 25px;
        }

        .login-icon {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .login-header h2 {
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .login-header p {
            margin: 0;
            opacity: .9;
        }

        .login-body {
            padding: 38px 40px;
        }

        .login-label {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .login-input-group {
            height: 52px;
        }

        .login-input-icon {
            width: 55px;
            justify-content: center;
            font-size: 20px;
            background: #f1f3f5;
        }

        .login-input {
            font-size: 16px;
        }

        .btn-login {
            height: 52px;
            font-size: 17px;
            font-weight: 600;
            margin-top: 10px;
        }

        .login-footer {
            margin-top: 25px;
            color: #6c757d;
            font-size: 14px;
            text-align: center;
        }

        @@media(max-width:576px) {
            .login-body {
                padding: 28px 22px;
            }

            .login-header h2 {
                font-size: 23px;
            }
        }
    </style>
</head>

<body>

    <div class="login-page">

        <div class="login-card">

            <div class="login-header">

                <div class="login-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <h2>Employee Management System</h2>

                <p>Login to continue</p>

            </div>

            <div class="login-body">

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-4">

                        <label asp-for="LoginId"
                               class="login-label">

                            Login ID
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group login-input-group">

                            <span class="input-group-text login-input-icon">
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <input asp-for="LoginId"
                                   id="LoginId"
                                   type="text"
                                   class="form-control login-input"
                                   placeholder="Enter Login ID"
                                   autocomplete="off"
                                   autofocus />

                        </div>

                        <span asp-validation-for="LoginId"
                              class="text-danger small">
                        </span>

                    </div>

                    <!-- WORKING DATE -->
                    <div class="mb-4">

                        <label for="WorkingDate"
                               class="login-label">

                            Working Date
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group login-input-group">

                            <span class="input-group-text login-input-icon">
                                <i class="bi bi-calendar-date-fill"></i>
                            </span>

                            <input id="WorkingDate"
                                   name="workingDate"
                                   type="date"
                                   class="form-control login-input"
                                   value="@workingDateValue"
                                   required />

                        </div>

                    </div>

                    <div class="d-grid">

                        <button type="submit"
                                class="btn btn-primary btn-login">

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Login

                        </button>

                    </div>

                </form>

            </div>

        </div>

        <div class="login-footer">
            © @DateTime.Now.Year Employee Management System
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

</body>

</html>
