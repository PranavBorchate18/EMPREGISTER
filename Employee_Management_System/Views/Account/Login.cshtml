@model Employee_Management_System.Models.LoginViewModel
@using Employee_Management_System.Models

@{
    ViewData["Title"] = "Login";
    Layout = null;

    string workingDateValue =
        ViewBag.WorkingDate as string
        ?? DateTime.Today.ToString("yyyy-MM-dd");

    var existing =
        ViewBag.ExistingSession as ActiveLoginSession;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login - Employee Management System</title>

    <link rel="stylesheet"
          href="/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient( 135deg, #f8fbff 0%, #eef5ff 50%, #e5f0ff 100% );
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-page {
            width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }

        .login-card {
            width: 100%;
            max-width: 560px;
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(0,0,0,.13);
        }

        .login-header {
            background: linear-gradient( 135deg, #0d6efd, #1f78ff );
            color: #fff;
            text-align: center;
            padding: 35px 25px;
        }

        .login-icon {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .login-header h2 {
            font-size: 29px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .login-header p {
            margin: 0;
            opacity: .9;
        }

        .login-body {
            padding: 38px 40px;
        }

        .login-label {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .login-input-group {
            height: 52px;
        }

        .login-input-icon {
            width: 55px;
            justify-content: center;
            font-size: 20px;
            background: #f1f3f5;
        }

        .login-input {
            font-size: 16px;
        }

        .btn-login {
            height: 52px;
            font-size: 17px;
            font-weight: 600;
            margin-top: 10px;
        }

        .login-footer {
            margin-top: 25px;
            color: #6c757d;
            font-size: 14px;
            text-align: center;
        }

        @@media(max-width:576px) {
            .login-body {
                padding: 28px 22px;
            }

            .login-header h2 {
                font-size: 23px;
            }
        }
    </style>
</head>

<body>

    <div class="login-page">

        <div class="login-card">

            <div class="login-header">

                <div class="login-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <h2>Employee Management System</h2>

                <p>Login to continue</p>

            </div>

            <div class="login-body">

                <!-- Explicit POST action -->
                <form id="loginForm"
                      action="/Account/Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="forceLogin"
                           id="forceLogin"
                           value="false" />

                    <input type="hidden"
                           name="expectedSessionToken"
                           id="expectedSessionToken"
                           value="@(ViewBag.ExpectedSessionToken as string ?? "")" />

                    <!-- Server-side errors -->
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-3"
                             role="alert">

                            <ul class="mb-0">

                                @foreach (
                                                            var entry in ViewData.ModelState.Values
                                                            )
                                {
                                    foreach (var error in entry.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }

                            </ul>

                        </div>
                    }

                    <!-- Client-side errors -->
                    <div id="loginClientMessage"
                         class="alert alert-warning d-none"
                         role="alert">
                    </div>

                    <!-- LOGIN ID -->
                    <div class="mb-4">

                        <label for="LoginId"
                               class="login-label">

                            Login ID
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group login-input-group">

                            <span class="input-group-text login-input-icon">
                                <i class="bi bi-person-fill"></i>
                            </span>

                            <input type="text"
                                   id="LoginId"
                                   name="LoginId"
                                   value="@Model?.LoginId"
                                   class="form-control login-input"
                                   placeholder="Enter Login ID"
                                   autocomplete="off"
                                   required
                                   autofocus />

                        </div>

                    </div>

                    <!-- WORKING DATE -->
                    <div class="mb-4">

                        <label for="WorkingDate"
                               class="login-label">

                            Working Date
                            <span class="text-danger">*</span>

                        </label>

                        <div class="input-group login-input-group">

                            <span class="input-group-text login-input-icon">
                                <i class="bi bi-calendar-date-fill"></i>
                            </span>

                            <input type="date"
                                   id="WorkingDate"
                                   name="workingDate"
                                   class="form-control login-input"
                                   value="@workingDateValue"
                                   required />

                        </div>

                    </div>

                    <!-- LOGIN BUTTON -->
                    <div class="d-grid">

                        <button type="submit"
                                id="btnLogin"
                                class="btn btn-primary btn-login">

                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Login

                        </button>

                    </div>

                </form>

            </div>

        </div>

        <div class="login-footer">
            © @DateTime.Now.Year Employee Management System
        </div>

    </div>

    <!-- EXISTING ACTIVE SESSION POPUP -->
    @if (existing != null)
    {
        <div class="modal fade"
             id="activeSessionModal"
             tabindex="-1"
             aria-labelledby="activeSessionTitle"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title"
                            id="activeSessionTitle">

                            <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>

                            Already Logged In

                        </h5>

                    </div>

                    <div class="modal-body">

                        <p>
                            This account is already logged in.
                            Existing active session:
                        </p>

                        <dl class="row mb-0">

                            <dt class="col-5">Browser</dt>
                            <dd class="col-7">@existing.BrowserName</dd>

                            <dt class="col-5">Device</dt>
                            <dd class="col-7">@existing.DeviceName</dd>

                            <dt class="col-5">IP Address</dt>
                            <dd class="col-7">@existing.IpAddress</dd>

                            <dt class="col-5">Login Time (UTC)</dt>
                            <dd class="col-7">
                                @existing.LoginTimeUtc.ToString("dd-MM-yyyy HH:mm")
                            </dd>

                        </dl>

                        <p class="mt-3 mb-0">
                            Logout the previous session and continue here?
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                id="cancelTakeover">

                            No, Cancel

                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                id="confirmTakeover">

                            Yes, Continue

                        </button>

                    </div>

                </div>

            </div>

        </div>
    }

    <script src="/lib/jquery/dist/jquery.min.js"></script>

    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("loginForm");

            const loginId = document.getElementById("LoginId");

            const workingDate = document.getElementById("WorkingDate");

            const clientMessage =
                document.getElementById("loginClientMessage");

            // Diagnostic message for browser developer tools.
            console.log("Login form initialized.");
            console.log("Form method:", form.method);
            console.log("Form action:", form.action);

            form.addEventListener("invalid", function () {

                clientMessage.textContent =
                    "Please enter Login ID and Working Date.";

                clientMessage.classList.remove("d-none");

            }, true);

            form.addEventListener("submit", function (event) {

                clientMessage.classList.add("d-none");

                if (!loginId.value.trim()) {

                    event.preventDefault();

                    clientMessage.textContent =
                        "Please enter Login ID.";

                    clientMessage.classList.remove("d-none");

                    loginId.focus();

                    return;
                }

                if (!workingDate.value) {

                    event.preventDefault();

                    clientMessage.textContent =
                        "Please select Working Date.";

                    clientMessage.classList.remove("d-none");

                    workingDate.focus();

                    return;
                }

                console.log(
                    "Submitting POST request to:",
                    form.action
                );

                // Allow normal browser POST submission.
            });

        });
    </script>

    @if (existing != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const modalElement =
                    document.getElementById("activeSessionModal");

                if (!modalElement) {
                    return;
                }

                if (typeof bootstrap === "undefined") {
                    console.error(
                        "Bootstrap JavaScript is not loaded."
                    );
                    return;
                }

                const modal = new bootstrap.Modal(
                    modalElement,
                    {
                        backdrop: "static",
                        keyboard: false
                    }
                );

                modal.show();

                document.getElementById("cancelTakeover")
                    .addEventListener("click", function () {

                        document.getElementById("forceLogin").value =
                            "false";

                        document.getElementById(
                            "expectedSessionToken"
                        ).value = "";

                        modal.hide();
                    });

                document.getElementById("confirmTakeover")
                    .addEventListener("click", function () {

                        document.getElementById("forceLogin").value =
                            "true";

                        // requestSubmit runs normal validation
                        // and submit handlers.
                        document.getElementById(
                            "loginForm"
                        ).requestSubmit();
                    });

            });
        </script>
    }

</body>
</html>
