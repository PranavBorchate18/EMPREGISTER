@model List<Employee_Management_System.Models.SalaryReportEmployeeRowViewModel>
@using System.Collections.Generic
@{
    Layout = null;
    // Controller sends only visible columns for the branch being printed.
    // Any allowance/deduction hidden on Salary Report is excluded here.
    var allowanceNames = ViewBag.AllowanceNames as List<string> ?? new List<string>();
    var deductionNames = ViewBag.DeductionNames as List<string> ?? new List<string>();
    int branchCode = ViewBag.BranchCode;
    string branchName = ViewBag.BranchName ?? "";
    string fromMonthName = ViewBag.FromMonthName ?? "";
    int fromYear = ViewBag.FromYear;
    string toMonthName = ViewBag.ToMonthName ?? "";
    int toYear = ViewBag.ToYear;
    DateTime printDate = ViewBag.PrintDate ?? DateTime.Now;

    double totalBasic = Model.Sum(x => x.BasicSalary);
    double totalAllowance = Model.Sum(x => x.TotalAllowance);
    double totalGross = Model.Sum(x => x.GrossSalary);
    double totalDeduction = Model.Sum(x => x.TotalDeduction);
    double totalNet = Model.Sum(x => x.NetSalary);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Salary Report - @branchName</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #f5f7fb;
            font-family: Arial, Helvetica, sans-serif;
            color: #172b4d;
        }

        .print-sheet {
            background: #fff;
            margin: 18px auto;
            padding: 20px;
            border: 1px solid #9fb3c8;
            border-radius: 6px;
            max-width: 1800px;
        }

        .report-title {
            text-align: center;
            font-weight: 800;
            letter-spacing: .5px;
            margin-bottom: 8px;
        }

        .report-meta {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 16px;
            margin-bottom: 12px;
        }

        .branch-info {
            font-weight: 700;
            line-height: 1.8;
        }

        .period-row {
            border: 2px solid #0d6efd;
            border-radius: 5px;
            padding: 8px 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
            flex-wrap: nowrap;
            white-space: nowrap;
            font-weight: 700;
        }

        .print-info {
            text-align: right;
            white-space: nowrap;
        }

        .salary-table {
            font-size: 12px;
            margin-bottom: 0;
        }

            .salary-table th,
            .salary-table td {
                white-space: nowrap;
                vertical-align: middle;
                border-color: #b9c8d6;
            }

            .salary-table thead th {
                background: #dceeff;
                text-align: center;
                font-weight: 700;
            }

        .branch-total td {
            background: #dceeff !important;
            font-weight: 800;
        }

        .no-data {
            padding: 35px;
            text-align: center;
            font-weight: 600;
            color: #6c757d;
        }

        @@media print {
            @@page {
                size: A4 landscape;
                margin: 8mm;
            }

            body {
                background: #fff;
            }

            .no-print {
                display: none !important;
            }

            .print-sheet {
                margin: 0;
                padding: 0;
                border: 0;
                max-width: none;
            }

            .salary-table {
                font-size: 8px;
            }

                .salary-table th,
                .salary-table td {
                    padding: 3px 4px;
                }

            .period-row {
                border: 1px solid #444;
                padding: 5px 8px;
                gap: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="print-sheet">
        <div class="d-flex justify-content-end gap-2 mb-2 no-print">
            <button type="button" class="btn btn-primary" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> Print
            </button>
            <button type="button" class="btn btn-secondary" onclick="window.close()">
                <i class="bi bi-arrow-left me-1"></i> Back
            </button>
        </div>

        <h2 class="report-title">SALARY REPORT</h2>

        <div class="report-meta">
            <div class="branch-info">
                <div>Branch Code&nbsp;&nbsp;: @branchCode</div>
                <div>Branch Name&nbsp;: @branchName</div>
            </div>

            <div class="period-row">
                <span>From Month : @fromMonthName</span>
                <span>|</span>
                <span>From Year : @fromYear</span>
                <span>|</span>
                <span>To Month : @toMonthName</span>
                <span>|</span>
                <span>To Year : @toYear</span>
            </div>

            <div class="print-info">
                <strong>Print Date :</strong> @printDate.ToString("dd-MM-yyyy hh:mm tt")
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="border rounded no-data">
                No saved salary data found for the selected branch and period.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered salary-table">
                    <thead>
                        <tr>
                            <th>Sr.No.</th>
                            <th>Emp Code</th>
                            <th>Employee Name</th>
                            <th>Grade</th>
                            <th>Basic</th>
                            @foreach (var name in allowanceNames)
                            {
                                <th>@name</th>
                            }
                            <th>Total Allowance</th>
                            <th>Gross Salary</th>
                            @foreach (var name in deductionNames)
                            {
                                <th>@name</th>
                            }
                            <th>Total Deduction</th>
                            <th>Net Salary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int sr = 1;
                        }
                        @foreach (var emp in Model)
                        {
                            <tr>
                                <td class="text-center">@sr</td>
                                <td class="text-center fw-bold">@emp.EmployeeCode</td>
                                <td>@emp.EmployeeName</td>
                                <td>@(string.IsNullOrWhiteSpace(emp.GradeName) ? "-" : emp.GradeName)</td>
                                <td class="text-end">₹@emp.BasicSalary.ToString("N2")</td>

                                @foreach (var name in allowanceNames)
                                {
                                    double value = emp.Allowances.TryGetValue(name, out var amount) ? amount : 0;
                                    <td class="text-end">₹@value.ToString("N2")</td>
                                }

                                <td class="text-end fw-bold">₹@emp.TotalAllowance.ToString("N2")</td>
                                <td class="text-end fw-bold">₹@emp.GrossSalary.ToString("N2")</td>

                                @foreach (var name in deductionNames)
                                {
                                    double value = emp.Deductions.TryGetValue(name, out var amount) ? amount : 0;
                                    <td class="text-end">₹@value.ToString("N2")</td>
                                }

                                <td class="text-end fw-bold">₹@emp.TotalDeduction.ToString("N2")</td>
                                <td class="text-end fw-bold">₹@emp.NetSalary.ToString("N2")</td>
                            </tr>
                            sr++;
                        }

                        <tr class="branch-total">
                            <td colspan="4" class="text-center">Branch Total</td>
                            <td class="text-end">₹@totalBasic.ToString("N2")</td>

                            @foreach (var name in allowanceNames)
                            {
                                double total = Model.Sum(x =>
                                x.Allowances.TryGetValue(name, out var amount) ? amount : 0);
                                <td class="text-end">₹@total.ToString("N2")</td>
                            }

                            <td class="text-end">₹@totalAllowance.ToString("N2")</td>
                            <td class="text-end">₹@totalGross.ToString("N2")</td>

                            @foreach (var name in deductionNames)
                            {
                                double total = Model.Sum(x =>
                                x.Deductions.TryGetValue(name, out var amount) ? amount : 0);
                                <td class="text-end">₹@total.ToString("N2")</td>
                            }

                            <td class="text-end">₹@totalDeduction.ToString("N2")</td>
                            <td class="text-end">₹@totalNet.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</body>
</html>
