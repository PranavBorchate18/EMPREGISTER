@model Employee_Management_System.Models.LeaveMaster

@{
    ViewData["Title"] = "Add New Leave";
}

<div class="container-fluid py-3">

    <div class="card shadow-sm">

        <!-- HEADER -->
        <div class="card-header bg-white py-3">

            <h3 class="fw-bold mb-1">
                <i class="bi bi-plus-circle me-2"></i>
                Add New Leave
            </h3>

            <div class="text-muted">
                Add new leave type in Leave Master
            </div>

        </div>


        <div class="card-body">

            <!-- VALIDATION -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <form asp-controller="LeaveMaster"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- =============================================
                     ROW 1
                     CODE / NAME / SHORT NAME
                ============================================== -->

                <div class="row mb-3">

                    <!-- LEAVE CODE -->
                    <div class="col-md-4">

                        <label asp-for="Code"
                               class="form-label fw-semibold">
                            Leave Code
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Code"
                               type="text"
                               class="form-control"
                               readonly />

                        <span asp-validation-for="Code"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- LEAVE TYPE -->
                    <div class="col-md-5">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Leave Type
                            <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter leave type" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- SHORT NAME -->
                    <div class="col-md-3">

                        <label asp-for="ShortName"
                               class="form-label fw-semibold">
                            Short Name
                        </label>

                        <input asp-for="ShortName"
                               class="form-control"
                               placeholder="Short name" />

                        <span asp-validation-for="ShortName"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =============================================
                     ROW 2
                     PERMANENT / TEMPORARY
                ============================================== -->

                <div class="row mb-3">

                    <div class="col-md-4">

                        <label asp-for="PermanentYear"
                               class="form-label fw-semibold">
                            Permanent Year
                        </label>

                        <input asp-for="PermanentYear"
                               type="number"
                               step="1"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="PermanentYear"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="PermanentMonth"
                               class="form-label fw-semibold">
                            Permanent Month
                        </label>

                        <input asp-for="PermanentMonth"
                               type="number"
                               step="1"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="PermanentMonth"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4">

                        <label asp-for="TemporaryMonth"
                               class="form-label fw-semibold">
                            Temporary Month
                        </label>

                        <input asp-for="TemporaryMonth"
                               type="number"
                               step="1"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="TemporaryMonth"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =============================================
                     ROW 3
                     STORE
                ============================================== -->

                <div class="row mb-3">

                    <!-- STORE Y/N -->
                    <div class="col-md-4">

                        <label asp-for="StoreYN"
                               class="form-label fw-semibold">
                            Store Y/N
                        </label>

                        <select asp-for="StoreYN"
                                class="form-select">

                            <option value="">Select</option>
                            <option value="Y">Yes</option>
                            <option value="N">No</option>

                        </select>

                        <span asp-validation-for="StoreYN"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- STORE LIMIT -->
                    <div class="col-md-4">

                        <label asp-for="StoreLimit"
                               class="form-label fw-semibold">
                            Store Limit
                        </label>

                        <input asp-for="StoreLimit"
                               type="number"
                               step="1"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="StoreLimit"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CASH LIMIT -->
                    <div class="col-md-4">

                        <label asp-for="CashLimit"
                               class="form-label fw-semibold">
                            Cash Limit
                        </label>

                        <input asp-for="CashLimit"
                               type="number"
                               step="1"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="CashLimit"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =============================================
                     ROW 4
                     FLAG / LEAVE LIMIT / MIN LIMIT
                ============================================== -->

                <div class="row mb-4">

                    <!-- FLAG -->
                    <div class="col-md-4">

                        <label asp-for="Flag"
                               class="form-label fw-semibold">
                            Flag
                        </label>

                        <input asp-for="Flag"
                               class="form-control"
                               placeholder="Enter flag" />

                        <span asp-validation-for="Flag"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- LEAVE LIMIT -->
                    <div class="col-md-4">

                        <label asp-for="LeaveLimit"
                               class="form-label fw-semibold">
                            Leave Limit
                        </label>

                        <input asp-for="LeaveLimit"
                               type="number"
                               step="1"
                               min="0"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="LeaveLimit"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- MINIMUM LIMIT -->
                    <div class="col-md-4">

                        <label asp-for="MinimumLimit"
                               class="form-label fw-semibold">
                            Minimum Limit
                        </label>

                        <input asp-for="MinimumLimit"
                               type="number"
                               step="1"
                               min="0"
                               class="form-control"
                               placeholder="0" />

                        <span asp-validation-for="MinimumLimit"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- =============================================
                     BUTTONS
                ============================================== -->

                <div class="border-top pt-3 d-flex
                            justify-content-end gap-2">

                    <!-- CANCEL -->
                    <a asp-controller="LeaveMaster"
                       asp-action="Index"
                       class="btn btn-secondary px-4">

                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel

                    </a>


                    <!-- SAVE -->
                    <button type="submit"
                            class="btn btn-success px-4">

                        <i class="bi bi-save me-1"></i>
                        Save Leave

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}