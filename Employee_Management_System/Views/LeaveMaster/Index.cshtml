@model IEnumerable<Employee_Management_System.Models.LeaveMaster>

@{
    ViewData["Title"] = "Leave Master";
    string searchText = ViewBag.Search as string ?? "";
}

<div class="container-fluid py-3">
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h3 class="fw-bold mb-1">
                        <i class="bi bi-journal-text me-2"></i> Leave Master
                    </h3>
                    <div class="text-muted">Search, add, edit and activate/deactivate leave types</div>
                </div>

                <a asp-controller="LeaveMaster" asp-action="Create"
                   class="btn btn-success px-4">
                    <i class="bi bi-plus-circle me-1"></i> Add New
                </a>
            </div>
        </div>

        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border mb-4">
                <div class="card-header bg-light">
                    <strong class="text-primary">
                        <i class="bi bi-search me-2"></i> Search Leave Type
                    </strong>
                </div>
                <div class="card-body">
                    <form asp-controller="LeaveMaster" asp-action="Index" method="get">
                        <div class="row g-3 align-items-end">
                            <div class="col-lg-8 col-md-7">
                                <label class="form-label fw-semibold">Leave Type</label>
                                <input type="text" name="search" value="@searchText"
                                       class="form-control" placeholder="Enter leave type..." />
                            </div>
                            <div class="col-lg-4 col-md-5">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-search me-1"></i> Search
                                </button>
                                <a asp-controller="LeaveMaster" asp-action="Index"
                                   class="btn btn-secondary px-4">
                                    <i class="bi bi-arrow-clockwise me-1"></i> Clear
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong class="text-primary">
                        <i class="bi bi-list-ul me-2"></i> Leave Type List
                    </strong>
                    <span>Total Records : <strong>@(Model?.Count() ?? 0)</strong></span>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center">Sr.</th>
                                    <th>Code</th>
                                    <th>Leave Type</th>
                                    <th>Short Name</th>
                                    <th class="text-center">Leave Limit</th>
                                    <th class="text-center">Store Limit</th>
                                    <th class="text-center">Cash Limit</th>
                                    <th class="text-center">Active / Deactive</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    int srNo = 1;
                                    foreach (var item in Model)
                                    {
                                        bool isActive = string.Equals(
                                        item.Active?.Trim(), "Y",
                                        StringComparison.OrdinalIgnoreCase);

                                        <tr>
                                            <td class="text-center">@srNo</td>
                                            <td><strong>@item.Code</strong></td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Name) ? "-" : item.Name)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.ShortName) ? "-" : item.ShortName)</td>
                                            <td class="text-center">@(item.LeaveLimit?.ToString("0.##") ?? "-")</td>
                                            <td class="text-center">@(item.StoreLimit?.ToString("0.##") ?? "-")</td>
                                            <td class="text-center">@(item.CashLimit?.ToString("0.##") ?? "-")</td>

                                            <td class="text-center">
                                                <form asp-controller="LeaveMaster"
                                                      asp-action="ToggleActive"
                                                      method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Code" />

                                                    <button type="submit"
                                                            class="status-switch @(isActive ? "status-on" : "status-off")"
                                                            title="@(isActive ? "Click to deactivate" : "Click to activate")">
                                                        <span class="switch-text">@(isActive ? "ON" : "OFF")</span>
                                                        <span class="switch-knob"></span>
                                                    </button>
                                                </form>
                                            </td>

                                            <td class="text-center">
                                                <a asp-controller="LeaveMaster" asp-action="Edit"
                                                   asp-route-id="@item.Code"
                                                   class="btn btn-primary btn-sm">
                                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                                </a>
                                            </td>
                                        </tr>
                                        srNo++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-5">
                                            No leave types found.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table th {
        white-space: nowrap;
        font-weight: 600;
    }

    .table td {
        vertical-align: middle;
    }

    .card {
        border-radius: 6px;
    }

    .btn {
        border-radius: 5px;
    }

    .status-switch {
        position: relative;
        width: 76px;
        height: 34px;
        border: 0;
        border-radius: 20px;
        padding: 0;
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
    }

    .status-on {
        background: #198754;
        color: white;
        padding-right: 25px;
    }

    .status-off {
        background: #dc3545;
        color: white;
        padding-left: 25px;
    }

    .switch-knob {
        position: absolute;
        top: 4px;
        width: 26px;
        height: 26px;
        background: white;
        border-radius: 50%;
        box-shadow: 0 1px 4px rgba(0,0,0,.3);
    }

    .status-on .switch-knob {
        right: 4px;
    }

    .status-off .switch-knob {
        left: 4px;
    }

    .switch-text {
        line-height: 34px;
    }
</style>
