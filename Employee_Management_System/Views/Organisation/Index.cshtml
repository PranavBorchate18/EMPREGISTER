@{
    ViewData["Title"] = "Organisation Selection";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Organisation Selection</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #eaf1ff, #f5f7fb);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .organisation-card {
            width: 100%;
            max-width: 440px;
            background: #fff;
            border-radius: 16px;
            padding: 35px;
            box-shadow: 0 12px 35px rgba(0,0,0,.10);
        }

        .organisation-icon {
            width: 65px;
            height: 65px;
            border-radius: 15px;
            background: #e8efff;
            color: #2457c5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin: 0 auto 18px;
        }

        .form-control {
            height: 48px;
            border-radius: 8px;
        }

        .btn-continue {
            height: 48px;
            border-radius: 8px;
            font-weight: 600;
            background: #2457c5;
            border: none;
        }

            .btn-continue:hover {
                background: #19449f;
            }

        .form-control:focus {
            border-color: #2457c5;
            box-shadow: 0 0 0 .2rem rgba(36, 87, 197, .12);
        }
    </style>
</head>

<body>

    <div class="organisation-card">

        <div class="text-center">
            <div class="organisation-icon">
                <i class="bi bi-building"></i>
            </div>

            <h4 class="fw-bold mb-2">Organisation Selection</h4>

            <p class="text-muted mb-4">
                Enter your Organisation Code to continue
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>
                @ViewBag.Error
            </div>
        }

        @* Fixed path: Url.Action("Index","Organisation") returns "/" because it is the
           default route, and the session guard in Program.cs blocked POST to "/". *@
        <form action="@Url.Content("~/Organisation/Index")"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label for="code" class="form-label fw-semibold">
                    Organisation Code
                </label>

                <input type="number"
                       id="code"
                       name="code"
                       class="form-control"
                       placeholder="Enter Organisation Code"
                       min="1"
                       step="1"
                       required
                       autofocus />

            </div>

            <button type="submit"
                    class="btn btn-primary btn-continue w-100">

                <i class="bi bi-arrow-right-circle me-2"></i>
                Continue

            </button>

        </form>

        <div class="text-center mt-4">
            <small class="text-muted">
                Employee Management System
            </small>
        </div>

    </div>

</body>
</html>
