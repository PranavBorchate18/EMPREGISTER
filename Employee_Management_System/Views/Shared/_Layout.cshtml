@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Employee_Management_System</title>

    <!-- Antiforgery token for AJAX requests -->
    <meta name="tab-antiforgery-token"
          content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/Employee_Management_System.styles.css"
          asp-append-version="true" />
</head>

<body>
    @{
        var currentLoginId = Context.Session.GetString("LoginId");
        var currentUserName = Context.Session.GetString("UserName");
        var currentAuthority = Context.Session.GetString("Authority");

        if (string.IsNullOrWhiteSpace(currentUserName))
        {
            currentUserName = currentLoginId;
        }

        if (string.IsNullOrWhiteSpace(currentUserName))
        {
            currentUserName = "User";
        }
    }

    <!-- Mobile sidebar button -->
    <button type="button" class="sidebar-toggle" id="sidebarToggle">
        <i class="bi bi-list"></i>
    </button>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <a class="sidebar-brand"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            <i class="bi bi-people-fill"></i>
            <span>Employee_<br />Management_System</span>
        </a>

        <ul class="sidebar-menu">
            <li>
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Home</span>
                </a>
            </li>

            <li>
                <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Privacy</span>
                </a>
            </li>

            <li>
                <a class="nav-link"
                   asp-controller="Employee"
                   asp-action="Register">
                    <i class="bi bi-person-fill-add"></i>
                    <span>Employee Registration</span>
                </a>
            </li>

            <!-- Master -->
            <li>
                <button class="nav-link sidebar-dropdown-btn"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#masterMenu"
                        aria-expanded="false"
                        aria-controls="masterMenu">
                    <i class="bi bi-database-fill"></i>
                    <span>Master</span>
                    <i class="bi bi-chevron-down ms-auto"></i>
                </button>

                <div class="collapse" id="masterMenu">
                    <div class="sidebar-submenu">
                        <a class="dropdown-item"
                           asp-controller="Allowance"
                           asp-action="Index">
                            <i class="bi bi-cash-stack me-2"></i>Allowance
                        </a>

                        <a class="dropdown-item"
                           asp-controller="Deduction"
                           asp-action="Index">
                            <i class="bi bi-dash-circle me-2"></i>Deduction
                        </a>
                    </div>
                </div>
            </li>

            <!-- Grade Wise Allow/Deduction -->
            <li>
                <button class="nav-link sidebar-dropdown-btn"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#gradeWiseMenu"
                        aria-expanded="false"
                        aria-controls="gradeWiseMenu">
                    <i class="bi bi-table"></i>
                    <span>Grade Wise<br />Allow/Deduction</span>
                    <i class="bi bi-chevron-down ms-auto"></i>
                </button>

                <div class="collapse" id="gradeWiseMenu">
                    <div class="sidebar-submenu">
                        <a class="dropdown-item"
                           asp-controller="GradeWiseAllowDeduction"
                           asp-action="Index"
                           asp-route-section="allowance">
                            <i class="bi bi-cash-stack me-2"></i>Allowance
                        </a>

                        <a class="dropdown-item"
                           asp-controller="GradeWiseAllowDeduction"
                           asp-action="Index"
                           asp-route-section="deduction">
                            <i class="bi bi-dash-circle me-2"></i>Deduction
                        </a>
                    </div>
                </div>
            </li>

            <li>
                <a class="nav-link"
                   asp-controller="EmployeePaySetup"
                   asp-action="Index">
                    <i class="bi bi-wallet2"></i>
                    <span>Employee Pay Setup</span>
                </a>
            </li>

            <li>
                <a class="nav-link"
                   asp-controller="SalaryRevision"
                   asp-action="Index">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Salary Revision</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   asp-controller="PayCalculation"
                   asp-action="Index">
                    <i class="bi bi-calculator me-2"></i>
                    <span>Pay Calculation</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   asp-controller="SalarySlip"
                   asp-action="Index">
                    <i class="bi bi-receipt-cutoff me-2"></i>
                    <span>Salary Slip</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link"
                   asp-controller="SalaryReport"
                   asp-action="Index">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>
                    <span>Salary Report</span>
                </a>
            </li>


            <!-- Income Tax Menu -->
            <li>
                <button class="nav-link sidebar-dropdown-btn"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#incomeTaxMenu"
                        aria-expanded="false"
                        aria-controls="incomeTaxMenu">

                    <i class="bi bi-file-earmark-text"></i>
                    <span>Income Tax</span>
                    <i class="bi bi-chevron-down ms-auto"></i>
                </button>

                <div class="collapse" id="incomeTaxMenu">
                    <div class="sidebar-submenu">

                        <a class="dropdown-item"
                           asp-controller="IncomeTax"
                           asp-action="Form16">
                            <i class="bi bi-file-earmark-pdf me-2"></i>
                            Form 16
                        </a>

                        <a class="dropdown-item"
                           asp-controller="IncomeTax"
                           asp-action="Form26AS">
                            <i class="bi bi-file-earmark-check me-2"></i>
                            Form 26AS
                        </a>

                    </div>
                </div>
            </li>


            <!-- Leave Application -->
            <li>
                <button class="nav-link sidebar-dropdown-btn"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#leaveMenu"
                        aria-expanded="false"
                        aria-controls="leaveMenu">
                    <i class="bi bi-calendar2-check-fill"></i>
                    <span>Leave Application</span>
                    <i class="bi bi-chevron-down ms-auto"></i>
                </button>

                <div class="collapse" id="leaveMenu">
                    <div class="sidebar-submenu">
                        <a class="dropdown-item"
                           asp-controller="Leave"
                           asp-action="Index">
                            <i class="bi bi-file-earmark-plus me-2"></i>
                            Leave Application
                        </a>

                        <a class="dropdown-item"
                           asp-controller="Leave"
                           asp-action="SanctionList">
                            <i class="bi bi-check2-square me-2"></i>
                            Leave Sanction
                        </a>

                        <a class="dropdown-item"
                           asp-controller="LeaveCredit"
                           asp-action="Index">
                            <i class="bi bi-calendar-plus me-2"></i>
                            Leave Credit
                        </a>

                        <a class="dropdown-item"
                           asp-controller="LeaveDebit"
                           asp-action="Index">
                            <i class="bi bi-calendar-minus me-2"></i>
                            Leave Debit
                        </a>

                        <a class="dropdown-item"
                           asp-controller="LeaveStatement"
                           asp-action="Index">
                            <i class="bi bi-file-earmark-text me-2"></i>
                            Leave Statement
                        </a>

                        <!-- NEW: Leave Balance Report -->
                        <a class="dropdown-item"
                           asp-controller="LeaveBalanceReport"
                           asp-action="Index">
                            <i class="bi bi-calendar-check me-2"></i>
                            Leave Balance Report
                        </a>

                        <a class="dropdown-item"
                           asp-controller="LeaveMaster"
                           asp-action="Index">
                            <i class="bi bi-journal-text me-2"></i>
                            Leave Master
                        </a>
                    </div>
                </div>
            </li>
        </ul>
    </aside>

    <!-- Top bar -->
    <header class="topbar">
        <div class="dropdown ms-auto">
            <button class="btn btn-link text-dark text-decoration-none dropdown-toggle d-flex align-items-center gap-2"
                    type="button"
                    id="userDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <i class="bi bi-person-circle"
                   style="font-size:27px;color:#0d6efd;"></i>
                <span style="font-size:15px;">@currentUserName</span>
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm"
                aria-labelledby="userDropdown"
                style="min-width:230px;">
                <li>
                    <div class="dropdown-item-text">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-person-circle"
                               style="font-size:30px;color:#0d6efd;"></i>
                            <div>
                                <strong>@currentUserName</strong>
                                <br />
                                <small class="text-muted">
                                    Login ID: @currentLoginId
                                </small>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(currentAuthority))
                        {
                            <small class="text-muted">
                                Authority: @currentAuthority
                            </small>
                        }
                    </div>
                </li>

                <li><hr class="dropdown-divider" /></li>

                <li>
                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="m-0 js-logout-form">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>

        <!-- Top-right Logout button -->
        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="ms-3 me-3 js-logout-form">
            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger d-inline-flex align-items-center gap-2">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </button>
        </form>
    </header>

    <!-- Main content -->
    <div class="main-wrapper">
        <main role="main" class="page-content">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container-fluid">
            &copy; 2026 - Employee_Management_System -
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Logout confirmation modal -->
    <div class="modal fade"
         id="logoutConfirmModal"
         tabindex="-1"
         aria-labelledby="logoutConfirmTitle"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutConfirmTitle">
                        <i class="bi bi-box-arrow-right text-danger me-2"></i>
                        Logout Confirmation
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    Are you sure you want to logout?
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        No, Cancel
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="btnConfirmLogout">
                        Yes, Logout
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sidebar and menu script -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("sidebar");
            const sidebarToggle = document.getElementById("sidebarToggle");

            if (sidebarToggle && sidebar) {
                sidebarToggle.addEventListener("click", function () {
                    sidebar.classList.toggle("show");
                });
            }

            document.querySelectorAll(
                "#sidebar a.nav-link, #sidebar a.dropdown-item"
            ).forEach(function (link) {
                link.addEventListener("click", function () {
                    if (window.innerWidth < 992 && sidebar) {
                        sidebar.classList.remove("show");
                    }
                });
            });

            const currentPath = window.location.pathname.toLowerCase();

            function openMenu(menuId, buttonSelector) {
                const menu = document.getElementById(menuId);
                const button = document.querySelector(buttonSelector);

                if (menu) {
                    menu.classList.add("show");
                }

                if (button) {
                    button.setAttribute("aria-expanded", "true");
                }
            }

            if (currentPath.startsWith("/allowance") ||
                currentPath.startsWith("/deduction")) {
                openMenu(
                    "masterMenu",
                    '[data-bs-target="#masterMenu"]'
                );
            }

            if (currentPath.startsWith("/gradewiseallowdeduction")) {
                openMenu(
                    "gradeWiseMenu",
                    '[data-bs-target="#gradeWiseMenu"]'
                );
            }

            if (currentPath.startsWith("/leave")) {
                openMenu(
                    "leaveMenu",
                    '[data-bs-target="#leaveMenu"]'
                );
            }

            if (currentPath.startsWith("/leavebalancereport")) {
                openMenu(
                    "leaveMenu",
                    '[data-bs-target="#leaveMenu"]'
                );
            }
        });
    </script>

    <!-- Logout confirmation for both Logout forms -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modalElement =
                document.getElementById("logoutConfirmModal");

            const confirmButton =
                document.getElementById("btnConfirmLogout");

            if (!modalElement || !confirmButton ||
                typeof bootstrap === "undefined") {
                console.error("Logout confirmation modal could not initialize.");
                return;
            }

            const logoutModal =
                bootstrap.Modal.getOrCreateInstance(modalElement);

            let requestedLogoutForm = null;

            document.querySelectorAll("form.js-logout-form")
                .forEach(function (form) {
                    form.addEventListener("submit", function (event) {
                        event.preventDefault();
                        requestedLogoutForm = form;
                        logoutModal.show();
                    });
                });

            confirmButton.addEventListener("click", function () {
                if (!requestedLogoutForm) {
                    return;
                }

                confirmButton.disabled = true;

                // Native submission preserves the anti-forgery field.
                requestedLogoutForm.submit();
            });

            modalElement.addEventListener("hidden.bs.modal", function () {
                requestedLogoutForm = null;
                confirmButton.disabled = false;
            });
        });
    </script>

    <!-- Single Active Tab script -->
    <script src="~/js/single-active-tab.js"
            asp-append-version="true"></script>

    <!-- Page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
