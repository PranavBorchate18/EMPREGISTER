@model IEnumerable<Employee_Management_System.Models.DeductionMaster>

@{
    ViewData["Title"] = "Deduction Master";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3 class="text-center mb-0">
                <i class="bi bi-dash-circle me-2"></i>
                Deduction Master
            </h3>
        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }


            <div class="d-flex justify-content-between mb-3">

                <button type="button"
                        class="btn btn-primary"
                        onclick="openAddDeduction()">

                    <i class="bi bi-plus-circle"></i>
                    Add Deduction

                </button>


                <input type="text"
                       id="searchDeduction"
                       class="form-control"
                       style="max-width:300px;"
                       placeholder="Search Deduction..." />

            </div>


            <div class="table-responsive">

                <table class="table table-bordered table-hover"
                       id="deductionTable">

                    <thead class="table-dark">

                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Short Name</th>
                            <th>G/L Code</th>
                            <th>Comp</th>
                            <th>Flag</th>
                            <th>HO Cutting</th>
                            <th>Income Tax Report</th>
                            <th>Active</th>
                            <th>Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Code</td>

                                <td>@item.Name</td>

                                <td>@item.ShortName</td>

                                <td>@item.GLC</td>

                                <td>@item.Comp</td>

                                <td>@item.Flag</td>

                                <td>
                                    @(item.HOCutting == true ? "Yes" : "No")
                                </td>

                                <td>
                                    @(item.PrintInIncomeTaxReport == true
                                                                    ? "Yes"
                                                                    : "No")
                            </td>

                                <td>@item.Active</td>

                                <td>

                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            onclick="editDeduction(@item.Code)">

                                        <i class="bi bi-pencil-square"></i>

                                    </button>


                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            onclick="deleteDeduction(@item.Code)">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </td>

                            </tr>
                                                }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ===========================================================
     ADD / EDIT MODAL
     =========================================================== -->

<div class="modal fade"
     id="deductionModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <form method="post"
                  id="deductionForm">

                @Html.AntiForgeryToken()


                <div class="modal-header bg-primary text-white">

                    <h5 class="modal-title"
                        id="deductionModalTitle">

                        Add Deduction

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Deduction Code *
                            </label>

                            <input type="number"
                                   name="Code"
                                   id="Code"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Deduction Name *
                            </label>

                            <input type="text"
                                   name="Name"
                                   id="Name"
                                   maxlength="30"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Short Name
                            </label>

                            <input type="text"
                                   name="ShortName"
                                   id="ShortName"
                                   maxlength="15"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                G/L Code
                            </label>

                            <input type="number"
                                   name="GLC"
                                   id="GLC"
                                   class="form-control" />

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Comp
                            </label>

                            <select name="Comp"
                                    id="Comp"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Y">Yes</option>
                                <option value="N">No</option>

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Flag
                            </label>

                            <select name="Flag"
                                    id="Flag"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Y">Yes</option>
                                <option value="N">No</option>

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                HO Cutting
                            </label>

                            <select name="HOCutting"
                                    id="HOCutting"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Print In Income Tax Report
                            </label>

                            <select name="PrintInIncomeTaxReport"
                                    id="PrintInIncomeTaxReport"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>

                            </select>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Active
                            </label>

                            <select name="Active"
                                    id="Active"
                                    class="form-select">

                                <option value="">Select</option>
                                <option value="Y">Yes</option>
                                <option value="N">No</option>

                            </select>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-save"></i>
                        Save

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- DELETE FORM -->

<form asp-controller="Deduction"
      asp-action="Delete"
      method="post"
      id="deleteDeductionForm">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="code"
           id="DeleteCode" />

</form>


@section Scripts
{
    <script>

        var deductionModal;

        document.addEventListener("DOMContentLoaded", function () {

            deductionModal =
                new bootstrap.Modal(
                    document.getElementById("deductionModal")
                );


            // SEARCH
            document.getElementById("searchDeduction")
                .addEventListener("keyup", function () {

                    var value =
                        this.value.toLowerCase();

                    document
                        .querySelectorAll(
                            "#deductionTable tbody tr"
                        )
                        .forEach(function (row) {

                            row.style.display =
                                row.innerText
                                   .toLowerCase()
                                   .includes(value)
                                ? ""
                                : "none";

                        });

                });

        });


        function openAddDeduction() {

            document.getElementById(
                "deductionModalTitle"
            ).innerText = "Add Deduction";

            document.getElementById(
                "deductionForm"
            ).action =
                '@Url.Action("Create", "Deduction")';

            document.getElementById("Code").value = "";
            document.getElementById("Code").readOnly = false;

            document.getElementById("Name").value = "";
            document.getElementById("ShortName").value = "";
            document.getElementById("GLC").value = "";

            document.getElementById("Comp").value = "";
            document.getElementById("Flag").value = "";

            document.getElementById("HOCutting").value = "";
            document.getElementById(
                "PrintInIncomeTaxReport"
            ).value = "";

            document.getElementById("Active").value = "";

            deductionModal.show();
        }


        function editDeduction(code) {

            fetch(
                '@Url.Action("GetDeduction", "Deduction")'
                + '?code='
                + code
            )
            .then(response => response.json())
            .then(result => {

                if (!result.success) {

                    alert(result.message);
                    return;
                }

                var d = result.data;

                document.getElementById(
                    "deductionModalTitle"
                ).innerText = "Edit Deduction";

                document.getElementById(
                    "deductionForm"
                ).action =
                    '@Url.Action("Update", "Deduction")';


                document.getElementById("Code").value = d.code;
                document.getElementById("Code").readOnly = true;

                document.getElementById("Name").value =
                    d.name ?? "";

                document.getElementById("ShortName").value =
                    d.shortName ?? "";

                document.getElementById("GLC").value =
                    d.glc ?? "";

                document.getElementById("Comp").value =
                    d.comp ?? "";

                document.getElementById("Flag").value =
                    d.flag ?? "";

                document.getElementById("HOCutting").value =
                    d.hoCutting === null
                    ? ""
                    : d.hoCutting.toString();

                document.getElementById(
                    "PrintInIncomeTaxReport"
                ).value =
                    d.printInIncomeTaxReport === null
                    ? ""
                    : d.printInIncomeTaxReport.toString();

                document.getElementById("Active").value =
                    d.active ?? "";

                deductionModal.show();

            });

        }


        function deleteDeduction(code) {

            if (!confirm(
                "Are you sure you want to delete this deduction?"
            )) {
                return;
            }

            document.getElementById(
                "DeleteCode"
            ).value = code;

            document.getElementById(
                "deleteDeductionForm"
            ).submit();

        }

    </script>
}