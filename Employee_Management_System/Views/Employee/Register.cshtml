        // ============================================================
        // REMOVE STUCK MODAL BACKDROP
        // GREY SCREEN FIX
        // ============================================================

        function cleanModalBackdrop() {

            if (
                document.querySelector(
                    ".modal.show"
                )
            ) {

                return;

            }


            document
                .querySelectorAll(
                    ".modal-backdrop"
                )
                .forEach(
                    function (backdrop) {

                        backdrop.remove();

                    }
                );


            document.body
                .classList
                .remove(
                    "modal-open"
                );


            document.body.style
                .removeProperty(
                    "overflow"
                );


            document.body.style
                .removeProperty(
                    "padding-right"
                );


            document.documentElement.style
                .removeProperty(
                    "overflow"
                );

        }



        // ============================================================
        // HTML ESCAPE
        // ============================================================

        function escapeHtml(value) {

            if (
                value === null ||
                value === undefined
            ) {

                return "";

            }


            return $("<div>")
                .text(
                    value.toString()
                )
                .html();

        }

