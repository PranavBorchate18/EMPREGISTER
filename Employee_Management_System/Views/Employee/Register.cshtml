                            data.gender
                        );


                        $("#BirthDate")
                            .val(
                                data.birthDate || ""
                            );


                        $("#BloodGroup")
                            .val(
                                data.bloodGroup || ""
                            );


                        $("#IdentificationMark")
                            .val(
                                data.identificationMark || ""
                            );


                        $("#Height")
                            .val(
                                data.height == null
                                    ? ""
                                    : data.height
                            );


                        $("#KnownLanguage")
                            .val(
                                data.knownLanguage || ""
                            );


                        $("#MotherTongue")
                            .val(
                                data.motherTongue || ""
                            );


                        $("#Education")
                            .val(
                                data.education || ""
                            );


                        $("#ModeOfSign")
                            .val(
                                data.modeOfSign || ""
                            );


                        // ==============================================
                        // UPDATE MODE ENABLE
                        // ==============================================

                        enableExistingEmployeeMode();


                        // ==============================================
                        // CLOSE EXISTING MODAL
                        // ==============================================

                        var modalElement =
                            document.getElementById(
                                "ExistingEmployeeModal"
                            );


                        if (modalElement) {

                            var modal =
                                bootstrap.Modal
                                    .getOrCreateInstance(
                                        modalElement
                                    );

                            modal.hide();

                        }


                        // ==============================================
                        // FIX GREY SCREEN
                        // ==============================================

                        setTimeout(function () {

                            cleanModalBackdrop();


                            openEmployeeTab(
                                "general-tab"
                            );


                            window.scrollTo({
                                top: 0,
                                behavior: "smooth"
                            });


                            $("#CustomerSearchMessage")
                                .removeClass(
                                    "text-danger text-primary"
                                )
                                .addClass(
                                    "text-success"
                                )
                                .text(
                                    "Employee loaded successfully. Edit information and click Update Employee."
                                );

                        }, 400);

                    },

                error:
                    function (xhr) {

                        var message =
                            "Unable to load employee information.";


                        if (
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {

                            message =
                                xhr.responseJSON.message;

                        }


                        $("#ExistingSearchMessage")
                            .removeClass(
                                "text-primary text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                message
                            );

                    }

            });

        }



        // ============================================================
        // ENABLE UPDATE MODE AFTER EMPLOYEE SELECT
        // ============================================================

        function enableExistingEmployeeMode() {

            isUpdateMode = true;

            $("#EmployeeFormMode")
                .val(
                    "update"
                );


            // TITLE
            $("#registrationTitle")
                .text(
                    "Update Employee"
                );


            // TOP
            $("#btnSearchCustomer")
                .hide();


            $("#btnExistingData")
                .show();


            $("#EmployeeIdSearch")
                .prop(
                    "readonly",
                    true
                );


            // BOTTOM
            // ONLY CANCEL + EXIT
            $("#btnNewEmployee")
                .hide();

            $("#btnUpdateEmployee")
                .hide();

            $("#btnCancelEmployee")
                .hide();

            $("#btnViewEmployee")
                .hide();

            $("#btnCancelUpdate")
                .show();

            $("#btnExitEmployee")
                .show();


            // PERSONAL
            $("#btnSaveEmployee")
                .hide()
                .prop(
                    "disabled",
                    true
                );


            $("#btnFinalUpdateEmployee")
                .show()
                .prop(
                    "disabled",
                    false
                );

        }



