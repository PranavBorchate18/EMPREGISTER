        // ============================================================
        // SET GENDER
        // ============================================================

        function setGender(value) {

            $("input[name='Gender']")
                .prop(
                    "checked",
                    false
                );


            if (!value) {

                return;

            }


            var gender =
                value
                    .toString()
                    .trim()
                    .toUpperCase();


            if (
                gender === "M" ||
                gender === "MALE"
            ) {

                $("input[name='Gender'][value='M']")
                    .prop(
                        "checked",
                        true
                    );

            }
            else if (
                gender === "F" ||
                gender === "FEMALE"
            ) {

                $("input[name='Gender'][value='F']")
                    .prop(
                        "checked",
                        true
                    );

            }

        }



        // ============================================================
        // SEARCH RELIGION TABLE
        // ============================================================

        function searchReligion() {

            var input =
                document.getElementById(
                    "searchReligion"
                );


            var filter =
                input.value
                    .toUpperCase();


            var table =
                document.getElementById(
                    "religionTable"
                );


            if (!table) {

                return;

            }


            var rows =
                table.getElementsByTagName(
                    "tr"
                );


            for (
                var i = 0;
                i < rows.length;
                i++
            ) {

                var codeCell =
                    rows[i]
                        .getElementsByTagName(
                            "td"
                        )[0];


                var nameCell =
                    rows[i]
                        .getElementsByTagName(
                            "td"
                        )[1];


                if (
                    codeCell ||
                    nameCell
                ) {

                    var text =
                        (
                            (codeCell
                                ? codeCell.textContent
                                : "")
                            +
                            " "
                            +
                            (nameCell
                                ? nameCell.textContent
                                : "")
                        )
                        .toUpperCase();


                    rows[i].style.display =
                        text.indexOf(filter) > -1
                            ? ""
                            : "none";

                }

            }

        }



