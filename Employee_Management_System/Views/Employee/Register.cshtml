@model Employee_Management_System.Models.Employee

@{
    ViewData["Title"] = "Employee Registration";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Employee Registration</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
          rel="stylesheet" />

    <style>
        .card-header {
            background: #0d6efd;
            color: white;
        }

        .nav-tabs .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }

        .input-group .btn {
            width: 45px;
        }

        .form-label {
            font-weight: bold;
        }

        .btn {
            min-width: 100px;
        }
    </style>
</head>

<body>

    @* ============================================================
       SUCCESS POPUP
       ============================================================ *@

    @if (TempData["Success"] != null)
    {
        <div class="modal fade"
             id="employeeSuccessModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header bg-success text-white">

                        <h5 class="modal-title">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            Employee Created Successfully
                        </h5>

                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body text-center">

                        <h4 class="text-success mb-4">
                            @TempData["Success"]
                        </h4>

                        <p>
                            <strong>Customer Name:</strong>
                            <br />
                            @TempData["SuccessCustomerName"]
                        </p>

                        <p>
                            <strong>Employee Code:</strong>
                            <br />

                            <span class="fs-3 fw-bold text-success">
                                @TempData["SuccessEmployeeCode"]
                            </span>
                        </p>

                    </div>

                    <div class="modal-footer justify-content-center">

                        <button type="button"
                                class="btn btn-success"
                                data-bs-dismiss="modal">
                            OK
                        </button>

                    </div>

                </div>
            </div>
        </div>
    }


    <div class="container mt-4">

        <div class="card shadow">

            <div class="card-header">

                <h3 class="text-center">
                    Employee Registration
                </h3>

            </div>

            <div class="card-body">

                @* ==========================================
                   DATABASE / VALIDATION ERROR
                   ========================================== *@

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <form asp-action="Register"
                      method="post">


                    <!-- ==========================================
                         Customer Search
                    ========================================== -->

                    <div class="row mb-3">

                        <div class="col-md-2">

                            <label class="form-label fw-bold">
                                Customer ID
                            </label>

                        </div>

                        <div class="col-md-3">

                            <input type="text"
                                   id="EmployeeIdSearch"
                                   class="form-control"
                                   placeholder="Enter Customer ID"
                                   autocomplete="off" />

                            <!-- Hidden field - UI does not change -->
                            <input type="hidden"
                                   id="HiddenCustomerId"
                                   name="CustomerId"
                                   value="@Model.CustomerId" />

                        </div>

                        <div class="col-md-2">

                            <button type="button"
                                    id="btnSearchCustomer"
                                    class="btn btn-primary">
                                Search
                            </button>

                        </div>

                        <div class="col-md-5">

                            <span id="CustomerSearchMessage"
                                  class="fw-bold">
                            </span>

                        </div>

                    </div>


                    <hr />


                    <!-- ==========================================
                         Employee Information
                    ========================================== -->

                    <div class="row">

                        <!-- Employee Code -->

                        <div class="col-md-3 mb-3">

                            <label asp-for="EmployeeCode"
                                   class="form-label">
                                Employee Code
                            </label>

                            <input asp-for="EmployeeCode"
                                   id="EmployeeCode"
                                   class="form-control" />

                        </div>


                        <!-- Employee Name -->

                        <div class="col-md-5 mb-3">

                            <label asp-for="EmployeeName"
                                   class="form-label">
                                Employee Name
                            </label>

                            <input asp-for="EmployeeName"
                                   id="EmployeeName"
                                   class="form-control" />

                            <span asp-validation-for="EmployeeName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Employee Type -->

                        <div class="col-md-4 mb-3">

                            <label asp-for="EmployeeType"
                                   class="form-label">
                                Employee Type
                            </label>

                            <select asp-for="EmployeeType"
                                    id="EmployeeType"
                                    class="form-select">

                                <option value="">
                                    Select Type
                                </option>

                                <option value="1">
                                    Permanent
                                </option>

                                <option value="2">
                                    Temporary
                                </option>

                                <option value="3">
                                    Contract
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- ==========================================
                         Tabs
                    ========================================== -->

                    <ul class="nav nav-tabs">

                        <li class="nav-item">

                            <a class="nav-link active"
                               data-bs-toggle="tab"
                               href="#general">
                                General Information
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               data-bs-toggle="tab"
                               href="#other">
                                Other Information
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               data-bs-toggle="tab"
                               href="#address">
                                Address Information
                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               data-bs-toggle="tab"
                               href="#personal">
                                Personal Information
                            </a>

                        </li>

                    </ul>


                    <div class="tab-content border border-top-0 p-4">


                        <!-- =================================================
                             GENERAL INFORMATION
                        ================================================== -->

                        <div class="tab-pane fade show active"
                             id="general">

                            <div class="container mt-3">

                                <div class="row">

                                    <!-- Grade -->

                                    <div class="col-md-4">

                                        <label asp-for="GradeId"
                                               class="form-label fw-bold">
                                            Grade
                                        </label>

                                        <select asp-for="GradeId"
                                                asp-items="ViewBag.Grades"
                                                class="form-select">

                                            <option value="">
                                                -- Select Grade --
                                            </option>

                                        </select>

                                        <span asp-validation-for="GradeId"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Section -->

                                    <div class="col-md-4">

                                        <label asp-for="SectionId"
                                               class="form-label fw-bold">
                                            Section
                                        </label>

                                        <select asp-for="SectionId"
                                                asp-items="ViewBag.Sections"
                                                class="form-select">

                                            <option value="">
                                                -- Select Section --
                                            </option>

                                        </select>

                                        <span asp-validation-for="SectionId"
                                              class="text-danger">
                                        </span>

                                    </div>


                                    <!-- Branch -->

                                    <div class="col-md-4">

                                        <label asp-for="BranchId"
                                               class="form-label fw-bold">
                                            Branch
                                        </label>

                                        <select asp-for="BranchId"
                                                asp-items="ViewBag.Branches"
                                                class="form-select">

                                            <option value="">
                                                -- Select Branch --
                                            </option>

                                        </select>

                                        <span asp-validation-for="BranchId"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <div class="row mt-3">

                                    <div class="col-md-4">

                                        <label asp-for="JoiningDate"
                                               class="form-label fw-bold">
                                        </label>

                                        <input asp-for="JoiningDate"
                                               type="date"
                                               class="form-control" />

                                    </div>

                                    <div class="col-md-4">

                                        <label asp-for="PermanentDate"
                                               class="form-label fw-bold">
                                        </label>

                                        <input asp-for="PermanentDate"
                                               type="date"
                                               class="form-control" />

                                    </div>

                                    <div class="col-md-4">

                                        <label asp-for="LastSalaryDate"
                                               class="form-label fw-bold">
                                        </label>

                                        <input asp-for="LastSalaryDate"
                                               type="date"
                                               class="form-control" />

                                    </div>

                                </div>


                                <div class="row mt-3">

                                    <div class="col-md-4">

                                        <label asp-for="LastSalaryIncrementDate"
                                               class="form-label fw-bold">
                                        </label>

                                        <input asp-for="LastSalaryIncrementDate"
                                               type="date"
                                               class="form-control" />

                                    </div>

                                    <div class="col-md-4">

                                        <label asp-for="RetirementDate"
                                               class="form-label fw-bold">
                                        </label>

                                        <input asp-for="RetirementDate"
                                               type="date"
                                               class="form-control" />

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             OTHER INFORMATION
                        ================================================== -->

                        <div class="tab-pane fade"
                             id="other">

                            <div class="row mt-3">

                                <!-- Left Side -->

                                <div class="col-md-6">

                                    <div class="mb-3 row">

                                        <label class="col-md-6 col-form-label fw-bold">
                                            Pension Fund Open. Bal.
                                        </label>

                                        <div class="col-md-6">

                                            <input asp-for="PensionFundOpeningBalance"
                                                   class="form-control" />

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-6 col-form-label fw-bold">
                                            P.F. No.
                                        </label>

                                        <div class="col-md-6">

                                            <input asp-for="PFNumber"
                                                   class="form-control" />

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-6 col-form-label fw-bold">
                                            P.F. Opening Bal.
                                        </label>

                                        <div class="col-md-6">

                                            <input asp-for="PFOpeningBalance"
                                                   class="form-control" />

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-6 col-form-label fw-bold">
                                            PAN No.
                                        </label>

                                        <div class="col-md-6">

                                            <input asp-for="PANNumber"
                                                   id="PANNumber"
                                                   class="form-control" />

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-6 col-form-label fw-bold">
                                            S/B.G.L. Code
                                        </label>

                                        <div class="col-md-6">

                                            <div class="input-group">

                                                <input asp-for="SavingGLCode"
                                                       class="form-control" />

                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingGLModal">

                                                    <i class="bi bi-search"></i>

                                                </button>

                                            </div>

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-6 col-form-label fw-bold">
                                            S/B.Br. Code
                                        </label>

                                        <div class="col-md-6">

                                            <div class="input-group">

                                                <input asp-for="SavingBranchCode"
                                                       class="form-control" />

                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingBranchModal">

                                                    <i class="bi bi-search"></i>

                                                </button>

                                            </div>

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-6 col-form-label fw-bold">
                                            S/B.Ac. Code
                                        </label>

                                        <div class="col-md-6">

                                            <div class="input-group">

                                                <input asp-for="SavingAccountCode"
                                                       class="form-control" />

                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingAccountModal">

                                                    <i class="bi bi-search"></i>

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- Right Side -->

                                <div class="col-md-6">

                                    <div class="mb-3 row">

                                        <label class="col-md-5 col-form-label fw-bold">
                                            IT Sr. No.
                                        </label>

                                        <div class="col-md-7">

                                            <input asp-for="ITSerialNumber"
                                                   class="form-control" />

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-5 col-form-label fw-bold">
                                            P.F. Sr. No.
                                        </label>

                                        <div class="col-md-7">

                                            <input asp-for="PFSerialNumber"
                                                   class="form-control" />

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-5 col-form-label fw-bold">
                                            P.F. Balance
                                        </label>

                                        <div class="col-md-7">

                                            <input asp-for="PFBalance"
                                                   class="form-control" />

                                        </div>

                                    </div>


                                    <div class="mb-3 row">

                                        <label class="col-md-5 col-form-label fw-bold">
                                            Aadhaar No.
                                        </label>

                                        <div class="col-md-7">

                                            <input asp-for="AadhaarNumber"
                                                   id="AadhaarNumber"
                                                   class="form-control"
                                                   maxlength="12" />

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <div class="text-end mt-4">

                                <button type="button"
                                        class="btn btn-secondary">
                                    Previous
                                </button>

                                <button type="button"
                                        class="btn btn-primary">
                                    Next
                                </button>

                            </div>

                        </div>


                        <!-- =================================================
                             SAVING GL MODAL
                        ================================================== -->

                        <div class="modal fade"
                             id="SavingGLModal"
                             tabindex="-1">

                            <div class="modal-dialog modal-lg">

                                <div class="modal-content">

                                    <div class="modal-header bg-primary text-white">

                                        <h5 class="modal-title">
                                            Saving G/L Code
                                        </h5>

                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body">

                                        <p>
                                            Display Saving G/L Code list here.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             SAVING BRANCH MODAL
                        ================================================== -->

                        <div class="modal fade"
                             id="SavingBranchModal"
                             tabindex="-1">

                            <div class="modal-dialog modal-lg">

                                <div class="modal-content">

                                    <div class="modal-header bg-primary text-white">

                                        <h5 class="modal-title">
                                            Saving Branch Code
                                        </h5>

                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body">

                                        <p>
                                            Display Saving Branch list here.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             SAVING ACCOUNT MODAL
                        ================================================== -->

                        <div class="modal fade"
                             id="SavingAccountModal"
                             tabindex="-1">

                            <div class="modal-dialog modal-lg">

                                <div class="modal-content">

                                    <div class="modal-header bg-primary text-white">

                                        <h5 class="modal-title">
                                            Saving Account Code
                                        </h5>

                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body">

                                        <p>
                                            Display Saving Account Code list here.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             ADDRESS INFORMATION
                        ================================================== -->

                        <div class="tab-pane fade"
                             id="address">

                            <div class="container mt-3">

                                <div class="row">

                                    <div class="col-md-8 offset-md-1">


                                        <!-- Correspondence Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Correspondence Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="CorrespondenceAddress1"
                                                       class="form-control mb-2" />

                                                <input asp-for="CorrespondenceAddress2"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Permanent Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Permanent Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="PermanentAddress1"
                                                       class="form-control mb-2" />

                                                <input asp-for="PermanentAddress2"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Father's Name -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Father's Name
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="FatherName"
                                                       id="FatherName"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="Address1"
                                                       id="Address1"
                                                       class="form-control mb-2" />

                                                <input asp-for="Address2"
                                                       id="Address2"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <div class="text-end mt-4">

                                    <button type="button"
                                            class="btn btn-secondary">
                                        Previous
                                    </button>

                                    <button type="button"
                                            class="btn btn-primary">
                                        Next
                                    </button>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             PERSONAL INFORMATION
                        ================================================== -->

                        <div class="tab-pane fade"
                             id="personal">

                            <div class="container mt-3">

                                <div class="row">


                                    <!-- Left Side -->

                                    <div class="col-md-6">


                                        <!-- Religion -->

                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Religion
                                            </label>

                                            <div class="input-group">

                                                <input type="text"
                                                       id="ReligionSearch"
                                                       class="form-control"
                                                       placeholder="Search Religion"
                                                       readonly />

                                                <button type="button"
                                                        class="btn btn-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#ReligionModal">
                                                    🔍
                                                </button>

                                            </div>

                                            <input type="hidden"
                                                   asp-for="Religion"
                                                   id="ReligionId" />

                                        </div>


                                        <!-- Religion Modal -->

                                        <div class="modal fade"
                                             id="ReligionModal">

                                            <div class="modal-dialog modal-lg">

                                                <div class="modal-content">


                                                    <div class="modal-header">

                                                        <h5>
                                                            Select Religion
                                                        </h5>

                                                        <button type="button"
                                                                class="btn-close"
                                                                data-bs-dismiss="modal">
                                                        </button>

                                                    </div>


                                                    <div class="modal-body">

                                                        <input type="text"
                                                               id="searchReligion"
                                                               class="form-control mb-3"
                                                               placeholder="Search Religion"
                                                               onkeyup="searchReligion()" />


                                                        <table class="table table-bordered">

                                                            <thead>

                                                                <tr>
                                                                    <th>Code</th>
                                                                    <th>Religion</th>
                                                                    <th></th>
                                                                </tr>

                                                            </thead>


                                                            <tbody id="religionTable">

                                                                @foreach (var item in ViewBag.Religions)
                                                                {
                                                                    <tr>

                                                                        <td>
                                                                            @item.Code
                                                                        </td>

                                                                        <td>
                                                                            @item.ReligionName
                                                                        </td>

                                                                        <td>

                                                                            <button type="button"
                                                                                    class="btn btn-success btn-sm"
                                                                                    onclick="selectReligion('@item.Code','@item.ReligionName')">
                                                                                Select
                                                                            </button>

                                                                        </td>

                                                                    </tr>
                                                                }

                                                            </tbody>

                                                        </table>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- Caste -->

                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Caste
                                            </label>

                                            <div class="input-group">

                                                <input type="text"
                                                       id="CasteSearch"
                                                       class="form-control"
                                                       placeholder="Search Caste"
                                                       readonly />

                                                <button type="button"
                                                        class="btn btn-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#CasteModal">
                                                    🔍
                                                </button>

                                            </div>

                                            <input type="hidden"
                                                   asp-for="Caste"
                                                   id="CasteId" />

                                        </div>


                                        <!-- Caste Modal -->

                                        <div class="modal fade"
                                             id="CasteModal">

                                            <div class="modal-dialog modal-lg">

                                                <div class="modal-content">


                                                    <div class="modal-header">

                                                        <h5 class="modal-title">
                                                            Select Caste
                                                        </h5>

                                                        <button type="button"
                                                                class="btn-close"
                                                                data-bs-dismiss="modal">
                                                        </button>

                                                    </div>


                                                    <div class="modal-body">

                                                        <input type="text"
                                                               id="searchCaste"
                                                               class="form-control mb-3"
                                                               placeholder="Search Caste"
                                                               onkeyup="searchCaste()" />


                                                        <table class="table table-bordered table-hover">

                                                            <thead>

                                                                <tr>
                                                                    <th>Code</th>
                                                                    <th>Caste Name</th>
                                                                    <th>Action</th>
                                                                </tr>

                                                            </thead>


                                                            <tbody id="casteTable">

                                                                @foreach (var item in ViewBag.Castes)
                                                                {
                                                                    <tr>

                                                                        <td>
                                                                            @item.Code
                                                                        </td>

                                                                        <td>
                                                                            @item.CastName
                                                                        </td>

                                                                        <td>

                                                                            <button type="button"
                                                                                    class="btn btn-success btn-sm"
                                                                                    onclick="selectCaste('@item.Code','@item.CastName')">
                                                                                Select
                                                                            </button>

                                                                        </td>

                                                                    </tr>
                                                                }

                                                            </tbody>

                                                        </table>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- Gender -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Gender
                                            </label>

                                            <div class="col-md-7">

                                                <div class="form-check form-check-inline">

                                                    <input asp-for="Gender"
                                                           class="form-check-input"
                                                           type="radio"
                                                           value="M">

                                                    <label class="form-check-label">
                                                        Male
                                                    </label>

                                                </div>

                                                <div class="form-check form-check-inline">

                                                    <input asp-for="Gender"
                                                           class="form-check-input"
                                                           type="radio"
                                                           value="F">

                                                    <label class="form-check-label">
                                                        Female
                                                    </label>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- Birth Date -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Birth Date
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="BirthDate"
                                                       id="BirthDate"
                                                       type="date"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Identification Mark -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Identification Mark
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="IdentificationMark"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Known Language -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Known Language
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="KnownLanguage"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Education -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Education
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="Education"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Right Side -->

                                    <div class="col-md-6">


                                        <!-- Blood Group -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Blood Group
                                            </label>

                                            <div class="col-md-7">

                                                <select asp-for="BloodGroup"
                                                        class="form-select">

                                                    <option value="">
                                                        Select
                                                    </option>

                                                    <option>A+</option>
                                                    <option>A-</option>
                                                    <option>B+</option>
                                                    <option>B-</option>
                                                    <option>AB+</option>
                                                    <option>AB-</option>
                                                    <option>O+</option>
                                                    <option>O-</option>

                                                </select>

                                            </div>

                                        </div>


                                        <!-- Height -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Height
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="Height"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Mother Tongue -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Mother Tongue
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="MotherTongue"
                                                       class="form-control" />

                                            </div>

                                        </div>


                                        <!-- Mode of Sign -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Mode of Sign
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="ModeOfSign"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <div class="text-end mt-4">

                                    <button type="button"
                                            class="btn btn-secondary">
                                        Previous
                                    </button>

                                    <button type="submit"
                                            class="btn btn-success">
                                        Save Employee
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ==========================================
                         Existing Main Buttons
                    ========================================== -->

                    <div class="text-center mt-4">

                        <button type="reset"
                                class="btn btn-primary">

                            <i class="bi bi-plus-circle"></i>
                            New

                        </button>

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-save"></i>
                            Save

                        </button>

                        <button type="button"
                                class="btn btn-warning">

                            <i class="bi bi-pencil-square"></i>
                            Update

                        </button>

                        <button type="button"
                                class="btn btn-danger">

                            <i class="bi bi-trash"></i>
                            Delete

                        </button>

                        <button type="button"
                                class="btn btn-info text-white">

                            <i class="bi bi-eye"></i>
                            View

                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-box-arrow-right"></i>
                            Exit

                        </a>

                    </div>


                </form>

            </div>

        </div>

    </div>


    <!-- jQuery -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js">
    </script>


    <!-- Bootstrap JavaScript -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <script>

        // ============================================================
        // DOCUMENT READY
        // ============================================================

        $(document).ready(function () {

            console.log(
                "Register page JavaScript loaded."
            );


            // ========================================================
            // SHOW SUCCESS POPUP
            // ========================================================

            var successModalElement =
                document.getElementById(
                    "employeeSuccessModal"
                );

            if (successModalElement) {

                var successModal =
                    new bootstrap.Modal(
                        successModalElement
                    );

                successModal.show();
            }

                  // ========================================================
        // NEXT BUTTON
        // ========================================================

        $(".btn-next").on("click", function () {

            var currentTab =
                $(".nav-tabs .nav-link.active");

            var currentItem =
                currentTab.closest(".nav-item");

            var nextItem =
                currentItem.next(".nav-item");

            if (nextItem.length > 0) {

                var nextTabElement =
                    nextItem.find(".nav-link")[0];

                var nextTab =
                    new bootstrap.Tab(nextTabElement);

                nextTab.show();
            }
        });


        // ========================================================
        // PREVIOUS BUTTON
        // ========================================================

        $(".btn-previous").on("click", function () {

            var currentTab =
                $(".nav-tabs .nav-link.active");

            var currentItem =
                currentTab.closest(".nav-item");

            var previousItem =
                currentItem.prev(".nav-item");

            if (previousItem.length > 0) {

                var previousTabElement =
                    previousItem.find(".nav-link")[0];

                var previousTab =
                    new bootstrap.Tab(previousTabElement);

                previousTab.show();
            }
        });




            // ========================================================
            // CUSTOMER SEARCH BUTTON
            // ========================================================

            $("#btnSearchCustomer").on(
                "click",
                function () {

                    GetEmployee();

                }
            );


            // ========================================================
            // CUSTOMER ID ENTER KEY
            // ========================================================

            $("#EmployeeIdSearch").on(
                "keydown",
                function (e) {

                    if (e.key === "Enter") {

                        e.preventDefault();

                        GetEmployee();
                    }

                }
            );

        });


        // ============================================================
        // GET CUSTOMER INFORMATION
        // ============================================================

        function GetEmployee() {

            var custId =
                $.trim(
                    $("#EmployeeIdSearch").val()
                );


            if (custId === "") {

                $("#CustomerSearchMessage")
                    .removeClass("text-success")
                    .addClass("text-danger")
                    .text(
                        "Please enter Customer ID."
                    );

                return;
            }


            $("#btnSearchCustomer")
                .prop(
                    "disabled",
                    true
                )
                .text(
                    "Searching..."
                );


            $("#CustomerSearchMessage")
                .removeClass(
                    "text-success text-danger"
                )
                .text(
                    "Searching customer..."
                );


            $.ajax({

                url:
                    "/Employee/GetEmployee",

                type:
                    "GET",

                dataType:
                    "json",

                data: {

                    custId:
                        custId

                },


                success: function (response) {

                    if (!response.success) {

                        $("#CustomerSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                response.message ||
                                "Customer not found."
                            );

                        clearCustomerFields();

                        return;
                    }


                    var data =
                        response.data;


                    // =================================================
                    // CUSTOMER ID
                    // =================================================

                    $("#EmployeeIdSearch")
                        .val(
                            data.customerId ||
                            custId
                        );


                    $("#HiddenCustomerId")
                        .val(
                            data.customerId ||
                            custId
                        );


                    // =================================================
                    // EMPLOYEE CODE
                    // =================================================

                    $("#EmployeeCode")
                        .val(
                            data.employeeCode ||
                            ""
                        );


                    // =================================================
                    // EMPLOYEE NAME
                    // =================================================

                    $("#EmployeeName")
                        .val(
                            data.employeeName ||
                            ""
                        );


                    // =================================================
                    // ADDRESS
                    // =================================================

                    $("#Address1")
                        .val(
                            data.address1 ||
                            ""
                        );

                    $("#Address2")
                        .val(
                            data.address2 ||
                            ""
                        );

                    $("#Address3")
                        .val(
                            data.address3 ||
                            ""
                        );

                    $("#Address4")
                        .val(
                            data.address4 ||
                            ""
                        );

                    $("#Address5")
                        .val(
                            data.address5 ||
                            ""
                        );


                    // =================================================
                    // LOCATION
                    // =================================================

                    $("#City")
                        .val(
                            data.city ||
                            ""
                        );

                    $("#State")
                        .val(
                            data.state ||
                            ""
                        );

                    $("#District")
                        .val(
                            data.district ||
                            ""
                        );

                    $("#Taluka")
                        .val(
                            data.taluka ||
                            ""
                        );


                    // =================================================
                    // CONTACT
                    // =================================================

                    $("#Phone")
                        .val(
                            data.phone ||
                            ""
                        );

                    $("#Phone1")
                        .val(
                            data.phone1 ||
                            ""
                        );

                    $("#Mobile")
                        .val(
                            data.mobile ||
                            ""
                        );

                    $("#Email")
                        .val(
                            data.email ||
                            ""
                        );


                    // =================================================
                    // FATHER NAME
                    // =================================================

                    $("#FatherName")
                        .val(
                            data.fatherName ||
                            ""
                        );


                    // =================================================
                    // GENDER
                    // prtymast may contain M/F or Male/Female
                    // =================================================

                    $("input[name='Gender']")
                        .prop(
                            "checked",
                            false
                        );


                    if (data.gender) {

                        var gender =
                            data.gender
                                .toString()
                                .trim()
                                .toUpperCase();


                        if (gender === "MALE") {
                            gender = "M";
                        }


                        if (gender === "FEMALE") {
                            gender = "F";
                        }


                        if (
                            gender === "M" ||
                            gender === "F"
                        ) {

                            $("input[name='Gender'][value='" + gender + "']")
                                .prop(
                                    "checked",
                                    true
                                );
                        }
                    }


                    // =================================================
                    // BIRTH DATE
                    // =================================================

                    $("#BirthDate")
                        .val(
                            formatDate(
                                data.birthDate
                            )
                        );


                    // =================================================
                    // RELIGION
                    // =================================================

                    $("#ReligionSearch")
                        .val(
                            data.religion ||
                            ""
                        );


                    $("#ReligionId")
                        .val(
                            data.religionCode ||
                            ""
                        );


                    // =================================================
                    // CASTE
                    // =================================================

                    $("#CasteSearch")
                        .val(
                            data.caste ||
                            ""
                        );


                    $("#CasteId")
                        .val(
                            data.casteCode ||
                            ""
                        );


                    // =================================================
                    // DOCUMENT
                    // =================================================

                    $("#PANNumber")
                        .val(
                            data.panNumber ||
                            ""
                        );


                    $("#AadhaarNumber")
                        .val(
                            data.aadhaarNumber ||
                            ""
                        );


                    // =================================================
                    // NATIONALITY
                    // =================================================

                    $("#Nationality")
                        .val(
                            data.nationality ||
                            ""
                        );


                    // =================================================
                    // SUCCESS
                    // =================================================

                    $("#CustomerSearchMessage")
                        .removeClass(
                            "text-danger"
                        )
                        .addClass(
                            "text-success"
                        )
                        .text(
                            "Customer information loaded successfully."
                        );

                },


                error: function (xhr) {

                    var message =
                        "Unable to retrieve customer information.";


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;
                    }


                    $("#CustomerSearchMessage")
                        .removeClass(
                            "text-success"
                        )
                        .addClass(
                            "text-danger"
                        )
                        .text(
                            message
                        );


                    clearCustomerFields();
                },


                complete: function () {

                    $("#btnSearchCustomer")
                        .prop(
                            "disabled",
                            false
                        )
                        .text(
                            "Search"
                        );

                }

            });

        }


        // ============================================================
        // FORMAT DATE
        // ============================================================

        function formatDate(date) {

            if (!date) {
                return "";
            }


            if (
                typeof date === "string" &&
                /^\d{4}-\d{2}-\d{2}$/.test(date)
            ) {

                return date;
            }


            if (
                typeof date === "string" &&
                date.length >= 10
            ) {

                return date.substring(
                    0,
                    10
                );
            }


            return "";
        }


        // ============================================================
        // SELECT RELIGION
        // ============================================================

        function selectReligion(
            code,
            name
        ) {

            $("#ReligionId")
                .val(
                    code
                );


            $("#ReligionSearch")
                .val(
                    name
                );


            var modalElement =
                document.getElementById(
                    "ReligionModal"
                );


            var modal =
                bootstrap.Modal.getInstance(
                    modalElement
                );


            if (modal) {
                modal.hide();
            }

        }


        // ============================================================
        // SEARCH RELIGION
        // ============================================================

        function searchReligion() {

            var value =
                $("#searchReligion")
                    .val()
                    .toLowerCase();


            $("#religionTable tr")
                .filter(function () {

                    $(this).toggle(

                        $(this)
                            .text()
                            .toLowerCase()
                            .indexOf(value) > -1

                    );

                });

        }


        // ============================================================
        // SELECT CASTE
        // ============================================================

        function selectCaste(
            code,
            name
        ) {

            $("#CasteId")
                .val(
                    code
                );


            $("#CasteSearch")
                .val(
                    name
                );


            var modalElement =
                document.getElementById(
                    "CasteModal"
                );


            var modal =
                bootstrap.Modal.getInstance(
                    modalElement
                );


            if (modal) {
                modal.hide();
            }

        }


        // ============================================================
        // SEARCH CASTE
        // ============================================================

        function searchCaste() {

            var value =
                $("#searchCaste")
                    .val()
                    .toLowerCase();


            $("#casteTable tr")
                .filter(function () {

                    $(this).toggle(

                        $(this)
                            .text()
                            .toLowerCase()
                            .indexOf(value) > -1

                    );

                });

        }


        // ============================================================
        // CLEAR CUSTOMER FIELDS
        // ============================================================

        function clearCustomerFields() {

            $("#HiddenCustomerId").val("");

            $("#EmployeeCode").val("");

            $("#EmployeeName").val("");

            $("#Address1").val("");

            $("#Address2").val("");

            $("#Address3").val("");

            $("#Address4").val("");

            $("#Address5").val("");

            $("#City").val("");

            $("#State").val("");

            $("#District").val("");

            $("#Taluka").val("");

            $("#Phone").val("");

            $("#Phone1").val("");

            $("#Mobile").val("");

            $("#Email").val("");

            $("#FatherName").val("");

            $("input[name='Gender']")
                .prop(
                    "checked",
                    false
                );

            $("#BirthDate").val("");

            $("#ReligionSearch").val("");

            $("#ReligionId").val("");

            $("#CasteSearch").val("");

            $("#CasteId").val("");

            $("#PANNumber").val("");

            $("#AadhaarNumber").val("");

            $("#Nationality").val("");
        }

    </script>

</body>
</html>