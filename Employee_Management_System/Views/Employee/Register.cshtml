@model Employee_Management_System.Models.Employee

@{
    ViewData["Title"] = "Employee Registration";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Employee Registration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        .card-header {
            background: #0d6efd;
            color: white;
        }

        .nav-tabs .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }

        .input-group .btn {
            width: 45px;
        }

        .form-label {
            font-weight: bold;
        }

        .btn {
            min-width: 100px;
        }
    </style>

</head>
<body>

    <div class="container mt-4">

        <div class="card shadow">

            <div class="card-header">

                <h3 class="text-center">
                    Employee Registration
                </h3>

            </div>

            <div class="card-body">

                <form asp-action="Register" method="post">

                    <!--==========================================
                        Customer Search
                    ===========================================-->

                    <div class="row mb-3">

                        <div class="col-md-2">
                            <label>Employee Id</label>
                        </div>

                        <div class="col-md-3">
                            <input id="EmployeeIdSearch"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <button type="button"
                                    class="btn btn-primary"
                                    onclick="GetEmployee()">
                                Search
                            </button>
                        </div>

                    </div>

                    <hr />

                    <!--==========================================
                        Employee Information
                    ===========================================-->

                    <div class="row">

                        <!-- Employee Code -->

                        <div class="col-md-3 mb-3">

                            <label asp-for="EmployeeCode" class="form-label">
                                Employee Code
                            </label>

                            <input asp-for="EmployeeCode"
                                   id="EmployeeCode"
                                   class="form-control" />

                        </div>

                        <!-- Employee Name -->

                        <div class="col-md-5 mb-3">

                            <label asp-for="EmployeeName" class="form-label">
                                Employee Name
                            </label>

                            <input asp-for="EmployeeName"
                                   id="EmployeeName"
                                   class="form-control" />

                        </div>

                        <!-- Employee Type -->

                        <div class="col-md-4 mb-3">

                            <label asp-for="EmployeeType" class="form-label">
                                Employee Type
                            </label>

                            <select asp-for="EmployeeType"
                                    id="EmployeeType"
                                    class="form-select">

                                <option value="">Select Type</option>
                                <option value="Permanent">Permanent</option>
                                <option value="Temporary">Temporary</option>
                                <option value="Contract">Contract</option>

                            </select>

                        </div>

                    </div>

                    <!-- Tabs -->

                    <ul class="nav nav-tabs">

                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#general">
                                General Information
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#other">
                                Other Information
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#address">
                                Address Information
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#personal">
                                Personal Information
                            </a>
                        </li>

                    </ul>

                    <div class="tab-content border border-top-0 p-4">

                        <!-- ================= General Information ================= -->

                        <div class="tab-pane fade show active" id="general">

                            <div class="container mt-3">

                                <div class="row">

                                    <!-- Grade -->

                                    <div class="col-md-4">
                                        <label asp-for="Grade" class="form-label fw-bold"></label>

                                        <select asp-for="Grade"
                                                asp-items="ViewBag.Grades"
                                                class="form-select">
                                            <option value="">-- Select Grade --</option>
                                        </select>

                                        <span asp-validation-for="Grade" class="text-danger"></span>
                                    </div>

                                    <!-- Section -->

                                    <div class="col-md-4">
                                        <label asp-for="SectionId" class="form-label fw-bold">Section</label>

                                        <select asp-for="SectionId"
                                                asp-items="ViewBag.Sections"
                                                class="form-select">
                                            <option value="">-- Select Section --</option>
                                        </select>

                                        <span asp-validation-for="SectionId" class="text-danger"></span>
                                    </div>

                                    <!-- Branch -->

                                    <div class="col-md-4">
                                        <label asp-for="BranchId" class="form-label fw-bold">Branch</label>

                                        <select asp-for="BranchId"
                                                asp-items="ViewBag.Branches"
                                                class="form-select">
                                            <option value="">-- Select Branch --</option>
                                        </select>

                                        <span asp-validation-for="BranchId" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row mt-3">

                                    <div class="col-md-4">
                                        <label asp-for="JoiningDate" class="form-label fw-bold"></label>
                                        <input asp-for="JoiningDate" type="date" class="form-control" />
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="PermanentDate" class="form-label fw-bold"></label>
                                        <input asp-for="PermanentDate" type="date" class="form-control" />
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="LastSalaryDate" class="form-label fw-bold"></label>
                                        <input asp-for="LastSalaryDate" type="date" class="form-control" />
                                    </div>

                                </div>

                                <div class="row mt-3">

                                    @* <div class="col-md-4">
                                        <label asp-for="Basic" class="form-label fw-bold"></label>
                                        <input asp-for="Basic" class="form-control" />
                                    </div> *@

                                    <div class="col-md-4">
                                        <label asp-for="LastSalaryIncrementDate" class="form-label fw-bold"></label>
                                        <input asp-for="LastSalaryIncrementDate"
                                               type="date"
                                               class="form-control" />
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="RetirementDate" class="form-label fw-bold"></label>
                                        <input asp-for="RetirementDate"
                                               type="date"
                                               class="form-control" />
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ======================= Other Information ======================= -->
                        <div class="tab-pane fade" id="other">

                            <div class="row mt-3">

                                <!-- Left Side -->
                                <div class="col-md-6">

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">Pension Fund Open. Bal.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PensionFundOpeningBalance" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">P.F. No.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PFNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">P.F. Opening Bal.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PFOpeningBalance" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">PAN No.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PANNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">S/B.G.L. Code</label>
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <input asp-for="SavingGLCode" class="form-control" />
                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingGLModal">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">S/B.Br. Code</label>
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <input asp-for="SavingBranchCode" class="form-control" />
                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingBranchModal">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">S/B.Ac. Code</label>
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <input asp-for="SavingAccountCode" class="form-control" />
                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingAccountModal">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- Right Side -->
                                <div class="col-md-6">

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">IT Sr. No.</label>
                                        <div class="col-md-7">
                                            <input asp-for="ITSerialNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">P.F. Sr. No.</label>
                                        <div class="col-md-7">
                                            <input asp-for="PFSerialNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">P.F. Balance</label>
                                        <div class="col-md-7">
                                            <input asp-for="PFBalance" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">Aadhaar No.</label>
                                        <div class="col-md-7">
                                            <input asp-for="AadhaarNumber" class="form-control" maxlength="12" />
                                        </div>
                                    </div>

                                </div>

                            </div>

                            <div class="text-end mt-4">

                                <button type="button" class="btn btn-secondary">
                                    Previous
                                </button>

                                <button type="button" class="btn btn-primary">
                                    Next
                                </button>

                            </div>

                        </div>

                        <!-- ======================= Search Modals ======================= -->

                        <div class="modal fade" id="SavingGLModal" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Saving G/L Code</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Display Saving G/L Code list here.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="SavingBranchModal" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Saving Branch Code</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Display Saving Branch list here.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="SavingAccountModal" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Saving Account Code</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Display Saving Account list here.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ================= Address Information ================= -->

                        <div class="tab-pane fade" id="address">

                            <div class="container mt-3">

                                <div class="row">

                                    <div class="col-md-8 offset-md-1">

                                        <!-- Correspondence Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Correspondence Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="CorrespondenceAddress1"
                                                       class="form-control mb-2" />

                                                <input asp-for="CorrespondenceAddress2"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Permanent Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Permanent Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="PermanentAddress1"
                                                       class="form-control mb-2" />

                                                <input asp-for="PermanentAddress2"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Father's Name -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Father's Name
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="FatherName"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="Address1"
                                                       class="form-control mb-2" />

                                                <input asp-for="Address2"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <!-- Navigation Buttons -->

                                <div class="text-end mt-4">

                                    <button type="button"
                                            class="btn btn-secondary">

                                        Previous

                                    </button>

                                    <button type="button"
                                            class="btn btn-primary">

                                        Next

                                    </button>

                                </div>

                            </div>

                        </div>

                        <!-- ================= Personal Information ================= -->

                        <div class="tab-pane fade" id="personal">

                            <div class="container mt-3">

                                <div class="row">

                                    <!-- Left Side -->

                                    <div class="col-md-6">

                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Religion
                                            </label>


                                            <div class="input-group">

                                                <input type="text"
                                                       id="ReligionSearch"
                                                       class="form-control"
                                                       placeholder="Search Religion"
                                                       readonly />


                                                <button type="button"
                                                        class="btn btn-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#ReligionModal">

                                                    🔍

                                                </button>

                                            </div>


                                            <input type="hidden"
                                                   asp-for="Religion"
                                                   id="ReligionId" />

                                        </div>
                                        <div class="modal fade" id="ReligionModal">

                                            <div class="modal-dialog modal-lg">

                                                <div class="modal-content">


                                                    <div class="modal-header">

                                                        <h5>Select Religion</h5>

                                                        <button class="btn-close"
                                                                data-bs-dismiss="modal">
                                                        </button>

                                                    </div>


                                                    <div class="modal-body">


                                                        <input type="text"
                                                               id="searchReligion"
                                                               class="form-control mb-3"
                                                               placeholder="Search Religion"
                                                               onkeyup="searchReligion()" />


                                                        <table class="table table-bordered">

                                                            <thead>

                                                                <tr>

                                                                    <th>Code</th>

                                                                    <th>Religion</th>

                                                                    <th></th>

                                                                </tr>

                                                            </thead>


                                                            <tbody id="religionTable">


                                                                @foreach (var item in ViewBag.Religions)
                                                                {

                                                                    <tr>

                                                                        <td>
                                                                            @item.Code
                                                                        </td>


                                                                        <td>
                                                                            @item.ReligionName
                                                                        </td>


                                                                        <td>

                                                                            <button type="button"
                                                                                    class="btn btn-success btn-sm"
                                                                                    onclick="selectReligion('@item.Code','@item.ReligionName')">

                                                                                Select

                                                                            </button>

                                                                        </td>

                                                                    </tr>

                                                                }


                                                            </tbody>


                                                        </table>


                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                            <div class="col-md-4">

                                                <label class="form-label">
                                                    Caste
                                                </label>

                                                <div class="input-group">

                                                    <input type="text"
                                                           id="CasteSearch"
                                                           class="form-control"
                                                           placeholder="Search Caste"
                                                           readonly />

                                                    <button type="button"
                                                            class="btn btn-primary"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#CasteModal">

                                                        🔍

                                                    </button>

                                                </div>


                                                <input type="hidden"
                                                       asp-for="Caste"
                                                       id="CasteId" />


                                            </div>


                                            <!-- Caste Modal -->

                                            <div class="modal fade" id="CasteModal">

                                                <div class="modal-dialog modal-lg">

                                                    <div class="modal-content">


                                                        <div class="modal-header">

                                                            <h5 class="modal-title">
                                                                Select Caste
                                                            </h5>

                                                            <button type="button"
                                                                    class="btn-close"
                                                                    data-bs-dismiss="modal">
                                                            </button>

                                                        </div>


                                                        <div class="modal-body">


                                                            <input type="text"
                                                                   id="searchCaste"
                                                                   class="form-control mb-3"
                                                                   placeholder="Search Caste"
                                                                   onkeyup="searchCaste()" />



                                                            <table class="table table-bordered table-hover">

                                                                <thead>

                                                                    <tr>

                                                                        <th>
                                                                            Code
                                                                        </th>

                                                                        <th>
                                                                            Caste Name
                                                                        </th>

                                                                        <th>
                                                                            Action
                                                                        </th>

                                                                    </tr>

                                                                </thead>


                                                                <tbody id="casteTable">


                                                                    @foreach (var item in ViewBag.Castes)
                                                                    {

                                                                        <tr>

                                                                            <td>
                                                                                @item.Code
                                                                            </td>


                                                                            <td>
                                                                                @item.CastName
                                                                            </td>


                                                                            <td>

                                                                                <button type="button"
                                                                                        class="btn btn-success btn-sm"
                                                                                        onclick="selectCaste('@item.Code','@item.CastName')">

                                                                                    Select

                                                                                </button>

                                                                            </td>


                                                                        </tr>

                                                                    }


                                                                </tbody>


                                                            </table>


                                                        </div>


                                                    </div>

                                                </div>

                                            </div>
                                      
                                        <!-- Gender -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Gender
                                            </label>

                                            <div class="col-md-7">

                                                <div class="form-check form-check-inline">

                                                    <input asp-for="Gender"
                                                           class="form-check-input"
                                                           type="radio"
                                                           value="Male">

                                                    <label class="form-check-label">
                                                        Male
                                                    </label>

                                                </div>

                                                <div class="form-check form-check-inline">

                                                    <input asp-for="Gender"
                                                           class="form-check-input"
                                                           type="radio"
                                                           value="Female">

                                                    <label class="form-check-label">
                                                        Female
                                                    </label>

                                                </div>

                                            </div>

                                        </div>

                                        <!-- Birth Date -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Birth Date
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="BirthDate"
                                                       type="date"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Identification Mark -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Identification Mark
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="IdentificationMark"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Known Language -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Known Language
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="KnownLanguage"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Education -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Education
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="Education"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                    <!-- Right Side -->

                                    <div class="col-md-6">

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Blood Group
                                            </label>

                                            <div class="col-md-7">

                                                <select asp-for="BloodGroup"
                                                        class="form-select">

                                                    <option value="">Select</option>
                                                    <option>A+</option>
                                                    <option>A-</option>
                                                    <option>B+</option>
                                                    <option>B-</option>
                                                    <option>AB+</option>
                                                    <option>AB-</option>
                                                    <option>O+</option>
                                                    <option>O-</option>

                                                </select>

                                            </div>

                                        </div>

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Height
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="Height"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Mother Tongue
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="MotherTongue"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Mode of Sign
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="ModeOfSign"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div class="text-end mt-4">

                                    <button type="button"
                                            class="btn btn-secondary">
                                        Previous
                                    </button>

                                    <button type="submit"
                                            class="btn btn-success">
                                        Save Employee
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="text-center mt-4">

                        <button type="reset" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> New
                        </button>

                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Save
                        </button>

                        <button type="button" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Update
                        </button>

                        <button type="button" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>

                        <button type="button" class="btn btn-info text-white">
                            <i class="bi bi-eye"></i> View
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="bi bi-box-arrow-right"></i> Exit
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>



    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        //=====================================
        // Helper Function
        //=====================================

        function formatDate(date) {

            if (!date)
                return "";

            return date.substring(0, 10);
        }

        //=====================================
        // Caste Search
        //=====================================

        $("#CasteSearch").keyup(function () {

            var text = $(this).val();

            if (text.length >= 1) {

                $.ajax({

                    url: '/Employee/SearchCaste',
                    type: 'GET',
                    data: { term: text },

                    success: function (data) {

                        $("#CasteList").html("");

                        $.each(data, function (i, item) {

                            $("#CasteList").append(

                                `<button type="button"
                                         class="list-group-item list-group-item-action"
                                         onclick="selectCaste('${item.id}','${item.text}')">

                                    ${item.text}

                                </button>`

                            );

                        });

                    }

                });

            }
            else {

                $("#CasteList").html("");

            }

        });

        function selectCaste(id, name) {

            $("#CasteId").val(id);
            $("#CasteSearch").val(name);
            $("#CasteList").html("");

        }

        //=====================================
        // Religion Search
        //=====================================

        function searchReligion() {

            var input = document.getElementById("searchReligion");
            var filter = input.value.toLowerCase();

            var rows = document
                .getElementById("religionTable")
                .getElementsByTagName("tr");

            for (var i = 0; i < rows.length; i++) {

                var name = rows[i].getElementsByTagName("td")[1];

                if (name) {

                    var text = name.textContent || name.innerText;

                    rows[i].style.display =
                        text.toLowerCase().includes(filter)
                            ? ""
                            : "none";
                }
            }
        }

        function selectReligion(id, name) {

            $("#ReligionId").val(id);
            $("#ReligionSearch").val(name);

            var modal = bootstrap.Modal.getInstance(document.getElementById("ReligionModal"));

            if (modal) {
                modal.hide();
            }

        }

        //=====================================
        // Get Employee
        //=====================================

        function GetEmployee() {

            var id = $("#EmployeeIdSearch").val();
            debugger;
            if (id == "") {

                alert("Please enter Employee ID.");
                return;

            }

            $.ajax({

                url: "/Employee/GetEmployee",

                type: "GET",

                data: { id: id },

                success: function (data) {

                    if (data == null) {

                        alert("Employee not found.");
                        return;

                    }

                    // Employee

                    $("#EmployeeCode").val(data.employeeCode);
                    $("#EmployeeName").val(data.employeeName);
                    $("#EmployeeType").val(data.employeeType);

                    // General

                    $("#GradeId").val(data.gradeId);
                    $("#SectionId").val(data.sectionId);
                    $("#BranchId").val(data.branchId);

                    $("#JoiningDate").val(formatDate(data.joiningDate));
                    $("#PermanentDate").val(formatDate(data.permanentDate));
                    $("#LastSalaryDate").val(formatDate(data.lastSalaryDate));
                    $("#BasicSalary").val(data.basicSalary);
                    $("#LastSalaryIncrementDate").val(formatDate(data.lastSalaryIncrementDate));
                    $("#RetirementDate").val(formatDate(data.retirementDate));

                    // Other

                    $("#PensionFundOpeningBalance").val(data.pensionFundOpeningBalance);
                    $("#PFNumber").val(data.pfNumber);
                    $("#PFOpeningBalance").val(data.pfOpeningBalance);
                    $("#PANNumber").val(data.panNumber);
                    $("#SavingGLCode").val(data.savingGLCode);
                    $("#SavingBranchCode").val(data.savingBranchCode);
                    $("#SavingAccountCode").val(data.savingAccountCode);
                    $("#ITSerialNumber").val(data.itSerialNumber);
                    $("#PFSerialNumber").val(data.pfSerialNumber);
                    $("#PFBalance").val(data.pfBalance);
                    $("#AadhaarNumber").val(data.aadhaarNumber);

                    // Address

                    $("#CorrespondenceAddress1").val(data.correspondenceAddress1);
                    $("#CorrespondenceAddress2").val(data.correspondenceAddress2);
                    $("#PermanentAddress1").val(data.permanentAddress1);
                    $("#PermanentAddress2").val(data.permanentAddress2);
                    $("#FatherName").val(data.fatherName);
                    $("#Address1").val(data.address1);
                    $("#Address2").val(data.address2);

                    // Personal

                    $("#ReligionSearch").val(data.religion);
                    $("#CasteSearch").val(data.caste);

                    $("#Gender").val(data.gender);
                    $("#BirthDate").val(formatDate(data.birthDate));
                    $("#BloodGroup").val(data.bloodGroup);
                    $("#IdentificationMark").val(data.identificationMark);
                    $("#Height").val(data.height);
                    $("#KnownLanguage").val(data.knownLanguage);
                    $("#MotherTongue").val(data.motherTongue);
                    $("#Education").val(data.education);
                    $("#ModeOfSign").val(data.modeOfSign);

                },

                error: function () {

                    alert("Error retrieving employee information.");

                }

            });

        }

    </script>
</body>
</html>
