        // ============================================================
        // PERSONAL INFORMATION VALIDATION
        // ============================================================

        function validatePersonalInformation() {

            var isValid = true;
            var firstInvalid = null;

            clearPersonalValidation();


            // Religion
            if (!$("#ReligionId").val()) {

                $("#ReligionSearch").addClass("is-invalid");
                $("#ReligionError").text("Religion is required.");

                if (firstInvalid === null) {
                    firstInvalid = $("#ReligionSearch");
                }

                isValid = false;
            }


            // Caste
            if (!$("#CasteId").val()) {

                $("#CasteSearch").addClass("is-invalid");
                $("#CasteError").text("Caste is required.");

                if (firstInvalid === null) {
                    firstInvalid = $("#CasteSearch");
                }

                isValid = false;
            }


            // Blood Group
            if (!$("#BloodGroup").val()) {

                $("#BloodGroup").addClass("is-invalid");
                $("#BloodGroupError").text("Blood Group is required.");

                if (firstInvalid === null) {
                    firstInvalid = $("#BloodGroup");
                }

                isValid = false;
            }


            // Gender
            if ($("input[name='Gender']:checked").length === 0) {

                $("input[name='Gender']").addClass("is-invalid");
                $("#GenderError").text("Gender is required.");

                if (firstInvalid === null) {
                    firstInvalid = $("input[name='Gender']").first();
                }

                isValid = false;
            }


            // Birth Date
            if (!$("#BirthDate").val()) {

                $("#BirthDate").addClass("is-invalid");
                $("#BirthDateError").text("Birth Date is required.");

                if (firstInvalid === null) {
                    firstInvalid = $("#BirthDate");
                }

                isValid = false;
            }


            if (!isValid) {

                openEmployeeTab("personal-tab");

                if (firstInvalid && firstInvalid.length) {

                    setTimeout(function () {
                        firstInvalid.focus();
                    }, 200);
                }

                return false;
            }

            return true;
        }


        // ============================================================
        // CLEAR PERSONAL INFORMATION VALIDATION
        // ============================================================

        function clearPersonalValidation() {

            $("#ReligionSearch, #CasteSearch, #BloodGroup, #BirthDate")
                .removeClass("is-invalid");

            $("input[name='Gender']")
                .removeClass("is-invalid");

            $("#ReligionError").text("");
            $("#CasteError").text("");
            $("#BloodGroupError").text("");
            $("#GenderError").text("");
            $("#BirthDateError").text("");
        }


        // ============================================================
        // GENERAL INFORMATION VALIDATION
        // ============================================================

        function validateGeneralInformation() {

            var isValid = true;
            var firstInvalid = null;

            clearGeneralValidation();


            // CUSTOMER ID
            var customerIdText =
                $.trim($("#EmployeeIdSearch").val());

            var loadedCustomerId =
                $.trim($("#HiddenCustomerId").val());


            if (customerIdText === "" || loadedCustomerId === "") {

                $("#EmployeeIdSearch")
                    .addClass("is-invalid");

                $("#CustomerIdError")
                    .text(
                        customerIdText === ""
                            ? "Customer ID is required."
                            : "Please search and load a valid Customer ID."
                    );

                firstInvalid =
                    $("#EmployeeIdSearch");

                isValid = false;
            }


            if ($.trim($("#EmployeeName").val()) === "") {
                $("#EmployeeName").addClass("is-invalid");
                $("#EmployeeNameError").text("Employee Name is required.");
                firstInvalid = $("#EmployeeName");
                isValid = false;
            }

            if (!$("#EmployeeType").val()) {
                $("#EmployeeType").addClass("is-invalid");
                $("#EmployeeTypeError").text("Employee Type is required.");
                if (firstInvalid === null) firstInvalid = $("#EmployeeType");
                isValid = false;
            }

            if (!$("#GradeId").val()) {
                $("#GradeId").addClass("is-invalid");
                $("#GradeIdError").text("Grade is required.");
                if (firstInvalid === null) firstInvalid = $("#GradeId");
                isValid = false;
            }

            if (!$("#SectionId").val()) {
                $("#SectionId").addClass("is-invalid");
                $("#SectionIdError").text("Section is required.");
                if (firstInvalid === null) firstInvalid = $("#SectionId");
                isValid = false;
            }

            if (!$("#BranchId").val()) {
                $("#BranchId").addClass("is-invalid");
                $("#BranchIdError").text("Branch is required.");
                if (firstInvalid === null) firstInvalid = $("#BranchId");
                isValid = false;
            }

            if (!$("#JoiningDate").val()) {
                $("#JoiningDate").addClass("is-invalid");
                $("#JoiningDateError").text("Joining Date is required.");
                if (firstInvalid === null) firstInvalid = $("#JoiningDate");
                isValid = false;
            }

            if (!isValid) {
                if (firstInvalid && firstInvalid.length) {
                    firstInvalid.focus();
                }
                return false;
            }

            return true;
        }


        // ============================================================
        // CLEAR GENERAL INFORMATION VALIDATION
        // ============================================================

        function clearGeneralValidation() {

            $("#EmployeeIdSearch, #EmployeeName, #EmployeeType, #GradeId, #SectionId, #BranchId, #JoiningDate")
                .removeClass("is-invalid");

            $("#CustomerIdError").text("");
            $("#EmployeeNameError").text("");
            $("#EmployeeTypeError").text("");
            $("#GradeIdError").text("");
            $("#SectionIdError").text("");
            $("#BranchIdError").text("");
            $("#JoiningDateError").text("");
        }


        // ============================================================
        // CUSTOMER SEARCH FROM PRTYMAST
        // ============================================================

        function searchCustomer() {

            if (isUpdateMode) {

                return;

            }


            var customerId =
                $.trim(
                    $("#EmployeeIdSearch").val()
                );


            if (customerId === "") {

                $("#EmployeeIdSearch")
                    .addClass("is-invalid");

                $("#CustomerIdError")
                    .text("Customer ID is required.");

                $("#CustomerSearchMessage")
                    .removeClass(
                        "text-success text-primary"
                    )
                    .addClass(
                        "text-danger"
                    )
                    .text(
                        "Please enter Customer ID."
                    );

                $("#EmployeeIdSearch")
                    .focus();

                return;
            }


            $("#CustomerSearchMessage")
                .removeClass(
                    "text-danger text-success"
                )
                .addClass(
                    "text-primary"
                )
                .text(
                    "Searching..."
                );


            $.ajax({

                url:
                    '@Url.Action("GetEmployee", "Employee")',

                type:
                    "GET",

                data: {
                    custId:
                        customerId
                },

                success:
                    function (response) {

                        if (!response.success) {

                            if (response.alreadyExists) {

                                $("#existingEmployeeName")
                                    .text(
                                        response.employeeName || ""
                                    );

                                $("#existingEmployeeCode")
                                    .text(
                                        response.employeeCode || ""
                                    );


                                var duplicateModal =
                                    bootstrap.Modal
                                        .getOrCreateInstance(
                                            document.getElementById(
                                                "employeeAlreadyExistsModal"
                                            )
                                        );

                                duplicateModal.show();


                                $("#CustomerSearchMessage")
                                    .removeClass(
                                        "text-success text-primary"
                                    )
                                    .addClass(
                                        "text-danger"
                                    )
                                    .text(
                                        "Employee already exists."
                                    );

                                return;
                            }


                            clearCustomerFields();

                            $("#EmployeeIdSearch")
                                .addClass("is-invalid");

                            $("#CustomerIdError")
                                .text(
                                    response.message ||
                                    "Please enter a valid Customer ID."
                                );


                            $("#CustomerSearchMessage")
                                .removeClass(
                                    "text-success text-primary"
                                )
                                .addClass(
                                    "text-danger"
                                )
                                .text(
                                    response.message ||
                                    "Customer not found."
                                );

                            return;
                        }


                        var data =
                            response.data;


                        // Customer ID
                        $("#HiddenCustomerId")
                            .val(
                                data.customerId || customerId
                            );

                        $("#EmployeeIdSearch")
                            .removeClass("is-invalid");

                        $("#CustomerIdError")
                            .text("");


                        // Employee code MUST remain blank
                        // New code generated after save
                        $("#EmployeeCode")
                            .val("");


                        // Name
                        $("#EmployeeName")
                            .val(
                                data.employeeName || ""
                            );


                        // Addresses
                        $("#Address1")
                            .val(
                                data.address1 || ""
                            );

                        $("#Address2")
                            .val(
                                data.address2 || ""
                            );

                        $("#CorrespondenceAddress1")
                            .val(
                                data.address1 || ""
                            );

                        $("#CorrespondenceAddress2")
                            .val(
                                data.address2 || ""
                            );

                        $("#PermanentAddress1")
                            .val(
                                data.address1 || ""
                            );

                        $("#PermanentAddress2")
                            .val(
                                data.address2 || ""
                            );


                        // Father
                        $("#FatherName")
                            .val(
                                data.fatherName || ""
                            );


                        // PAN
                        $("#PANNumber")
                            .val(
                                data.panNumber || ""
                            );


                        // Aadhaar
                        $("#AadhaarNumber")
                            .val(
                                data.aadhaarNumber || ""
                            );


                        // Birth Date
                        $("#BirthDate")
                            .val(
                                data.birthDate || ""
                            );


                        // Gender
                        setGender(
                            data.gender
                        );


                        // Religion
                        setReligionValues(
                            data.religionCode,
                            data.religionName ||
                            data.religion
                        );


                        // Caste
                        setCasteValues(
                            data.casteCode,
                            data.casteName ||
                            data.caste
                        );


                        $("#CustomerSearchMessage")
                            .removeClass(
                                "text-danger text-primary"
                            )
                            .addClass(
                                "text-success"
                            )
                            .text(
                                "Customer information loaded successfully."
                            );

                    },

                error:
                    function (xhr) {

                        clearCustomerFields();

                        $("#EmployeeIdSearch")
                            .addClass("is-invalid");


                        var message =
                            "Unable to retrieve customer information.";


                        if (
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {

                            message =
                                xhr.responseJSON.message;

                        }


                        $("#CustomerIdError")
                            .text(message);

                        $("#CustomerSearchMessage")
                            .removeClass(
                                "text-success text-primary"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                message
                            );

                    }

            });

        }



        // ============================================================
        // LOAD LATEST EMPLOYEES
        // ============================================================

        function loadLatestEmployees() {

            $("#ExistingEmployeeResults")
                .html(
                    '<tr>' +
                    '<td colspan="3" class="text-center">' +
                    'Loading...' +
                    '</td>' +
                    '</tr>'
                );


            $.ajax({

                url:
                    '@Url.Action("SearchExistingEmployees", "Employee")',

                type:
                    "GET",

                data: {
                    searchBy:
                        "code",

                    searchText:
                        ""
                },

                success:
                    function (response) {

                        renderExistingEmployees(
                            response
                        );

                    },

                error:
                    function () {

                        $("#ExistingEmployeeResults")
                            .html(
                                '<tr>' +
                                '<td colspan="3" class="text-center text-danger">' +
                                'Unable to load employees.' +
                                '</td>' +
                                '</tr>'
                            );

                    }

            });

        }



        // ============================================================
        // SEARCH EXISTING EMPLOYEE
        // ============================================================

        function searchExistingEmployees() {

            var searchBy =
                $("#ExistingSearchBy").val();

            var searchText =
                $.trim(
                    $("#ExistingSearchText").val()
                );


            if (searchText === "") {

                loadLatestEmployees();

                return;

            }


            $("#ExistingSearchMessage")
                .removeClass(
                    "text-danger text-success"
                )
                .addClass(
                    "text-primary"
                )
                .text(
                    "Searching..."
                );


            $.ajax({

                url:
                    '@Url.Action("SearchExistingEmployees", "Employee")',

                type:
                    "GET",

                data: {

                    searchBy:
                        searchBy,

                    searchText:
                        searchText

                },

                success:
                    function (response) {

                        renderExistingEmployees(
                            response
                        );

                    },

                error:
                    function (xhr) {

                        var message =
                            "Unable to search employee.";


                        if (
                            xhr.responseJSON &&
                            xhr.responseJSON.message
                        ) {

                            message =
                                xhr.responseJSON.message;

                        }


                        $("#ExistingSearchMessage")
                            .removeClass(
                                "text-primary text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                message
                            );

                    }

            });

        }



        // ============================================================
        // RENDER EXISTING EMPLOYEE LIST
        // ============================================================

        function renderExistingEmployees(response) {

            var tbody =
                $("#ExistingEmployeeResults");


            tbody.empty();


            if (!response || !response.success) {

                tbody.html(
                    '<tr>' +
                    '<td colspan="3" class="text-center text-danger">' +
                    (
                        response &&
                        response.message
                            ? escapeHtml(
                                response.message
                            )
                            : "Unable to load employees."
                    ) +
                    '</td>' +
                    '</tr>'
                );

                return;
            }


            var employees =
                response.data || [];


            if (employees.length === 0) {

                tbody.html(
                    '<tr>' +
                    '<td colspan="3" class="text-center text-muted">' +
                    'No employee found.' +
                    '</td>' +
                    '</tr>'
                );


                $("#ExistingSearchMessage")
                    .removeClass(
                        "text-primary text-success"
                    )
                    .addClass(
                        "text-danger"
                    )
                    .text(
                        "No employee found."
                    );

                return;
            }


            $.each(
                employees,
                function (index, employee) {

                    var employeeCode =
                        employee.employeeCode;

                    var employeeName =
                        employee.employeeName || "";


                    var row =
                        '<tr>' +

                        '<td>' +
                        escapeHtml(
                            employeeCode
                        ) +
                        '</td>' +

                        '<td>' +
                        escapeHtml(
                            employeeName
                        ) +
                        '</td>' +

                        '<td>' +

                        '<button type="button" ' +
                        'class="btn btn-sm btn-success btn-select-existing" ' +
                        'data-code="' +
                        escapeHtml(
                            employeeCode
                        ) +
                        '">' +

                        '<i class="bi bi-check-circle"></i> ' +
                        'Select' +

                        '</button>' +

                        '</td>' +

                        '</tr>';


                    tbody.append(
                        row
                    );

                }
            );


            $("#ExistingSearchMessage")
                .removeClass(
                    "text-danger text-primary"
                )
                .addClass(
                    "text-success"
                )
                .text(
                    employees.length +
                    " employee(s) found."
                );


            // Select employee
            $(".btn-select-existing")
                .off("click")
                .on(
                    "click",
                    function () {

                        var employeeCode =
                            $(this)
                                .data("code");


                        loadExistingEmployee(
                            employeeCode
                        );

                    }
                );

        }



        // ============================================================
