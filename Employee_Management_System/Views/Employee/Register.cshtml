                                data.pfBalance == null
                                    ? ""
                                    : data.pfBalance
                            );


                        $("#AadhaarNumber")
                            .val(
                                data.aadhaarNumber == null
                                    ? ""
                                    : data.aadhaarNumber
                            );


                        // ==============================================
                        // ADDRESS
                        // ==============================================

                        $("#CorrespondenceAddress1")
                            .val(
                                data.correspondenceAddress1 || ""
                            );


                        $("#CorrespondenceAddress2")
                            .val(
                                data.correspondenceAddress2 || ""
                            );


                        $("#PermanentAddress1")
                            .val(
                                data.permanentAddress1 || ""
                            );


                        $("#PermanentAddress2")
                            .val(
                                data.permanentAddress2 || ""
