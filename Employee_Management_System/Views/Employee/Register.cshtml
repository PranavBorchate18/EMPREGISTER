@model Employee_Management_System.Models.Employee

@{
    ViewData["Title"] = "Employee Registration";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Employee Registration</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>
        .card-header {
            background: #0d6efd;
            color: white;
        }

        .nav-tabs .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }

        .input-group .btn {
            width: 45px;
        }

        .form-label {
            font-weight: bold;
        }

        .btn {
            min-width: 100px;
        }
    </style>

</head>
<body>

    <div class="container mt-4">

        <div class="card shadow">

            <div class="card-header">

                <h3 class="text-center">
                    Employee Registration
                </h3>

            </div>

            <div class="card-body">

                <form asp-action="Register" method="post">

                    <!-- ==========================================
                         Customer Search
                    ========================================== -->

                    <div class="row mb-3">

                        <div class="col-md-2">
                            <label class="form-label fw-bold">
                                Customer ID
                            </label>
                        </div>

                        <div class="col-md-3">

                            <input type="text"
                                   id="EmployeeIdSearch"
                                   class="form-control"
                                   placeholder="Enter Customer ID"
                                   autocomplete="off" />

                        </div>

                        <div class="col-md-2">

                            <button type="button"
                                    id="btnSearchCustomer"
                                    class="btn btn-primary">

                                Search

                            </button>

                        </div>

                        <div class="col-md-5">

                            <span id="CustomerSearchMessage"
                                  class="fw-bold">
                            </span>

                        </div>

                    </div>

                    <hr />

                    <!--==========================================
                        Employee Information
                    ===========================================-->

                    <div class="row">

                        <!-- Employee Code -->

                        <div class="col-md-3 mb-3">

                            <label asp-for="EmployeeCode" class="form-label">
                                Employee Code
                            </label>

                            <input asp-for="EmployeeCode"
                                   id="EmployeeCode"
                                   class="form-control" />

                        </div>

                        <!-- Employee Name -->

                        <div class="col-md-5 mb-3">

                            <label asp-for="EmployeeName" class="form-label">
                                Employee Name
                            </label>

                            <input asp-for="EmployeeName"
                                   id="EmployeeName"
                                   class="form-control" />

                        </div>

                        <!-- Employee Type -->

                        <div class="col-md-4 mb-3">

                            <label asp-for="EmployeeType" class="form-label">
                                Employee Type
                            </label>

                            <select asp-for="EmployeeType"
                                    id="EmployeeType"
                                    class="form-select">

                                <option value="">Select Type</option>
                                <option value="Permanent">Permanent</option>
                                <option value="Temporary">Temporary</option>
                                <option value="Contract">Contract</option>

                            </select>

                        </div>

                    </div>

                    <!-- Tabs -->

                    <ul class="nav nav-tabs">

                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#general">
                                General Information
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#other">
                                Other Information
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#address">
                                Address Information
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#personal">
                                Personal Information
                            </a>
                        </li>

                    </ul>

                    <div class="tab-content border border-top-0 p-4">

                        <!-- ================= General Information ================= -->

                        <div class="tab-pane fade show active" id="general">

                            <div class="container mt-3">

                                <div class="row">

                                    <!-- Grade -->

                                    <div class="col-md-4">
                                        <label asp-for="Grade" class="form-label fw-bold"></label>

                                        <select asp-for="Grade"
                                                asp-items="ViewBag.Grades"
                                                class="form-select">
                                            <option value="">-- Select Grade --</option>
                                        </select>

                                        <span asp-validation-for="Grade" class="text-danger"></span>
                                    </div>

                                    <!-- Section -->

                                    <div class="col-md-4">
                                        <label asp-for="SectionId" class="form-label fw-bold">Section</label>

                                        <select asp-for="SectionId"
                                                asp-items="ViewBag.Sections"
                                                class="form-select">
                                            <option value="">-- Select Section --</option>
                                        </select>

                                        <span asp-validation-for="SectionId" class="text-danger"></span>
                                    </div>

                                    <!-- Branch -->

                                    <div class="col-md-4">
                                        <label asp-for="BranchId" class="form-label fw-bold">Branch</label>

                                        <select asp-for="BranchId"
                                                asp-items="ViewBag.Branches"
                                                class="form-select">
                                            <option value="">-- Select Branch --</option>
                                        </select>

                                        <span asp-validation-for="BranchId" class="text-danger"></span>
                                    </div>

                                </div>

                                <div class="row mt-3">

                                    <div class="col-md-4">
                                        <label asp-for="JoiningDate" class="form-label fw-bold"></label>
                                        <input asp-for="JoiningDate" type="date" class="form-control" />
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="PermanentDate" class="form-label fw-bold"></label>
                                        <input asp-for="PermanentDate" type="date" class="form-control" />
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="LastSalaryDate" class="form-label fw-bold"></label>
                                        <input asp-for="LastSalaryDate" type="date" class="form-control" />
                                    </div>

                                </div>

                                <div class="row mt-3">

                                    @* <div class="col-md-4">
                                        <label asp-for="Basic" class="form-label fw-bold"></label>
                                        <input asp-for="Basic" class="form-control" />
                                    </div> *@

                                    <div class="col-md-4">
                                        <label asp-for="LastSalaryIncrementDate" class="form-label fw-bold"></label>
                                        <input asp-for="LastSalaryIncrementDate"
                                               type="date"
                                               class="form-control" />
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="RetirementDate" class="form-label fw-bold"></label>
                                        <input asp-for="RetirementDate"
                                               type="date"
                                               class="form-control" />
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ======================= Other Information ======================= -->
                        <div class="tab-pane fade" id="other">

                            <div class="row mt-3">

                                <!-- Left Side -->
                                <div class="col-md-6">

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">Pension Fund Open. Bal.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PensionFundOpeningBalance" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">P.F. No.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PFNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">P.F. Opening Bal.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PFOpeningBalance" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">PAN No.</label>
                                        <div class="col-md-6">
                                            <input asp-for="PANNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">S/B.G.L. Code</label>
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <input asp-for="SavingGLCode" class="form-control" />
                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingGLModal">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">S/B.Br. Code</label>
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <input asp-for="SavingBranchCode" class="form-control" />
                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingBranchModal">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-6 col-form-label fw-bold">S/B.Ac. Code</label>
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <input asp-for="SavingAccountCode" class="form-control" />
                                                <button type="button"
                                                        class="btn btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#SavingAccountModal">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- Right Side -->
                                <div class="col-md-6">

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">IT Sr. No.</label>
                                        <div class="col-md-7">
                                            <input asp-for="ITSerialNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">P.F. Sr. No.</label>
                                        <div class="col-md-7">
                                            <input asp-for="PFSerialNumber" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">P.F. Balance</label>
                                        <div class="col-md-7">
                                            <input asp-for="PFBalance" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-md-5 col-form-label fw-bold">Aadhaar No.</label>
                                        <div class="col-md-7">
                                            <input asp-for="AadhaarNumber" class="form-control" maxlength="12" />
                                        </div>
                                    </div>

                                </div>

                            </div>

                            <div class="text-end mt-4">

                                <button type="button" class="btn btn-secondary">
                                    Previous
                                </button>

                                <button type="button" class="btn btn-primary">
                                    Next
                                </button>

                            </div>

                        </div>

                        <!-- ======================= Search Modals ======================= -->

                        <div class="modal fade" id="SavingGLModal" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Saving G/L Code</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Display Saving G/L Code list here.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="SavingBranchModal" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Saving Branch Code</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Display Saving Branch list here.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="SavingAccountModal" tabindex="-1">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header bg-primary text-white">
                                        <h5 class="modal-title">Saving Account Code</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Display Saving Account list here.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ================= Address Information ================= -->

                        <div class="tab-pane fade" id="address">

                            <div class="container mt-3">

                                <div class="row">

                                    <div class="col-md-8 offset-md-1">

                                        <!-- Correspondence Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Correspondence Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="CorrespondenceAddress1"
                                                       class="form-control mb-2" />

                                                <input asp-for="CorrespondenceAddress2"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Permanent Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Permanent Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="PermanentAddress1"
                                                       class="form-control mb-2" />

                                                <input asp-for="PermanentAddress2"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Father's Name -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Father's Name
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="FatherName"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Address -->

                                        <div class="row mb-3">

                                            <label class="col-md-4 col-form-label fw-bold">
                                                Address
                                            </label>

                                            <div class="col-md-8">

                                                <input asp-for="Address1"
                                                       class="form-control mb-2" />

                                                <input asp-for="Address2"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <!-- Navigation Buttons -->

                                <div class="text-end mt-4">

                                    <button type="button"
                                            class="btn btn-secondary">

                                        Previous

                                    </button>

                                    <button type="button"
                                            class="btn btn-primary">

                                        Next

                                    </button>

                                </div>

                            </div>

                        </div>

                        <!-- ================= Personal Information ================= -->

                        <div class="tab-pane fade" id="personal">

                            <div class="container mt-3">

                                <div class="row">

                                    <!-- Left Side -->

                                    <div class="col-md-6">

                                        <div class="col-md-4">

                                            <label class="form-label">
                                                Religion
                                            </label>


                                            <div class="input-group">

                                                <input type="text"
                                                       id="ReligionSearch"
                                                       class="form-control"
                                                       placeholder="Search Religion"
                                                       readonly />


                                                <button type="button"
                                                        class="btn btn-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#ReligionModal">

                                                    🔍

                                                </button>

                                            </div>


                                            <input type="hidden"
                                                   asp-for="Religion"
                                                   id="ReligionId" />

                                        </div>
                                        <div class="modal fade" id="ReligionModal">

                                            <div class="modal-dialog modal-lg">

                                                <div class="modal-content">


                                                    <div class="modal-header">

                                                        <h5>Select Religion</h5>

                                                        <button class="btn-close"
                                                                data-bs-dismiss="modal">
                                                        </button>

                                                    </div>


                                                    <div class="modal-body">


                                                        <input type="text"
                                                               id="searchReligion"
                                                               class="form-control mb-3"
                                                               placeholder="Search Religion"
                                                               onkeyup="searchReligion()" />


                                                        <table class="table table-bordered">

                                                            <thead>

                                                                <tr>

                                                                    <th>Code</th>

                                                                    <th>Religion</th>

                                                                    <th></th>

                                                                </tr>

                                                            </thead>


                                                            <tbody id="religionTable">


                                                                @foreach (var item in ViewBag.Religions)
                                                                {

                                                                    <tr>

                                                                        <td>
                                                                            @item.Code
                                                                        </td>


                                                                        <td>
                                                                            @item.ReligionName
                                                                        </td>


                                                                        <td>

                                                                            <button type="button"
                                                                                    class="btn btn-success btn-sm"
                                                                                    onclick="selectReligion('@item.Code','@item.ReligionName')">

                                                                                Select

                                                                            </button>

                                                                        </td>

                                                                    </tr>

                                                                }


                                                            </tbody>


                                                        </table>


                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                            <div class="col-md-4">

                                                <label class="form-label">
                                                    Caste
                                                </label>

                                                <div class="input-group">

                                                    <input type="text"
                                                           id="CasteSearch"
                                                           class="form-control"
                                                           placeholder="Search Caste"
                                                           readonly />

                                                    <button type="button"
                                                            class="btn btn-primary"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#CasteModal">

                                                        🔍

                                                    </button>

                                                </div>


                                                <input type="hidden"
                                                       asp-for="Caste"
                                                       id="CasteId" />


                                            </div>


                                            <!-- Caste Modal -->

                                            <div class="modal fade" id="CasteModal">

                                                <div class="modal-dialog modal-lg">

                                                    <div class="modal-content">


                                                        <div class="modal-header">

                                                            <h5 class="modal-title">
                                                                Select Caste
                                                            </h5>

                                                            <button type="button"
                                                                    class="btn-close"
                                                                    data-bs-dismiss="modal">
                                                            </button>

                                                        </div>


                                                        <div class="modal-body">


                                                            <input type="text"
                                                                   id="searchCaste"
                                                                   class="form-control mb-3"
                                                                   placeholder="Search Caste"
                                                                   onkeyup="searchCaste()" />



                                                            <table class="table table-bordered table-hover">

                                                                <thead>

                                                                    <tr>

                                                                        <th>
                                                                            Code
                                                                        </th>

                                                                        <th>
                                                                            Caste Name
                                                                        </th>

                                                                        <th>
                                                                            Action
                                                                        </th>

                                                                    </tr>

                                                                </thead>


                                                                <tbody id="casteTable">


                                                                    @foreach (var item in ViewBag.Castes)
                                                                    {

                                                                        <tr>

                                                                            <td>
                                                                                @item.Code
                                                                            </td>


                                                                            <td>
                                                                                @item.CastName
                                                                            </td>


                                                                            <td>

                                                                                <button type="button"
                                                                                        class="btn btn-success btn-sm"
                                                                                        onclick="selectCaste('@item.Code','@item.CastName')">

                                                                                    Select

                                                                                </button>

                                                                            </td>


                                                                        </tr>

                                                                    }


                                                                </tbody>


                                                            </table>


                                                        </div>


                                                    </div>

                                                </div>

                                            </div>
                                      
                                        <!-- Gender -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Gender
                                            </label>

                                            <div class="col-md-7">

                                                <div class="form-check form-check-inline">

                                                    <input asp-for="Gender"
                                                           class="form-check-input"
                                                           type="radio"
                                                           value="Male">

                                                    <label class="form-check-label">
                                                        Male
                                                    </label>

                                                </div>

                                                <div class="form-check form-check-inline">

                                                    <input asp-for="Gender"
                                                           class="form-check-input"
                                                           type="radio"
                                                           value="Female">

                                                    <label class="form-check-label">
                                                        Female
                                                    </label>

                                                </div>

                                            </div>

                                        </div>

                                        <!-- Birth Date -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Birth Date
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="BirthDate"
                                                       type="date"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Identification Mark -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Identification Mark
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="IdentificationMark"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Known Language -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Known Language
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="KnownLanguage"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <!-- Education -->

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Education
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="Education"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                    <!-- Right Side -->

                                    <div class="col-md-6">

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Blood Group
                                            </label>

                                            <div class="col-md-7">

                                                <select asp-for="BloodGroup"
                                                        class="form-select">

                                                    <option value="">Select</option>
                                                    <option>A+</option>
                                                    <option>A-</option>
                                                    <option>B+</option>
                                                    <option>B-</option>
                                                    <option>AB+</option>
                                                    <option>AB-</option>
                                                    <option>O+</option>
                                                    <option>O-</option>

                                                </select>

                                            </div>

                                        </div>

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Height
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="Height"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Mother Tongue
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="MotherTongue"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                        <div class="mb-3 row">

                                            <label class="col-md-5 col-form-label fw-bold">
                                                Mode of Sign
                                            </label>

                                            <div class="col-md-7">

                                                <input asp-for="ModeOfSign"
                                                       class="form-control" />

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <div class="text-end mt-4">

                                    <button type="button"
                                            class="btn btn-secondary">
                                        Previous
                                    </button>

                                    <button type="submit"
                                            class="btn btn-success">
                                        Save Employee
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="text-center mt-4">

                        <button type="reset" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> New
                        </button>

                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save"></i> Save
                        </button>

                        <button type="button" class="btn btn-warning">
                            <i class="bi bi-pencil-square"></i> Update
                        </button>

                        <button type="button" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </button>

                        <button type="button" class="btn btn-info text-white">
                            <i class="bi bi-eye"></i> View
                        </button>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-secondary">
                            <i class="bi bi-box-arrow-right"></i> Exit
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>



    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        // ============================================================
        // DOCUMENT READY
        // ============================================================

        $(document).ready(function () {

            console.log("Register page JavaScript loaded.");


            // ========================================================
            // CUSTOMER SEARCH BUTTON
            // ========================================================

            $("#btnSearchCustomer").on("click", function () {

                GetEmployee();

            });


            // ========================================================
            // CUSTOMER ID - ENTER KEY
            // ========================================================

            $("#EmployeeIdSearch").on("keydown", function (e) {

                if (e.key === "Enter") {

                    e.preventDefault();

                    GetEmployee();

                }

            });

        });


        // ============================================================
        // GET CUSTOMER / EMPLOYEE INFORMATION
        // ============================================================

        function GetEmployee() {

            // --------------------------------------------------------
            // Get Customer ID
            // --------------------------------------------------------

            var custId =
                $.trim($("#EmployeeIdSearch").val());


            console.log(
                "Customer ID entered:",
                custId
            );


            // --------------------------------------------------------
            // Validate Customer ID
            // --------------------------------------------------------

            if (custId === "") {

                $("#CustomerSearchMessage")
                    .removeClass("text-success")
                    .addClass("text-danger")
                    .text("Please enter Customer ID.");

                return;
            }


            // --------------------------------------------------------
            // Disable Search Button
            // --------------------------------------------------------

            $("#btnSearchCustomer")
                .prop("disabled", true)
                .text("Searching...");


            // --------------------------------------------------------
            // Show Searching Message
            // --------------------------------------------------------

            $("#CustomerSearchMessage")
                .removeClass("text-success text-danger")
                .text("Searching customer...");


            // ========================================================
            // AJAX REQUEST
            // ========================================================

            $.ajax({

                url: "/Employee/GetEmployee",

                type: "GET",

                data: {
                    custId: custId
                },

                dataType: "json",


                // ====================================================
                // SUCCESS
                // ====================================================

                success: function (response) {

                    console.log(
                        "SERVER RESPONSE:",
                        response
                    );


                    // ------------------------------------------------
                    // Check Success
                    // ------------------------------------------------

                    if (!response.success) {

                        $("#CustomerSearchMessage")
                            .removeClass("text-success")
                            .addClass("text-danger")
                            .text(
                                response.message ||
                                "Customer not found."
                            );

                        clearCustomerFields();

                        return;
                    }


                    // ------------------------------------------------
                    // Get Returned Data
                    // ------------------------------------------------

                    var data = response.data;


                    console.log(
                        "CUSTOMER DATA:",
                        data
                    );


                    // =================================================
                    // GENERAL INFORMATION
                    // =================================================

                    // Customer ID
                    $("#EmployeeIdSearch")
                        .val(data.customerId || custId);


                    // Employee Code
                    $("#EmployeeCode")
                        .val(data.employeeCode || "");


                    // Employee Name
                    $("#EmployeeName")
                        .val(data.employeeName || "");


                    // Employee Type
                    if (data.employeeType) {

                        $("#EmployeeType")
                            .val(data.employeeType);

                    }


                    // =================================================
                    // ADDRESS INFORMATION
                    // =================================================

                    $("#Address1")
                        .val(data.address1 || "");


                    $("#Address2")
                        .val(data.address2 || "");


                    $("#Address3")
                        .val(data.address3 || "");


                    $("#Address4")
                        .val(data.address4 || "");


                    $("#Address5")
                        .val(data.address5 || "");


                    // City
                    $("#City")
                        .val(data.city || "");


                    // State
                    $("#State")
                        .val(data.state || "");


                    // District
                    $("#District")
                        .val(data.district || "");


                    // Taluka
                    $("#Taluka")
                        .val(data.taluka || "");


                    // =================================================
                    // CONTACT INFORMATION
                    // =================================================

                    $("#Phone")
                        .val(data.phone || "");


                    $("#Phone1")
                        .val(data.phone1 || "");


                    $("#Mobile")
                        .val(data.mobile || "");


                    $("#Email")
                        .val(data.email || "");


                    // =================================================
                    // PERSONAL INFORMATION
                    // =================================================

                    $("#FatherName")
                        .val(data.fatherName || "");


                    $("#Gender")
                        .val(data.gender || "");


                    // Birth Date
                    $("#BirthDate")
                        .val(
                            formatDate(data.birthDate)
                        );


                    // =================================================
                    // RELIGION
                    // =================================================

                    console.log(
                        "Religion:",
                        data.religion
                    );


                    console.log(
                        "Religion Code:",
                        data.religionCode
                    );


                    $("#ReligionSearch")
                        .val(data.religion || "");


                    // If your page has a hidden Religion field
                    $("#Religion")
                        .val(data.religion || "");


                    // =================================================
                    // CASTE
                    // =================================================

                    console.log(
                        "Caste:",
                        data.caste
                    );


                    console.log(
                        "Caste Code:",
                        data.casteCode
                    );


                    $("#CasteSearch")
                        .val(data.caste || "");


                    // If your page has a hidden Caste field
                    $("#Caste")
                        .val(data.caste || "");


                    // =================================================
                    // DOCUMENT INFORMATION
                    // =================================================

                    $("#PANNumber")
                        .val(data.panNumber || "");


                    $("#AadhaarNumber")
                        .val(data.aadhaarNumber || "");


                    // =================================================
                    // OTHER INFORMATION
                    // =================================================

                    $("#Nationality")
                        .val(data.nationality || "");


                    // =================================================
                    // SUCCESS MESSAGE
                    // =================================================

                    $("#CustomerSearchMessage")
                        .removeClass("text-danger")
                        .addClass("text-success")
                        .text(
                            "Customer information loaded successfully."
                        );

                },


                // ====================================================
                // AJAX ERROR
                // ====================================================

                error: function (xhr) {

                    console.error(
                        "AJAX ERROR:",
                        xhr
                    );


                    console.error(
                        "STATUS:",
                        xhr.status
                    );


                    console.error(
                        "SERVER RESPONSE:",
                        xhr.responseText
                    );


                    var message =
                        "Unable to retrieve customer information.";


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;

                    }


                    $("#CustomerSearchMessage")
                        .removeClass("text-success")
                        .addClass("text-danger")
                        .text(message);


                    clearCustomerFields();

                },


                // ====================================================
                // COMPLETE
                // ====================================================

                complete: function () {

                    $("#btnSearchCustomer")
                        .prop("disabled", false)
                        .text("Search");

                }

            });

        }


        // ============================================================
        // FORMAT DATE
        // ============================================================

        function formatDate(date) {

            if (!date) {

                return "";

            }


            // If already yyyy-MM-dd
            if (
                typeof date === "string" &&
                /^\d{4}-\d{2}-\d{2}$/.test(date)
            ) {

                return date;

            }


            // Handle ISO date
            if (
                typeof date === "string" &&
                date.length >= 10
            ) {

                return date.substring(0, 10);

            }


            return "";

        }


        // ============================================================
        // CLEAR CUSTOMER FIELDS
        // ============================================================

        function clearCustomerFields() {

            $("#EmployeeCode").val("");

            $("#EmployeeName").val("");

            $("#Address1").val("");

            $("#Address2").val("");

            $("#Address3").val("");

            $("#Address4").val("");

            $("#Address5").val("");

            $("#City").val("");

            $("#State").val("");

            $("#District").val("");

            $("#Taluka").val("");

            $("#Phone").val("");

            $("#Phone1").val("");

            $("#Mobile").val("");

            $("#Email").val("");

            $("#FatherName").val("");

            $("#Gender").val("");

            $("#BirthDate").val("");

            $("#ReligionSearch").val("");

            $("#Religion").val("");

            $("#CasteSearch").val("");

            $("#Caste").val("");

            $("#PANNumber").val("");

            $("#AadhaarNumber").val("");

            $("#Nationality").val("");

        }

    </script>
</body>
</html>
