        // ============================================================
        // SET RELIGION FROM PAYMAST
        // ============================================================

        function setReligionValues(
            code,
            name
        ) {

            $("#ReligionId")
                .val(
                    code == null
                        ? ""
                        : code
                );


            if (name) {

                $("#ReligionSearch")
                    .val(
                        name
                    );

                return;
            }


            $("#ReligionSearch")
                .val("");


            if (
                code == null ||
                code === ""
            ) {

                return;

            }


            $.ajax({

                url:
                    '@Url.Action("GetReligionName", "Employee")',

                type:
                    "GET",

                data: {
                    code:
                        code
                },

                success:
                    function (response) {

                        if (
                            response &&
                            response.success
                        ) {

                            $("#ReligionSearch")
                                .val(
                                    response.name || ""
                                );

                        }

                    }

            });

        }



