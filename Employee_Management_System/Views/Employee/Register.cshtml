        // ==========================================================
        // SAFE HTML
        // ==========================================================

        function escapeHtml(
            value
        ) {


            if (
                value === null ||
                value === undefined
            ) {


                return "";


            }


            return $("<div>")
                .text(
                    value.toString()
                )
                .html();


        }



