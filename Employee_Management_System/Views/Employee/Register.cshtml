    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>



    <script>


        // ==========================================================
        // DOCUMENT READY
        // ==========================================================

        $(document).ready(function () {


            // ======================================================
            // NEW EMPLOYEE SUCCESS POPUP
            // ======================================================

            var successModalElement =
                document.getElementById(
                    "employeeSuccessModal"
                );


            if (successModalElement) {

                bootstrap.Modal
                    .getOrCreateInstance(
                        successModalElement
                    )
                    .show();

            }



            // ======================================================
            // UPDATE SUCCESS POPUP
            // ======================================================

            var updateModalElement =
                document.getElementById(
                    "employeeUpdateSuccessModal"
                );


            if (updateModalElement) {

                bootstrap.Modal
                    .getOrCreateInstance(
                        updateModalElement
                    )
                    .show();

            }



            // ======================================================
            // DUPLICATE POPUP
            // ======================================================

            @if (TempData["DuplicateEmployee"] != null)
            {
                <text>

                    $("#existingEmployeeName")
                        .text(
                            @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                    TempData["DuplicateEmployeeName"]?.ToString() ?? ""
                                )
                            )
                        );


                    $("#existingEmployeeCode")
                        .text(
                            @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                    TempData["DuplicateEmployeeCode"]?.ToString() ?? ""
                                )
                            )
                        );


                    var duplicateModalElement =
                        document.getElementById(
                            "employeeAlreadyExistsModal"
                        );


                    if (duplicateModalElement) {

                        bootstrap.Modal
                            .getOrCreateInstance(
                                duplicateModalElement
                            )
                            .show();

                    }

                </text>
            }



            // ======================================================
            // CUSTOMER SEARCH
            // ======================================================

            $("#btnSearchCustomer")
                .click(function () {

                    GetEmployee();

                });



            $("#EmployeeIdSearch")
                .keydown(function (e) {

                    if (e.key === "Enter") {

                        e.preventDefault();

                        GetEmployee();

                    }

                });



            // ======================================================
            // EXISTING DATA MODAL
            // ======================================================

            $("#ExistingEmployeeModal")
                .on(
                    "shown.bs.modal",
                    function () {

                        LoadInitialExistingEmployees();

                    }
                );


            // ======================================================
            // IMPORTANT GREY SCREEN FIX
            // ======================================================

            $("#ExistingEmployeeModal")
                .on(
                    "hidden.bs.modal",
                    function () {

                        cleanModalBackdrop();

                    }
                );



            $("#ExistingSearchBy")
                .change(function () {

                    if ($(this).val() === "name") {

                        $("#ExistingSearchText")
                            .attr(
                                "placeholder",
                                "Enter Employee Name"
                            );

                    }
                    else {

                        $("#ExistingSearchText")
                            .attr(
                                "placeholder",
                                "Enter Employee Code"
                            );

                    }


                    $("#ExistingSearchText")
                        .val("");


                    $("#ExistingSearchMessage")
                        .text("");

                });



            $("#btnSearchExistingEmployee")
                .click(function () {

                    SearchExistingEmployees();

                });



            $("#ExistingSearchText")
                .keydown(function (e) {

                    if (e.key === "Enter") {

                        e.preventDefault();

                        SearchExistingEmployees();

                    }

                });



            // ======================================================
            // NEW BUTTON
            // ======================================================

            $("#btnNewEmployee")
                .click(function () {

                    setTimeout(
                        function () {

                            clearCustomerFields();

                            $("#EmployeeIdSearch")
                                .val("");

                            $("#CustomerSearchMessage")
                                .text("");

                            enableNewEmployeeMode();

                            openEmployeeTab(
                                "general-tab"
                            );

                        },
                        50
                    );

                });


        });



        // ==========================================================
        // GREY BACKDROP FIX
        // ==========================================================

        function cleanModalBackdrop() {


            $(".modal-backdrop")
                .remove();


            $("body")
                .removeClass(
                    "modal-open"
                );


            $("body")
                .css(
                    {
                        "overflow": "",
                        "padding-right": ""
                    }
                );


            $("html")
                .css(
                    "overflow",
                    ""
                );


        }



        // ==========================================================
        // NEXT / PREVIOUS
        // ==========================================================

        function openEmployeeTab(
            tabButtonId
        ) {


            var tabButton =
                document.getElementById(
                    tabButtonId
                );


            if (!tabButton) {

                return;

            }


            bootstrap.Tab
                .getOrCreateInstance(
                    tabButton
                )
                .show();


        }



        // ==========================================================
        // CUSTOMER SEARCH FROM prtymast
        // ==========================================================

        function GetEmployee() {


            var custId =
                $.trim(
                    $("#EmployeeIdSearch")
                        .val()
                );


            if (custId === "") {


                $("#CustomerSearchMessage")
                    .removeClass(
                        "text-success"
                    )
                    .addClass(
                        "text-danger"
                    )
                    .text(
                        "Please enter Customer ID."
                    );


                return;


            }


            enableNewEmployeeMode();


            $("#HiddenCustomerId")
                .val("");


            $("#EmployeeCode")
                .val("");


            $("#btnSearchCustomer")
                .prop(
                    "disabled",
                    true
                )
                .text(
                    "Searching..."
                );


            $.ajax({


                url:
                    "/Employee/GetEmployee",


                type:
                    "GET",


                dataType:
                    "json",


                data: {

                    custId:
                        custId

                },


                success: function (response) {


                    // =================================================
                    // DUPLICATE
                    // =================================================

                    if (response.alreadyExists === true) {


                        clearCustomerFields();


                        $("#EmployeeIdSearch")
                            .val(
                                custId
                            );


                        $("#existingEmployeeName")
                            .text(
                                response.employeeName ||
                                ""
                            );


                        $("#existingEmployeeCode")
                            .text(
                                response.employeeCode ||
                                ""
                            );


                        $("#CustomerSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                "Employee already exists."
                            );


                        bootstrap.Modal
                            .getOrCreateInstance(
                                document.getElementById(
                                    "employeeAlreadyExistsModal"
                                )
                            )
                            .show();


                        return;


                    }



                    if (!response.success) {


                        $("#CustomerSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                response.message ||
                                "Customer not found."
                            );


                        clearCustomerFields();


                        return;


                    }


                    var data =
                        response.data;



                    $("#EmployeeIdSearch")
                        .val(
                            data.customerId ||
                            custId
                        );


                    $("#HiddenCustomerId")
                        .val(
                            data.customerId ||
                            custId
                        );


                    // Employee Code only generates after Save
                    $("#EmployeeCode")
                        .val("");


                    $("#EmployeeName")
                        .val(
                            data.employeeName ||
                            ""
                        );


                    $("#Address1")
                        .val(
                            data.address1 ||
                            ""
                        );


                    $("#Address2")
                        .val(
                            data.address2 ||
                            ""
                        );


                    $("#CorrespondenceAddress1")
                        .val(
                            data.address1 ||
                            ""
                        );


                    $("#CorrespondenceAddress2")
                        .val(
                            data.address2 ||
                            ""
                        );


                    $("#PermanentAddress1")
                        .val(
                            data.address1 ||
                            ""
                        );


                    $("#PermanentAddress2")
                        .val(
                            data.address2 ||
                            ""
                        );


                    $("#FatherName")
                        .val(
                            data.fatherName ||
                            ""
                        );


                    $("#PANNumber")
                        .val(
                            data.panNumber ||
                            ""
                        );


                    $("#AadhaarNumber")
                        .val(
                            data.aadhaarNumber ||
                            ""
                        );


                    // =================================================
                    // GENDER
                    // =================================================

                    $("input[name='Gender']")
                        .prop(
                            "checked",
                            false
                        );


                    if (data.gender) {


                        var gender =
                            data.gender
                                .toString()
                                .trim()
                                .toUpperCase();


                        if (gender === "MALE") {

                            gender = "M";

                        }


                        if (gender === "FEMALE") {

                            gender = "F";

                        }


                        if (
                            gender === "M" ||
                            gender === "F"
                        ) {


                            $(
                                "input[name='Gender'][value='" +
                                gender +
                                "']"
                            )
                                .prop(
                                    "checked",
                                    true
                                );


                        }


                    }



                    $("#BirthDate")
                        .val(
                            formatDate(
                                data.birthDate
                            )
                        );


                    $("#ReligionId")
                        .val(
                            data.religionCode ||
                            ""
                        );


                    $("#ReligionSearch")
                        .val(
                            data.religion ||
                            ""
                        );


                    $("#CasteId")
                        .val(
                            data.casteCode ||
                            ""
                        );


                    $("#CasteSearch")
                        .val(
                            data.caste ||
                            ""
                        );


                    $("#MotherTongue")
                        .val("");


                    $("#CustomerSearchMessage")
                        .removeClass(
                            "text-danger"
                        )
                        .addClass(
                            "text-success"
                        )
                        .text(
                            "Customer information loaded successfully."
                        );


                },


                error: function (xhr) {


                    var message =
                        "Unable to retrieve customer information.";


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;

                    }


                    $("#CustomerSearchMessage")
                        .removeClass(
                            "text-success"
                        )
                        .addClass(
                            "text-danger"
                        )
                        .text(
                            message
                        );


                },


                complete: function () {


                    $("#btnSearchCustomer")
                        .prop(
                            "disabled",
                            false
                        )
                        .html(
                            '<i class="bi bi-search"></i> Search'
                        );


                }


            });


        }



        // ==========================================================
        // INITIAL EXISTING DATA
        // ==========================================================

        function LoadInitialExistingEmployees() {


            $("#ExistingSearchText")
                .val("");


            $("#ExistingSearchMessage")
                .removeClass(
                    "text-success text-danger"
                )
                .text(
                    "Loading latest employees from PayMast..."
                );


            $("#ExistingEmployeeResults")
                .html(
                    '<tr>' +
                    '<td colspan="3" class="text-center text-muted">' +
                    'Loading...' +
                    '</td>' +
                    '</tr>'
                );


            $.ajax({


                url:
                    "/Employee/SearchExistingEmployees",


                type:
                    "GET",


                dataType:
                    "json",


                data: {

                    searchBy:
                        "",

                    searchText:
                        ""

                },


                success: function (response) {


                    if (!response.success) {


                        $("#ExistingSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                response.message ||
                                "Unable to load employees."
                            );


                        return;


                    }


                    var employees =
                        response.data ||
                        [];


                    if (employees.length === 0) {


                        $("#ExistingSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                "No employee found in PayMast."
                            );


                        $("#ExistingEmployeeResults")
                            .html(
                                '<tr>' +
                                '<td colspan="3" class="text-center">' +
                                'No employee found.' +
                                '</td>' +
                                '</tr>'
                            );


                        return;


                    }


                    $("#ExistingSearchMessage")
                        .removeClass(
                            "text-danger"
                        )
                        .addClass(
                            "text-success"
                        )
                        .text(
                            "Latest " +
                            employees.length +
                            " employee(s) loaded."
                        );


                    RenderExistingEmployeeRows(
                        employees
                    );


                },


                error: function (xhr) {


                    var message =
                        "Unable to load employee data.";


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;

                    }


                    $("#ExistingSearchMessage")
                        .removeClass(
                            "text-success"
                        )
                        .addClass(
                            "text-danger"
                        )
                        .text(
                            message
                        );


                }


            });


        }



        // ==========================================================
        // SEARCH EXISTING EMPLOYEE
        // ==========================================================

        function SearchExistingEmployees() {


            var searchBy =
                $("#ExistingSearchBy")
                    .val();


            var searchText =
                $.trim(
                    $("#ExistingSearchText")
                        .val()
                );


            if (searchText === "") {


                $("#ExistingSearchMessage")
                    .removeClass(
                        "text-success"
                    )
                    .addClass(
                        "text-danger"
                    )
                    .text(
                        "Please enter search value."
                    );


                return;


            }


            $("#btnSearchExistingEmployee")
                .prop(
                    "disabled",
                    true
                )
                .text(
                    "Searching..."
                );


            $.ajax({


                url:
                    "/Employee/SearchExistingEmployees",


                type:
                    "GET",


                dataType:
                    "json",


                data: {

                    searchBy:
                        searchBy,

                    searchText:
                        searchText

                },


                success: function (response) {


                    if (!response.success) {


                        $("#ExistingSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                response.message ||
                                "Search failed."
                            );


                        return;


                    }


                    var employees =
                        response.data ||
                        [];


                    if (employees.length === 0) {


                        $("#ExistingSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                "No employee found in PayMast."
                            );


                        $("#ExistingEmployeeResults")
                            .html(
                                '<tr>' +
                                '<td colspan="3" class="text-center">' +
                                'No employee found.' +
                                '</td>' +
                                '</tr>'
                            );


                        return;


                    }


                    $("#ExistingSearchMessage")
                        .removeClass(
                            "text-danger"
                        )
                        .addClass(
                            "text-success"
                        )
                        .text(
                            employees.length +
                            " employee(s) found."
                        );


                    RenderExistingEmployeeRows(
                        employees
                    );


                },


                error: function (xhr) {


                    var message =
                        "Unable to search employee.";


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;

                    }


                    $("#ExistingSearchMessage")
                        .removeClass(
                            "text-success"
                        )
                        .addClass(
                            "text-danger"
                        )
                        .text(
                            message
                        );


                },


                complete: function () {


                    $("#btnSearchExistingEmployee")
                        .prop(
                            "disabled",
                            false
                        )
                        .html(
                            '<i class="bi bi-search"></i> Search'
                        );


                }


            });


        }



        // ==========================================================
        // RENDER EMPLOYEE CODE + NAME
        // ==========================================================

        function RenderExistingEmployeeRows(
            employees
        ) {


            var html =
                "";


            $.each(
                employees,
                function (
                    index,
                    employee
                ) {


                    var code =
                        employee.employeeCode;


                    var name =
                        employee.employeeName ||
                        "";


                    html +=
                        "<tr>" +

                        "<td>" +
                        escapeHtml(
                            code
                        ) +
                        "</td>" +

                        "<td>" +
                        escapeHtml(
                            name
                        ) +
                        "</td>" +

                        "<td>" +

                        '<button type="button" ' +
                        'class="btn btn-success btn-sm" ' +
                        'onclick="LoadExistingEmployee(' +
                        code +
                        ')">' +

                        '<i class="bi bi-check-circle"></i> ' +
                        'Select' +

                        '</button>' +

                        "</td>" +

                        "</tr>";


                }
            );


            $("#ExistingEmployeeResults")
                .html(
                    html
                );


        }



        // ==========================================================
        // LOAD EXISTING EMPLOYEE FROM PAYMAST
        // ==========================================================

        function LoadExistingEmployee(
            employeeCode
        ) {


            $.ajax({


                url:
                    "/Employee/GetExistingEmployee",


                type:
                    "GET",


                dataType:
                    "json",


                data: {

                    employeeCode:
                        employeeCode

                },


                success: function (response) {


                    if (!response.success) {


                        $("#ExistingSearchMessage")
                            .removeClass(
                                "text-success"
                            )
                            .addClass(
                                "text-danger"
                            )
                            .text(
                                response.message ||
                                "Unable to load employee."
                            );


                        return;


                    }


                    var data =
                        response.data;



                    // =================================================
                    // BASIC
                    // =================================================

                    $("#ExistingEmployeeCode")
                        .val(
                            data.employeeCode ||
                            ""
                        );


                    $("#EmployeeCode")
                        .val(
                            data.employeeCode ||
                            ""
                        );


                    $("#HiddenCustomerId")
                        .val(
                            data.customerId ||
                            ""
                        );


                    $("#EmployeeIdSearch")
                        .val(
                            data.customerId ||
                            ""
                        );


                    $("#EmployeeName")
                        .val(
                            data.employeeName ||
                            ""
                        );


                    $("#EmployeeType")
                        .val(
                            data.employeeType ||
                            ""
                        );



                    // =================================================
                    // GENERAL
                    // =================================================

                    $("#GradeId")
                        .val(
                            data.gradeId ||
                            ""
                        );


                    $("#SectionId")
                        .val(
                            data.sectionId ||
                            ""
                        );


                    $("#BranchId")
                        .val(
                            data.branchId ||
                            ""
                        );


                    $("#JoiningDate")
                        .val(
                            formatDate(
                                data.joiningDate
                            )
                        );


                    $("#PermanentDate")
                        .val(
                            formatDate(
                                data.permanentDate
                            )
                        );


                    $("#BasicSalary")
                        .val(
                            data.basicSalary ??
                            ""
                        );


                    $("#LastSalaryIncrementDate")
                        .val(
                            formatDate(
                                data.lastSalaryIncrementDate
                            )
                        );


                    $("#RetirementDate")
                        .val(
                            formatDate(
                                data.retirementDate
                            )
                        );



                    // =================================================
                    // OTHER
                    // =================================================

                    $("#PensionFundOpeningBalance")
                        .val(
                            data.pensionFundOpeningBalance ??
                            ""
                        );


                    $("#PFNumber")
                        .val(
                            data.pfNumber ||
                            ""
                        );


                    $("#PFOpeningBalance")
                        .val(
                            data.pfOpeningBalance ??
                            ""
                        );


                    $("#PANNumber")
                        .val(
                            data.panNumber ||
                            ""
                        );


                    $("#ITSerialNumber")
                        .val(
                            data.itSerialNumber ||
                            ""
                        );


                    $("#PFSerialNumber")
                        .val(
                            data.pfSerialNumber ??
                            ""
                        );


                    $("#PFBalance")
                        .val(
                            data.pfBalance ??
                            ""
                        );


                    $("#AadhaarNumber")
                        .val(
                            data.aadhaarNumber ??
                            ""
                        );



                    // =================================================
                    // ADDRESS
                    // =================================================

                    $("#CorrespondenceAddress1")
                        .val(
                            data.correspondenceAddress1 ||
                            ""
                        );


                    $("#CorrespondenceAddress2")
                        .val(
                            data.correspondenceAddress2 ||
                            ""
                        );


                    $("#PermanentAddress1")
                        .val(
                            data.permanentAddress1 ||
                            ""
                        );


                    $("#PermanentAddress2")
                        .val(
                            data.permanentAddress2 ||
                            ""
                        );


                    $("#Address1")
                        .val(
                            data.permanentAddress1 ||
                            ""
                        );


                    $("#Address2")
                        .val(
                            data.permanentAddress2 ||
                            ""
                        );


                    $("#FatherName")
                        .val(
                            data.fatherName ||
                            ""
                        );



                    // =================================================
                    // PERSONAL
                    // =================================================

                    $("#ReligionId")
                        .val(
                            data.religionCode ||
                            ""
                        );


                    $("#ReligionSearch")
                        .val(
                            data.religion ||
                            ""
                        );


                    $("#CasteId")
                        .val(
                            data.casteCode ||
                            ""
                        );


                    $("#CasteSearch")
                        .val(
                            data.caste ||
                            ""
                        );


                    $("input[name='Gender']")
                        .prop(
                            "checked",
                            false
                        );


                    if (data.gender) {


                        var gender =
                            data.gender
                                .toString()
                                .trim()
                                .toUpperCase();


                        if (
                            gender === "M" ||
                            gender === "F"
                        ) {


                            $(
                                "input[name='Gender'][value='" +
                                gender +
                                "']"
                            )
                                .prop(
                                    "checked",
                                    true
                                );


                        }


                    }


                    $("#BirthDate")
                        .val(
                            formatDate(
                                data.birthDate
                            )
                        );


                    $("#BloodGroup")
                        .val(
                            data.bloodGroup ||
                            ""
                        );


                    $("#IdentificationMark")
                        .val(
                            data.identificationMark ||
                            ""
                        );


                    $("#Height")
                        .val(
                            data.height ??
                            ""
                        );


                    $("#KnownLanguage")
                        .val(
                            data.knownLanguage ||
                            ""
                        );


                    $("#MotherTongue")
                        .val(
                            data.motherTongue ||
                            ""
                        );


                    $("#Education")
                        .val(
                            data.education ||
                            ""
                        );


                    $("#ModeOfSign")
                        .val(
                            data.modeOfSign ||
                            ""
                        );



                    // =================================================
                    // UPDATE MODE
                    // =================================================

                    enableExistingEmployeeMode();



                    $("#CustomerSearchMessage")
                        .removeClass(
                            "text-danger"
                        )
                        .addClass(
                            "text-success"
                        )
                        .text(
                            "Existing employee loaded from PayMast. Edit fields and click Update."
                        );



                    // =================================================
                    // CLOSE MODAL PROPERLY
                    // =================================================

                    var modalElement =
                        document.getElementById(
                            "ExistingEmployeeModal"
                        );


                    if (modalElement) {


                        var modalInstance =
                            bootstrap.Modal.getInstance(
                                modalElement
                            );


                        if (!modalInstance) {

                            modalInstance =
                                bootstrap.Modal.getOrCreateInstance(
                                    modalElement
                                );

                        }


                        modalInstance.hide();


                    }



                    // =================================================
                    // IMPORTANT:
                    // FORCE REMOVE GREY BACKDROP
                    // =================================================

                    setTimeout(
                        function () {

                            cleanModalBackdrop();

                            openEmployeeTab(
                                "general-tab"
                            );

                            window.scrollTo({
                                top: 0,
                                behavior: "smooth"
                            });

                        },
                        350
                    );


                },


                error: function (xhr) {


                    var message =
                        "Unable to load employee.";


                    if (
                        xhr.responseJSON &&
                        xhr.responseJSON.message
                    ) {

                        message =
                            xhr.responseJSON.message;

                    }


                    $("#ExistingSearchMessage")
                        .removeClass(
                            "text-success"
                        )
                        .addClass(
                            "text-danger"
                        )
                        .text(
                            message
                        );


                }


            });


        }



        // ==========================================================
        // NEW EMPLOYEE MODE
        // ==========================================================

        function enableNewEmployeeMode() {


            $("#ExistingEmployeeCode")
                .val("");


            $("#btnUpdateEmployee")
                .prop(
                    "disabled",
                    true
                );


            $("#btnBottomSave")
                .prop(
                    "disabled",
                    false
                );


            $("#btnSaveEmployee")
                .prop(
                    "disabled",
                    false
                );


        }



        // ==========================================================
        // EXISTING EMPLOYEE UPDATE MODE
        // ==========================================================

        function enableExistingEmployeeMode() {


            $("#btnUpdateEmployee")
                .prop(
                    "disabled",
                    false
                );


            // Existing employee ला पुन्हा Save होऊ देऊ नये
            $("#btnBottomSave")
                .prop(
                    "disabled",
                    true
                );


            $("#btnSaveEmployee")
                .prop(
                    "disabled",
                    true
                );


        }



        // ==========================================================
        // FORMAT DATE
        // ==========================================================

        function formatDate(
            date
        ) {


            if (!date) {

                return "";

            }


            if (
                typeof date === "string" &&
                date.length >= 10
            ) {


                return date.substring(
                    0,
                    10
                );


            }


            return "";


        }



        // ==========================================================
        // RELIGION
        // ==========================================================

        function selectReligion(
            code,
            name
        ) {


            $("#ReligionId")
                .val(
                    code
                );


            $("#ReligionSearch")
                .val(
                    name
                );


            var modalElement =
                document.getElementById(
                    "ReligionModal"
                );


            if (modalElement) {


                bootstrap.Modal
                    .getOrCreateInstance(
                        modalElement
                    )
                    .hide();


            }


        }



        function searchReligion() {


            var value =
                $("#searchReligion")
                    .val()
                    .toLowerCase();


            $("#religionTable tr")
                .filter(function () {


                    $(this)
                        .toggle(

                            $(this)
                                .text()
                                .toLowerCase()
                                .indexOf(
                                    value
                                ) > -1

                        );


                });


        }



