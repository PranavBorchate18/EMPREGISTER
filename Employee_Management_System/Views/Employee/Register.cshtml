@model Employee_Management_System.Models.Employee

@{
    ViewData["Title"] = "Employee Registration";
}

<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Employee Registration</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>

        .card-header {
            background-color: #0d6efd;
            color: white;
        }

        .nav-tabs .nav-link.active {
            background-color: #0d6efd;
            color: white;
        }

        .form-label {
            font-weight: bold;
        }

        .btn {
            min-width: 100px;
        }

        .existing-result-table tbody tr:hover {
            background-color: #f3f6f9;
        }

    </style>

</head>


<body>


    @* ============================================================
       NEW EMPLOYEE SUCCESS POPUP
       ============================================================ *@

    @if (TempData["Success"] != null)
    {
        <div class="modal fade"
             id="employeeSuccessModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header bg-success text-white">

                        <h5 class="modal-title">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            Employee Created Successfully

                        </h5>

                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body text-center">

                        <i class="bi bi-check-circle-fill text-success"
                           style="font-size:55px;">
                        </i>

                        <h4 class="text-success mt-3 mb-4">

                            Employee created successfully!

                        </h4>


                        <p>

                            <strong>
                                Employee Name:
                            </strong>

                            <br />

                            <span class="fs-5">

                                @(TempData["SuccessCustomerName"]
                                    ?? TempData["SuccessEmployeeName"]
                                    ?? "")

                            </span>

                        </p>


                        <p>

                            <strong>
                                Employee Code:
                            </strong>

                            <br />

                            <span class="fs-3 fw-bold text-success">

                                @TempData["SuccessEmployeeCode"]

                            </span>

                        </p>

                    </div>


                    <div class="modal-footer justify-content-center">

                        <button type="button"
                                class="btn btn-success"
                                data-bs-dismiss="modal">

                            OK

                        </button>

                    </div>

                </div>

            </div>

        </div>
    }



    @* ============================================================
       UPDATE SUCCESS POPUP
       ============================================================ *@

    @if (TempData["UpdateSuccess"]?.ToString() == "true")
    {
        <div class="modal fade"
             id="employeeUpdateSuccessModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header bg-success text-white">

                        <h5 class="modal-title">

                            <i class="bi bi-check-circle-fill me-2"></i>

                            Employee Successfully Updated!

                        </h5>


                        <button type="button"
                                class="btn-close btn-close-white"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <div class="modal-body text-center">

                        <i class="bi bi-check-circle-fill text-success"
                           style="font-size:55px;">
                        </i>


                        <h4 class="text-success mt-3 mb-4">

                            Employee Successfully Updated!

                        </h4>


                        <p>

                            <strong>
                                Employee Name:
                            </strong>

                            <br />

                            <span class="fs-5">

                                @TempData["UpdatedEmployeeName"]

                            </span>

                        </p>


                        <p>

                            <strong>
                                Employee Code:
                            </strong>

                            <br />

                            <span class="fs-3 fw-bold text-success">

                                @TempData["UpdatedEmployeeCode"]

                            </span>

                        </p>

                    </div>


                    <div class="modal-footer justify-content-center">

                        <button type="button"
                                class="btn btn-success"
                                data-bs-dismiss="modal">

                            OK

                        </button>

                    </div>

                </div>

            </div>

        </div>
    }



    @* ============================================================
       DUPLICATE EMPLOYEE POPUP
       ============================================================ *@

    <div class="modal fade"
         id="employeeAlreadyExistsModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header bg-warning">

                    <h5 class="modal-title">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        Employee Already Exists

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body text-center">

                    <i class="bi bi-exclamation-triangle-fill text-warning"
                       style="font-size:55px;">
                    </i>


                    <h5 class="text-danger mt-3 mb-4">

                        Employee already exists for this Customer ID.

                    </h5>


                    <p>

                        <strong>
                            Employee Name:
                        </strong>

                        <br />

                        <span id="existingEmployeeName"
                              class="fs-5">
                        </span>

                    </p>


                    <p>

                        <strong>
                            Employee Code:
                        </strong>

                        <br />

                        <span id="existingEmployeeCode"
                              class="fs-3 fw-bold text-primary">
                        </span>

                    </p>

                </div>


                <div class="modal-footer justify-content-center">

                    <button type="button"
                            class="btn btn-warning"
                            data-bs-dismiss="modal">

                        OK

                    </button>

                </div>

            </div>

        </div>

    </div>



    @* ============================================================
       MAIN PAGE
       ============================================================ *@

    <div class="container mt-4 mb-5">

        <div class="card shadow">

            <div class="card-header">

                <h3 class="text-center mb-0">

                    Employee Registration

                </h3>

            </div>


            <div class="card-body">


                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>


                <form asp-controller="Employee"
                      asp-action="Register"
                      method="post"
                      id="employeeForm">


                    @Html.AntiForgeryToken()


                    @* =================================================
                       HIDDEN FIELDS
                       ================================================= *@

                    <input type="hidden"
                           id="HiddenCustomerId"
                           name="CustomerId"
                           value="@Model.CustomerId" />


                    <input type="hidden"
                           id="ExistingEmployeeCode"
                           name="existingEmployeeCode"
                           value="" />



                    @* =================================================
                       CUSTOMER SEARCH
                       ================================================= *@

                    <div class="row mb-3 align-items-end">


                        <div class="col-md-2">

                            <label class="form-label fw-bold">

                                Customer ID

                            </label>

                        </div>


                        <div class="col-md-3">

                            <input type="text"
                                   id="EmployeeIdSearch"
                                   class="form-control"
                                   placeholder="Enter Customer ID"
                                   autocomplete="off" />

                        </div>


                        <div class="col-md-4 d-flex gap-2">

                            <button type="button"
                                    id="btnSearchCustomer"
                                    class="btn btn-primary">

                                <i class="bi bi-search"></i>

                                Search

                            </button>


                            <button type="button"
                                    id="btnExistingData"
                                    class="btn btn-dark"
                                    data-bs-toggle="modal"
                                    data-bs-target="#ExistingEmployeeModal">

                                <i class="bi bi-database"></i>

                                Existing Data

                            </button>

                        </div>


                        <div class="col-md-3">

                            <span id="CustomerSearchMessage"
                                  class="fw-bold">
                            </span>

                        </div>


                    </div>


                    <hr />



                    @* =================================================
                       EMPLOYEE BASIC INFORMATION
                       ================================================= *@

                    <div class="row">


                        <div class="col-md-3 mb-3">

                            <label asp-for="EmployeeCode"
                                   class="form-label">

                                Employee Code

                            </label>

                            <input asp-for="EmployeeCode"
                                   id="EmployeeCode"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="col-md-5 mb-3">

                            <label asp-for="EmployeeName"
                                   class="form-label">

                                Employee Name

                            </label>

                            <input asp-for="EmployeeName"
                                   id="EmployeeName"
                                   class="form-control" />

                            <span asp-validation-for="EmployeeName"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-4 mb-3">

                            <label asp-for="EmployeeType"
                                   class="form-label">

                                Employee Type

                            </label>

                            <select asp-for="EmployeeType"
                                    id="EmployeeType"
                                    class="form-select">

                                <option value="">
                                    Select Type
                                </option>

                                <option value="1">
                                    Permanent
                                </option>

                                <option value="2">
                                    Temporary
                                </option>

                                <option value="3">
                                    Contract
                                </option>

                            </select>

                        </div>


                    </div>



                    @* =================================================
                       TABS
                       ================================================= *@

                    <ul class="nav nav-tabs"
                        id="employeeTabs">


                        <li class="nav-item">

                            <button type="button"
                                    class="nav-link active"
                                    id="general-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#general">

                                General Information

                            </button>

                        </li>


                        <li class="nav-item">

                            <button type="button"
                                    class="nav-link"
                                    id="other-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#other">

                                Other Information

                            </button>

                        </li>


                        <li class="nav-item">

                            <button type="button"
                                    class="nav-link"
                                    id="address-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#address">

                                Address Information

                            </button>

                        </li>


                        <li class="nav-item">

                            <button type="button"
                                    class="nav-link"
                                    id="personal-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#personal">

                                Personal Information

                            </button>

                        </li>


                    </ul>



                    <div class="tab-content border border-top-0 p-4"
                         id="employeeTabContent">



                        @* =================================================
                           GENERAL INFORMATION
                           ================================================= *@

                        <div class="tab-pane fade show active"
                             id="general">


                            <div class="row">


                                <div class="col-md-4 mb-3">

                                    <label asp-for="GradeId"
                                           class="form-label">

                                        Grade

                                    </label>

                                    <select asp-for="GradeId"
                                            id="GradeId"
                                            asp-items="ViewBag.Grades"
                                            class="form-select">

                                        <option value="">
                                            -- Select Grade --
                                        </option>

                                    </select>

                                </div>


                                <div class="col-md-4 mb-3">

                                    <label asp-for="SectionId"
                                           class="form-label">

                                        Section

                                    </label>

                                    <select asp-for="SectionId"
                                            id="SectionId"
                                            asp-items="ViewBag.Sections"
                                            class="form-select">

                                        <option value="">
                                            -- Select Section --
                                        </option>

                                    </select>

                                </div>


                                <div class="col-md-4 mb-3">

                                    <label asp-for="BranchId"
                                           class="form-label">

                                        Branch

                                    </label>

                                    <select asp-for="BranchId"
                                            id="BranchId"
                                            asp-items="ViewBag.Branches"
                                            class="form-select">

                                        <option value="">
                                            -- Select Branch --
                                        </option>

                                    </select>

                                </div>


                            </div>



                            <div class="row">


                                <div class="col-md-4 mb-3">

                                    <label asp-for="JoiningDate"
                                           class="form-label">

                                        Joining Date

                                    </label>

                                    <input asp-for="JoiningDate"
                                           id="JoiningDate"
                                           type="date"
                                           class="form-control" />

                                </div>


                                <div class="col-md-4 mb-3">

                                    <label asp-for="PermanentDate"
                                           class="form-label">

                                        Permanent Date

                                    </label>

                                    <input asp-for="PermanentDate"
                                           id="PermanentDate"
                                           type="date"
                                           class="form-control" />

                                </div>


                                <div class="col-md-4 mb-3">

                                    <label asp-for="LastSalaryDate"
                                           class="form-label">

                                        Last Salary Date

                                    </label>

                                    <input asp-for="LastSalaryDate"
                                           id="LastSalaryDate"
                                           type="date"
                                           class="form-control" />

                                </div>


                            </div>



                            <div class="row">


                                <div class="col-md-4 mb-3">

                                    <label asp-for="BasicSalary"
                                           class="form-label">

                                        Basic Salary

                                    </label>

                                    <input asp-for="BasicSalary"
                                           id="BasicSalary"
                                           class="form-control" />

                                </div>


                                <div class="col-md-4 mb-3">

                                    <label asp-for="LastSalaryIncrementDate"
                                           class="form-label">

                                        Last Salary Increment Date

                                    </label>

                                    <input asp-for="LastSalaryIncrementDate"
                                           id="LastSalaryIncrementDate"
                                           type="date"
                                           class="form-control" />

                                </div>


                                <div class="col-md-4 mb-3">

                                    <label asp-for="RetirementDate"
                                           class="form-label">

                                        Retirement Date

                                    </label>

                                    <input asp-for="RetirementDate"
                                           id="RetirementDate"
                                           type="date"
                                           class="form-control" />

                                </div>


                            </div>


                            <div class="text-end mt-4">

                                <button type="button"
                                        class="btn btn-primary"
                                        onclick="openEmployeeTab('other-tab')">

                                    Next

                                    <i class="bi bi-arrow-right"></i>

                                </button>

                            </div>


                        </div>



                        @* =================================================
                           OTHER INFORMATION
                           ================================================= *@

                        <div class="tab-pane fade"
                             id="other">


                            <div class="row">


                                <div class="col-md-6">


                                    <div class="mb-3">

                                        <label asp-for="PensionFundOpeningBalance"
                                               class="form-label">

                                            Pension Fund Opening Balance

                                        </label>

                                        <input asp-for="PensionFundOpeningBalance"
                                               id="PensionFundOpeningBalance"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="PFNumber"
                                               class="form-label">

                                            P.F. Number

                                        </label>

                                        <input asp-for="PFNumber"
                                               id="PFNumber"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="PFOpeningBalance"
                                               class="form-label">

                                            P.F. Opening Balance

                                        </label>

                                        <input asp-for="PFOpeningBalance"
                                               id="PFOpeningBalance"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="PANNumber"
                                               class="form-label">

                                            PAN Number

                                        </label>

                                        <input asp-for="PANNumber"
                                               id="PANNumber"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="SavingGLCode"
                                               class="form-label">

                                            S/B G/L Code

                                        </label>

                                        <input asp-for="SavingGLCode"
                                               id="SavingGLCode"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="SavingBranchCode"
                                               class="form-label">

                                            S/B Branch Code

                                        </label>

                                        <input asp-for="SavingBranchCode"
                                               id="SavingBranchCode"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="SavingAccountCode"
                                               class="form-label">

                                            S/B Account Code

                                        </label>

                                        <input asp-for="SavingAccountCode"
                                               id="SavingAccountCode"
                                               class="form-control" />

                                    </div>


                                </div>



                                <div class="col-md-6">


                                    <div class="mb-3">

                                        <label asp-for="ITSerialNumber"
                                               class="form-label">

                                            IT Serial Number

                                        </label>

                                        <input asp-for="ITSerialNumber"
                                               id="ITSerialNumber"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="PFSerialNumber"
                                               class="form-label">

                                            P.F. Serial Number

                                        </label>

                                        <input asp-for="PFSerialNumber"
                                               id="PFSerialNumber"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="PFBalance"
                                               class="form-label">

                                            P.F. Balance

                                        </label>

                                        <input asp-for="PFBalance"
                                               id="PFBalance"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="AadhaarNumber"
                                               class="form-label">

                                            Aadhaar Number

                                        </label>

                                        <input asp-for="AadhaarNumber"
                                               id="AadhaarNumber"
                                               class="form-control"
                                               maxlength="12" />

                                    </div>


                                </div>


                            </div>


                            <div class="text-end mt-4">


                                <button type="button"
                                        class="btn btn-secondary me-2"
                                        onclick="openEmployeeTab('general-tab')">

                                    <i class="bi bi-arrow-left"></i>

                                    Previous

                                </button>


                                <button type="button"
                                        class="btn btn-primary"
                                        onclick="openEmployeeTab('address-tab')">

                                    Next

                                    <i class="bi bi-arrow-right"></i>

                                </button>


                            </div>


                        </div>



                        @* =================================================
                           ADDRESS INFORMATION
                           ================================================= *@

                        <div class="tab-pane fade"
                             id="address">


                            <div class="row">


                                <div class="col-md-6">


                                    <div class="mb-3">

                                        <label asp-for="CorrespondenceAddress1"
                                               class="form-label">

                                            Correspondence Address 1

                                        </label>

                                        <input asp-for="CorrespondenceAddress1"
                                               id="CorrespondenceAddress1"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="CorrespondenceAddress2"
                                               class="form-label">

                                            Correspondence Address 2

                                        </label>

                                        <input asp-for="CorrespondenceAddress2"
                                               id="CorrespondenceAddress2"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="PermanentAddress1"
                                               class="form-label">

                                            Permanent Address 1

                                        </label>

                                        <input asp-for="PermanentAddress1"
                                               id="PermanentAddress1"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="PermanentAddress2"
                                               class="form-label">

                                            Permanent Address 2

                                        </label>

                                        <input asp-for="PermanentAddress2"
                                               id="PermanentAddress2"
                                               class="form-control" />

                                    </div>


                                </div>



                                <div class="col-md-6">


                                    <div class="mb-3">

                                        <label asp-for="FatherName"
                                               class="form-label">

                                            Father's Name

                                        </label>

                                        <input asp-for="FatherName"
                                               id="FatherName"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="Address1"
                                               class="form-label">

                                            Address 1

                                        </label>

                                        <input asp-for="Address1"
                                               id="Address1"
                                               class="form-control" />

                                    </div>


                                    <div class="mb-3">

                                        <label asp-for="Address2"
                                               class="form-label">

                                            Address 2

                                        </label>

                                        <input asp-for="Address2"
                                               id="Address2"
                                               class="form-control" />

                                    </div>


                                </div>


                            </div>


                            <div class="text-end mt-4">


                                <button type="button"
                                        class="btn btn-secondary me-2"
                                        onclick="openEmployeeTab('other-tab')">

                                    <i class="bi bi-arrow-left"></i>

                                    Previous

                                </button>


                                <button type="button"
                                        class="btn btn-primary"
                                        onclick="openEmployeeTab('personal-tab')">

                                    Next

                                    <i class="bi bi-arrow-right"></i>

                                </button>


                            </div>


                        </div>



                        @* =================================================
                           PERSONAL INFORMATION
                           ================================================= *@

                        <div class="tab-pane fade"
                             id="personal">


                            <div class="row">


                                <div class="col-md-6">


                                    @* RELIGION *@

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Religion

                                        </label>


                                        <div class="input-group">

                                            <input type="text"
                                                   id="ReligionSearch"
                                                   class="form-control"
                                                   placeholder="Search Religion"
                                                   readonly />


                                            <button type="button"
                                                    class="btn btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#ReligionModal">

                                                <i class="bi bi-search"></i>

                                            </button>

                                        </div>


                                        <input type="hidden"
                                               asp-for="Religion"
                                               id="ReligionId" />

                                    </div>



                                    @* CASTE *@

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Caste

                                        </label>


                                        <div class="input-group">

                                            <input type="text"
                                                   id="CasteSearch"
                                                   class="form-control"
                                                   placeholder="Search Caste"
                                                   readonly />


                                            <button type="button"
                                                    class="btn btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#CasteModal">

                                                <i class="bi bi-search"></i>

                                            </button>

                                        </div>


                                        <input type="hidden"
                                               asp-for="Caste"
                                               id="CasteId" />

                                    </div>



                                    @* GENDER *@

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Gender

                                        </label>


                                        <div>


                                            <div class="form-check form-check-inline">

                                                <input asp-for="Gender"
                                                       class="form-check-input"
                                                       type="radio"
                                                       value="M" />

                                                <label class="form-check-label">

                                                    Male

                                                </label>

                                            </div>


                                            <div class="form-check form-check-inline">

                                                <input asp-for="Gender"
                                                       class="form-check-input"
                                                       type="radio"
                                                       value="F" />

                                                <label class="form-check-label">

                                                    Female

                                                </label>

                                            </div>


                                        </div>

                                    </div>



                                    <div class="mb-3">

                                        <label asp-for="BirthDate"
                                               class="form-label">

                                            Birth Date

                                        </label>

                                        <input asp-for="BirthDate"
                                               id="BirthDate"
                                               type="date"
                                               class="form-control" />

                                    </div>



                                    <div class="mb-3">

                                        <label asp-for="IdentificationMark"
                                               class="form-label">

                                            Identification Mark

                                        </label>

                                        <input asp-for="IdentificationMark"
                                               id="IdentificationMark"
                                               class="form-control" />

                                    </div>



                                    <div class="mb-3">

                                        <label asp-for="KnownLanguage"
                                               class="form-label">

                                            Known Language

                                        </label>

                                        <input asp-for="KnownLanguage"
                                               id="KnownLanguage"
                                               class="form-control" />

                                    </div>



                                    <div class="mb-3">

                                        <label asp-for="Education"
                                               class="form-label">

                                            Education

                                        </label>

                                        <input asp-for="Education"
                                               id="Education"
                                               class="form-control" />

                                    </div>


                                </div>



                                <div class="col-md-6">


