@model Employee_Management_System.Models.LeaveStatementViewModel

@{
    ViewData["Title"] = "Leave Statement";
}

<div class="container-fluid py-3 leave-statement-page">

    <!-- =========================================================
         PAGE TITLE
    ========================================================== -->
    <div class="mb-3 no-print">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-text me-2"></i>
            Leave Statement
        </h2>

        <div class="text-muted">
            View employee leave credit, debit and balance details
        </div>
    </div>


    <!-- =========================================================
         ERROR MESSAGE
    ========================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger no-print">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @Model.ErrorMessage
        </div>
    }


    <!-- =========================================================
         IF SEARCH NOT DONE
         SHOW SEARCH CRITERIA FIRST
    ========================================================== -->
    @if (!Model.IsSearched ||
        !string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <!-- SEARCH CARD -->
        <div class="card shadow-sm mb-3 no-print">

            <div class="card-header bg-light">
                <strong class="text-primary">
                    <i class="bi bi-search me-2"></i>
                    Search Criteria
                </strong>
            </div>

            <div class="card-body">

                <form asp-controller="LeaveStatement"
                      asp-action="Search"
                      method="get">

                    <div class="row g-3">

                        <!-- YEAR -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Year
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Year"
                                   type="number"
                                   class="form-control"
                                   min="2000"
                                   max="2100" />

                        </div>


                        <!-- EMPLOYEE CODE -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Employee Code
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="EmployeeCode"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter Employee Code" />

                        </div>


                        <!-- SANCTION FROM -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Sanction From
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="SanctionFrom"
                                   type="date"
                                   class="form-control" />

                        </div>


                        <!-- SANCTION TO -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Sanction To
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="SanctionTo"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>


                    <!-- SEARCH / CLEAR -->
                    <div class="mt-3 text-end">

                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                        <a asp-controller="LeaveStatement"
                           asp-action="Index"
                           class="btn btn-secondary px-4">

                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Clear

                        </a>

                    </div>

                </form>

            </div>

        </div>
    }


    <!-- =========================================================
         SEARCH RESULT
    ========================================================== -->
    @if (Model.IsSearched &&
        string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {

        <div class="print-only print-report-header">
            <div class="print-system-name">Employee_Management_System</div>
            <div class="print-report-title">LEAVE STATEMENT</div>
            <div class="print-date-time" id="printDateTime"></div>
        </div>


        <!-- =====================================================
             EMPLOYEE DETAILS
        ====================================================== -->
        <div class="card shadow-sm mb-3 print-employee-details">

            <div class="card-header bg-light">

                <strong class="text-primary">

                    <i class="bi bi-person-fill me-2"></i>

                    Employee Details

                </strong>

            </div>


            <div class="card-body">

                <div class="mb-2">
                    Employee Code :
                    <strong>@Model.EmployeeCode</strong>
                </div>

                <div class="row mb-2">

                    <div class="col-md-7">
                        Employee Name :
                        <strong>@Model.EmployeeName</strong>
                    </div>

                    <!-- Joining Date: PRINT / PRINT PREVIEW ONLY -->
                    <div class="col-md-5 print-only">
                        Joining Date :
                        <strong>
                            @(Model.JoiningDate.HasValue
                                                    ? Model.JoiningDate.Value.ToString("dd-MM-yyyy")
                                                    : "-")
                                                      </strong>
                                                  </div>

                </div>

                <!-- Year is intentionally not displayed in Employee Details -->

                <div>
                    Period :
                    <strong>
                        @(Model.SanctionFrom.HasValue
                                            ? Model.SanctionFrom.Value.ToString("dd-MM-yyyy")
                                            : "-")
                                                  to
                        @(Model.SanctionTo.HasValue
                                            ? Model.SanctionTo.Value.ToString("dd-MM-yyyy")
                                            : "-")
                </strong>
            </div>

            </div>

        </div>


        <!-- =====================================================
             OVERALL LEAVE SUMMARY
        ====================================================== -->
        <div class="row g-3 mb-3 no-print">

            <!-- TOTAL CREDIT -->
            <div class="col-md-4">

                <div class="card border-success h-100 shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="text-success">
                            Total Leave Credit
                        </h5>

                        <h2 class="fw-bold text-success">
                            @Model.TotalCredit.ToString("0.##")
                        </h2>

                        <span>
                            Day(s)
                        </span>

                    </div>

                </div>

            </div>


            <!-- TOTAL DEBIT -->
            <div class="col-md-4">

                <div class="card border-danger h-100 shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="text-danger">
                            Total Leave Debit
                        </h5>

                        <h2 class="fw-bold text-danger">
                            @Model.TotalDebit.ToString("0.##")
                        </h2>

                        <span>
                            Day(s)
                        </span>

                    </div>

                </div>

            </div>


            <!-- OVERALL BALANCE -->
            <div class="col-md-4">

                <div class="card border-primary h-100 shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="text-primary">
                            Leave Balance
                        </h5>

                        <h2 class="fw-bold text-primary">
                            @Model.LeaveBalance.ToString("0.##")
                        </h2>

                        <span>
                            Day(s)
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SEARCH CRITERIA
             AFTER EMPLOYEE DETAILS + SUMMARY
        ====================================================== -->
        <div class="card shadow-sm mb-3 no-print">

            <div class="card-header bg-light">

                <strong class="text-primary">

                    <i class="bi bi-search me-2"></i>

                    Search Criteria

                </strong>

            </div>


            <div class="card-body">

                <form asp-controller="LeaveStatement"
                      asp-action="Search"
                      method="get">

                    <div class="row g-3">

                        <!-- YEAR -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Year
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Year"
                                   type="number"
                                   class="form-control"
                                   min="2000"
                                   max="2100" />

                        </div>


                        <!-- EMPLOYEE CODE -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Employee Code
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="EmployeeCode"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter Employee Code" />

                        </div>


                        <!-- SANCTION FROM -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Sanction From
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="SanctionFrom"
                                   type="date"
                                   class="form-control" />

                        </div>


                        <!-- SANCTION TO -->
                        <div class="col-lg-3 col-md-6">

                            <label class="form-label">
                                Sanction To
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="SanctionTo"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>


                    <!-- SEARCH / CLEAR -->
                    <div class="mt-3 text-end">

                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="bi bi-search me-1"></i>
                            Search

                        </button>

                        <a asp-controller="LeaveStatement"
                           asp-action="Index"
                           class="btn btn-secondary px-4">

                            <i class="bi bi-arrow-clockwise me-1"></i>
                            Clear

                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- PRINT BUTTON -->
        <div class="text-end mb-3 no-print">
            <button type="button"
                    class="btn btn-success px-4"
                    onclick="window.print();">
                <i class="bi bi-printer me-1"></i>
                Print
            </button>
        </div>


        <!-- =====================================================
             LEAVE TRANSACTION DETAILS
        ====================================================== -->
        <div class="card shadow-sm print-transaction-details">

            <div class="card-header bg-light d-flex
                                    justify-content-between
                                    align-items-center">

                <strong class="text-primary">

                    <i class="bi bi-list-ul me-2"></i>

                    Leave Transaction Details

                </strong>


                <span>

                    Total Records:

                    <strong>
                        @(Model.Transactions?.Count ?? 0)
                    </strong>

                </span>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table
                                              table-bordered
                                              table-hover
                                              align-middle
                                              mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>Sr.</th>

                                <th>From Date</th>

                                <th>To Date</th>

                                <th>Days</th>

                                <th>Credit</th>

                                <th>Debit</th>

                                <th>Balance</th>

                                <th>Operator</th>

                            </tr>

                        </thead>


                        <tbody>

                        @if (Model.Transactions != null &&
                                                Model.Transactions.Any())
                            {
                                int srNo = 1;


                                <!-- ==================================
                                     OPENING LEAVE BALANCE
                                =================================== -->
                                <tr class="table-warning fw-bold">

                                    <td colspan="6"
                                        class="text-end">

                                        Opening Leave Balance

                                    </td>

                                    <td class="text-primary">

                                        @Model.OpeningBalance.ToString("0.##")

                                    </td>

                                    <td>
                                        -
                                    </td>

                                </tr>


                                foreach (var item in Model.Transactions)
                                {
                                    string fromDate =
                                    item.SanctionFrom
                                    .ToString("dd-MM-yyyy");

                                    string toDate =
                                    item.SanctionTo.HasValue
                                    ? item.SanctionTo.Value
                                    .ToString("dd-MM-yyyy")
                                    : "-";

                                    string days =
                                    item.NumberOfDays.HasValue
                                    ? item.NumberOfDays.Value
                                    .ToString("0.##")
                                    : "0";

                                    string credit =
                                    item.CreditDays
                                    .ToString("0.##");

                                    string debit =
                                    item.DebitDays
                                    .ToString("0.##");

                                    string balance =
                                    item.BalanceDays
                                    .ToString("0.##");


                                    <tr>

                                        <!-- SR -->
                                        <td>
                                            @srNo
                                        </td>


                                        <!-- FROM DATE -->
                                        <td>
                                            @fromDate
                                        </td>


                                        <!-- TO DATE -->
                                        <td>
                                            @toDate
                                        </td>


                                        <!-- DAYS -->
                                        <td>
                                            @days
                                        </td>


                                        <!-- CREDIT -->
                                        <td class="text-success fw-bold">
                                            @credit
                                        </td>


                                        <!-- DEBIT -->
                                        <td class="text-danger fw-bold">
                                            @debit
                                        </td>


                                        <!-- CLOSING BALANCE -->
                                        <td class="text-primary fw-bold">
                                            @balance
                                        </td>


                                        <!-- OPERATOR -->
                                        <td>

                                            @(string.IsNullOrWhiteSpace(item.Operator)
                                                                            ? "-"
                                                                            : item.Operator)

                            </td>

                                    </tr>

                                                srNo++;
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="8"
                                        class="text-center
                                                                       text-muted
                                                                       py-4">

                                        <i class="bi bi-info-circle me-2"></i>

                                        No leave transactions found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>


<style>
    /* =========================================================
               A4 PRINT FORMAT
               Print only Employee Details + Leave Transaction Details
            ========================================================== */

    .print-only {
        display: none;
    }

    @@media print {

        @@page {
            size: A4 portrait;
            margin: 0;
        }

        html,
        body {
            width: 210mm;
            min-height: 297mm;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff !important;
            font-size: 11pt;
        }
        /* Hide normal layout/UI */
        header,
        footer,
        nav,
        aside,
        .navbar,
        .sidebar,
        .no-print {
            display: none !important;
        }
        /* Hide everything first */
        body * {
            visibility: hidden;
        }
        /* Show only the leave statement page */
        .leave-statement-page,
        .leave-statement-page * {
            visibility: visible;
        }

        .leave-statement-page {
            position: absolute;
            left: 0;
            top: 0;
            width: 210mm !important;
            max-width: 210mm !important;
            min-height: 297mm !important;
            box-sizing: border-box !important;
            margin: 0 !important;
            padding: 10mm !important;
        }
            /* Any no-print content inside page remains hidden */
            .leave-statement-page .no-print,
            .leave-statement-page .no-print * {
                display: none !important;
                visibility: hidden !important;
            }

        .print-only {
            display: block !important;
            visibility: visible !important;
        }

        .print-report-header {
            position: relative;
            margin: 0 0 5mm 0;
            min-height: 20mm;
        }

        .print-system-name {
            text-align: center;
            font-size: 20pt;
            font-weight: 700;
            line-height: 1.2;
        }

        .print-report-title {
            text-align: center;
            font-size: 14pt;
            font-weight: 700;
            margin-top: 2mm;
        }

        .print-date-time {
            position: absolute;
            right: 0;
            bottom: 0;
            font-size: 8.5pt;
            font-weight: 400;
            white-space: nowrap;
        }

        .print-employee-details,
        .print-transaction-details {
            display: block !important;
            visibility: visible !important;
            box-shadow: none !important;
            border: 1px solid #555 !important;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .print-employee-details {
            margin-bottom: 7mm !important;
        }

        .print-transaction-details {
            margin-bottom: 0 !important;
        }

        .card-header {
            background: #f2f2f2 !important;
            color: #000 !important;
            border-bottom: 1px solid #555 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

            .card-header strong,
            .card-header .text-primary {
                color: #000 !important;
            }

        .card-body {
            padding: 4mm !important;
        }

        .print-transaction-details .card-body {
            padding: 0 !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 9.5pt;
        }

        th,
        td {
            border: 1px solid #555 !important;
            padding: 2.2mm 1.5mm !important;
            vertical-align: middle !important;
        }

        thead {
            display: table-header-group;
        }

        tr {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .table-warning,
        .table-warning > td {
            background: #fff4cc !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .text-success,
        .text-danger,
        .text-primary {
            color: #000 !important;
        }

        a[href]:after {
            content: none !important;
        }
    }
</style>


<script>
    function setPrintDateTime() {
        const now = new Date();

        const day = String(now.getDate()).padStart(2, '0');
        const month = String(now.getMonth() + 1).padStart(2, '0');
        const year = now.getFullYear();

        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');

        const element = document.getElementById('printDateTime');

        if (element) {
            element.textContent =
                day + '-' + month + '-' + year + '   ' +
                hours + ':' + minutes;
        }
    }

    window.addEventListener('beforeprint', setPrintDateTime);
    document.addEventListener('DOMContentLoaded', setPrintDateTime);
</script>

