@model List<Employee_Management_System.Models.LeaveSanctionListViewModel>

@{
    ViewData["Title"] = "Leave Sanction";
}


<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <h3 class="mb-1">

                <i class="bi bi-check2-square me-2"></i>

                Leave Sanction

            </h3>

            <small class="text-muted">
                Employee Leave Request List
            </small>

        </div>


        <a asp-controller="Leave"
           asp-action="Index"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>

            New Leave

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <div class="card shadow-sm">

        <div class="card-header">

            <strong>

                <i class="bi bi-list-ul me-1"></i>

                Leave Requests

            </strong>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle text-nowrap">

                    <thead class="table-light">

                        <tr>

                            <th>Leave App ID</th>

                            <th>Employee Code</th>

                            <th>Employee Name</th>

                            <th>C/D Code</th>

                            <th>Demand From</th>

                            <th>Demand To</th>

                            <th>Demand Leave</th>

                            <th>Previous Days</th>

                            <th>Reason Code</th>

                            <th>Reason Remark</th>

                            <th>Charge To</th>

                            <th>Sanction From</th>

                            <th>Sanction To</th>

                            <th>Sanction Leave</th>

                            <th>Sanction Officer</th>

                            <th>Effect Pay Date</th>

                            <th>Operator</th>

                            <th>Status</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null &&
                                                Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.LeaveApplicationId
                                    </td>


                                    <td>
                                        @item.EmployeeCode
                                    </td>


                                    <td>
                                        @item.EmployeeName
                                    </td>


                                    <td>
                                        @item.CDCode
                                    </td>


                                    <td>
                                        @(item.DemandFromDate?.ToString("dd-MM-yyyy"))
                                    </td>


                                    <td>
                                        @(item.DemandToDate?.ToString("dd-MM-yyyy"))
                                    </td>


                                    <td>
                                        @item.DemandLeaveCode
                                        -
                                        @item.DemandLeaveName
                                    </td>


                                    <td>
                                        @item.PreviousDays
                                    </td>


                                    <td>
                                        @item.ReasonCode
                                    </td>


                                    <td>
                                        @item.ReasonRemark
                                    </td>


                                    <td>
                                        @item.ChargeTo
                                    </td>


                                    <td>
                                        @(item.SanctionFromDate?.ToString("dd-MM-yyyy"))
                                    </td>


                                    <td>
                                        @(item.SanctionToDate?.ToString("dd-MM-yyyy"))
                                    </td>


                                    <td>
                                        @item.SanctionLeaveCode
                                        -
                                        @item.SanctionLeaveName
                                    </td>


                                    <td>
                                        @item.SanctionOfficer
                                    </td>


                                    <td>
                                        @(item.EffectPayDate?.ToString("dd-MM-yyyy"))
                                    </td>


                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Operator)
                                                                        ? "NULL"
                                                                        : item.Operator)
                            </td>


                                    <!-- STATUS -->

                                    <td>

                                @if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <!-- VIEW -->

                                    <td>

                                        <a asp-controller="Leave"
                                           asp-action="ViewLeave"
                                           asp-route-id="@item.LeaveApplicationId"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-eye me-1"></i>

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="19"
                                    class="text-center text-muted py-4">

                                    No leave requests found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>