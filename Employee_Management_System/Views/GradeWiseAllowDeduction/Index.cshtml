@model Employee_Management_System.Models.GradeWiseAllowDeductionViewModel

@{
    var selectedSection =
        (ViewBag.SelectedSection as string ?? "allowance")
            .ToLowerInvariant();

    ViewData["Title"] =
        selectedSection == "deduction"
            ? "Grade Wise Deduction"
            : "Grade Wise Allowance";
}

<div class="container mt-4 mb-5">

    <div class="card shadow">

        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="card-header bg-primary text-white text-center">

            <h3 class="mb-0">
                <i class="bi bi-diagram-3 me-2"></i>
                @(selectedSection == "deduction"
                                ? "Grade Wise Deduction"
                                : "Grade Wise Allowance")
            </h3>

        </div>


        <div class="card-body">


            <!-- =====================================================
                 SUCCESS / ERROR MESSAGE
            ====================================================== -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    <strong>
                        @TempData["Success"]
                    </strong>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }


            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    <strong>
                        @TempData["Error"]
                    </strong>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }



            <!-- =====================================================
                 ALLOWANCE TREE LIST
                 dbo.allwmast

                 Selected allowance detail is displayed
                 immediately BELOW that allowance row.
            ====================================================== -->

            <div id="gradeWiseAllowanceSection"
                 class="card shadow-sm"
                 style="@(selectedSection == "allowance" ? "" : "display:none;")">

                <div class="card-header bg-success text-white">

                    <h5 class="mb-0">
                        <i class="bi bi-cash-stack me-2"></i>
                        Allowance List
                    </h5>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle mb-0">

                            <thead class="table-success">

                                <tr>

                                    <th style="width:110px;">
                                        Code
                                    </th>

                                    <th>
                                        Name
                                    </th>

                                    <th class="text-center"
                                        style="width:170px;">
                                        Selected / Total Grades
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model.Allowances != null &&
                                                                Model.Allowances.Any())
                                {
                                    foreach (var item in Model.Allowances)
                                    {
                                        bool isSelected =
                                        Model.SelectedAllowanceCode.HasValue &&
                                        Model.SelectedAllowanceCode.Value == item.Code;


                                        int allowanceAppliedCount =
                                        Model.AllowanceSelectedGradeCounts != null &&
                                        Model.AllowanceSelectedGradeCounts.ContainsKey(item.Code)
                                        ? Model.AllowanceSelectedGradeCounts[item.Code]
                                        : 0;


                                        <!-- =========================================
                                             PARENT ALLOWANCE ROW
                                        ========================================== -->
                                        var allowanceToggleUrl =
                                        isSelected
                                        ? Url.Action(
                                        "Index",
                                        "GradeWiseAllowDeduction",
                                        new
                                        {
                                            section = "allowance"
                                        })
                                        : Url.Action(
                                        "Index",
                                        "GradeWiseAllowDeduction",
                                        new
                                        {
                                            allowanceCode = item.Code,
                                            section = "allowance"
                                        });


                                        <tr class="@(isSelected ? "table-warning fw-bold" : "")"
                                            style="cursor:pointer;"
                                            onclick="window.location.href='@allowanceToggleUrl'">


                                            <!-- CODE -->

                                            <td>

                                                @if (isSelected)
                                                {
                                                    <i class="bi bi-caret-down-fill text-success me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-caret-right-fill text-secondary me-2"></i>
                                                }

                                                @item.Code

                                            </td>


                                            <!-- NAME -->

                                            <td>
                                                @item.Name
                                            </td>

                                            <td class="text-center">

                                                <span class="badge bg-primary allowance-count-badge"
                                                      data-allowance-code="@item.Code">
                                                    @allowanceAppliedCount / @(Model.Grades?.Count ?? 0)
                                                </span>

                                            </td>

                                        </tr>


                                        <!-- =========================================
                                             CHILD ROW
                                             Selected Allowance Details
                                        ========================================== -->
                                        @if (isSelected)
                                        {
                                            <tr>

                                                <td colspan="3"
                                                    class="p-0 bg-light">

                                                    <div class="p-3 ps-md-5">

                                                        <div class="card border-primary shadow-sm mb-0">


                                                            <!-- =============================
                                                                 CHILD HEADER
                                                            ============================== -->

                                                            <div class="card-header bg-primary text-white">

                                                                <div class="d-flex justify-content-between
                                                                                                                                                                                                                                                                                                                align-items-center
                                                                                                                                                                                                                                                                                                                flex-wrap gap-2">

                                                                    <h6 class="mb-0">

                                                                        <i class="bi bi-arrow-return-right me-2"></i>

                                                                        Grade Details for :

                                                                        [ @Model.SelectedAllowanceCode ]

                                                                        -

                                                                        @Model.SelectedAllowanceName

                                                                    </h6>

                                                                    <span class="badge bg-light text-primary border allowance-selected-summary"
                                                                          data-allowance-code="@Model.SelectedAllowanceCode">
                                                                        Selected Grades : @Model.AllowanceDetails.Count(x => x.IsSelected) / @(Model.Grades?.Count ?? 0)
                                                                    </span>




                                                                </div>

                                                            </div>



                                                            <!-- =============================
                                                                 CHILD BODY
                                                            ============================== -->

                                                            <div class="card-body">


                                                                @if (Model.AllowanceDetails != null &&
                                                                                                                    Model.AllowanceDetails.Any())
                                                                {
                                                                    <div class="table-responsive">

                                                                        <table class="table
                                                                                                                                                                                                                                                                                                                                                                                                      table-bordered
                                                                                                                                                                                                                                                                                                                                                                                                      table-striped
                                                                                                                                                                                                                                                                                                                                                                                                      table-hover
                                                                                                                                                                                                                                                                                                                                                                                                      align-middle
                                                                                                                                                                                                                                                                                                                                                                                                      mb-0">

                                                                            <thead class="table-primary">

                                                                                <tr>

                                                                                    <th class="text-center"
                                                                                        style="width:95px;">

                                                                                        <div class="d-flex flex-column align-items-center justify-content-center">

                                                                                            <label for="selectAllGrades"
                                                                                                   class="mb-1 fw-bold"
                                                                                                   style="cursor:pointer;">
                                                                                                Select All
                                                                                            </label>

                                                                                            <input type="checkbox"
                                                                                                   id="selectAllGrades"
                                                                                                   class="form-check-input"
                                                                                                   title="Select / Unselect All Grades" />

                                                                                        </div>

                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Code
                                                                                    </th>

                                                                                    <th>
                                                                                        Name
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Fix Amount
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Calc Code
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Percentage
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Min Limit
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Max Limit
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Min Days
                                                                                    </th>

                                                                                    <th class="text-center"
                                                                                        style="min-width:120px;">
                                                                                        Action
                                                                                    </th>

                                                                                </tr>

                                                                            </thead>


                                                                            <tbody>

                                                                                @foreach (var detail in Model.AllowanceDetails)
                                                                                {
                                                                                    <tr>

                                                                                        <!-- SELECT / APPLY CHECKBOX -->

                                                                                        <td class="text-center">

                                                                                            <input type="checkbox"
                                                                                                   class="form-check-input grade-apply-checkbox"
                                                                                                   value="@detail.Code"
                                                                                                   id="gradeApply_@Model.SelectedAllowanceCode@("_")@detail.Code"
                                                                                                   data-allowance-code="@Model.SelectedAllowanceCode"
                                                                                                   data-allowance-name="@Model.SelectedAllowanceName"
                                                                                                   data-grade-code="@detail.Code"
                                                                                                   data-grade-name="@detail.Name"
                                                                                                   data-db-selected="@(detail.IsSelected ? "true" : "false")"
                                                                                                   checked="@detail.IsSelected"
                                                                                                   title="Selected = Apply 1, Unselected = Apply 0" />

                                                                                        </td>


                                                                                        <td class="text-center">
                                                                                            @detail.Code
                                                                                        </td>

                                                                                        <td>
                                                                                            @detail.Name
                                                                                        </td>

                                                                                        <td class="text-center">
                                                                                            @(detail.FixAmount.HasValue
                                                                                                                                                                    ? detail.FixAmount.Value.ToString("0.00")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>

                                                                                        <td class="text-center">
                                                                                            @(detail.CalcCode.HasValue
                                                                                                                                                                    ? detail.CalcCode.Value.ToString("0")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>

                                                                                        <td class="text-center">
                                                                                            @(detail.Percent.HasValue
                                                                                                                                                                    ? detail.Percent.Value.ToString("0.00")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>

                                                                                        <td class="text-center">
                                                                                            @(detail.MinLimit.HasValue
                                                                                                                                                                    ? detail.MinLimit.Value.ToString("0")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>

                                                                                        <td class="text-center">
                                                                                            @(detail.MaxLimit.HasValue
                                                                                                                                                                    ? detail.MaxLimit.Value.ToString("0")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>

                                                                                        <td class="text-center">
                                                                                            @(detail.MinDays.HasValue
                                                                                                                                                                    ? detail.MinDays.Value.ToString("0")
                                                                                                                                                                    : "")
                                                                    </td>


                                                                                        <!-- =================
                                                                                             ACTION
                                                                                        ================== -->

                                                                                        <td class="text-center">


                                                                                            <!-- INSERT -->
                                                                                            <!-- UPDATE -->

                                                                                            <button type="button"
                                                                                                    class="btn btn-primary btn-sm btnUpdateAllowance btnEditAllowance @(detail.IsSelected ? "" : "d-none")"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#updateAllowanceModal"
                                                                                                    data-code="@detail.Code"
                                                                                                    data-name="@detail.Name"
                                                                                                    data-paydiv="@(detail.IsSelected? detail.PayDiv.ToString() : "")"
                                                                                                    data-fix="@detail.FixAmount"
                                                                                                    data-calc="@detail.CalcCode"
                                                                                                    data-percent="@detail.Percent"
                                                                                                    data-min="@detail.MinLimit"
                                                                                                    data-max="@detail.MaxLimit"
                                                                                                    data-days="@detail.MinDays"
                                                                                                    data-formula="@detail.Formula">

                                                                                                <i class="bi bi-pencil-square"></i>
                                                                                                Edit

                                                                                            </button>


                                                                                        </td>

                                                                                    </tr>
                                                                                                                                }

                                                                            </tbody>

                                                                        </table>

                                                                    </div>


                                                                    <div class="mt-2">

                                                                        <strong>
                                                                            Total Records :
                                                                        </strong>

                                                                        @Model.AllowanceDetails.Count

                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="alert alert-warning mb-0">

                                                                        <i class="bi bi-exclamation-triangle me-2"></i>

                                                                        No allowance details found for

                                                                        <strong>
                                                                            @Model.SelectedAllowanceName
                                                                        </strong>.




                                                                    </div>
                                                                }

                                                            </div>

                                                        </div>

                                                    </div>

                                                </td>

                                            </tr>
                                        }
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="3"
                                            class="text-center text-muted p-4">

                                            No Allowance records found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
            <!-- =====================================================
                 DEDUCTION TREE LIST
                 dbo.dedumast

                 Selected deduction detail is displayed
                 immediately BELOW that deduction row.
            ====================================================== -->

            <div id="gradeWiseDeductionSection"
                 class="card shadow-sm mt-4"
                 style="@(selectedSection == "deduction" ? "" : "display:none;")">

                <div class="card-header bg-danger text-white">

                    <h5 class="mb-0">

                        <i class="bi bi-dash-circle me-2"></i>

                        Deduction List

                    </h5>

                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-bordered table-hover align-middle mb-0">

                            <thead class="table-danger">

                                <tr>

                                    <th style="width:110px;">
                                        Code
                                    </th>

                                    <th>
                                        Name
                                    </th>

                                    <th class="text-center"
                                        style="width:170px;">
                                        Selected / Total Grades
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (Model.Deductions != null &&
                                                                Model.Deductions.Any())
                                {
                                    foreach (var item in Model.Deductions)
                                    {
                                        bool isSelectedDeduction =
                                        Model.SelectedDeductionCode.HasValue &&
                                        Model.SelectedDeductionCode.Value == item.Code;

                                        int deductionAppliedCount =
                                        Model.DeductionSelectedGradeCounts != null &&
                                        Model.DeductionSelectedGradeCounts.ContainsKey(item.Code)
                                        ? Model.DeductionSelectedGradeCounts[item.Code]
                                        : 0;


                                        var deductionToggleUrl =
                                        isSelectedDeduction
                                        ? Url.Action(
                                        "Index",
                                        "GradeWiseAllowDeduction",
                                        new
                                        {
                                            section = "deduction"
                                        })
                                        : Url.Action(
                                        "Index",
                                        "GradeWiseAllowDeduction",
                                        new
                                        {
                                            deductionCode = item.Code,
                                            section = "deduction"
                                        });


                                        <!-- =========================================
                                             PARENT DEDUCTION ROW
                                        ========================================== -->

                                        <tr class="@(isSelectedDeduction ? "table-warning fw-bold" : "")"
                                            style="cursor:pointer;"
                                            onclick="window.location.href='@deductionToggleUrl'">

                                            <td>

                                                @if (isSelectedDeduction)
                                                {
                                                    <i class="bi bi-caret-down-fill text-danger me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-caret-right-fill text-secondary me-2"></i>
                                                }

                                                @item.Code

                                            </td>

                                            <td>
                                                @item.Name
                                            </td>

                                            <td class="text-center">

                                                <span class="badge bg-danger deduction-count-badge"
                                                      data-deduction-code="@item.Code"
                                                      data-db-count="@deductionAppliedCount">
                                                    @deductionAppliedCount / @(Model.Grades?.Count ?? 0)
                                                </span>

                                            </td>

                                        </tr>


                                        <!-- =========================================
                                             CHILD DEDUCTION GRADE DETAILS
                                        ========================================== -->
                                        @if (isSelectedDeduction)
                                        {
                                            <tr>

                                                <td colspan="3"
                                                    class="p-0 bg-light">

                                                    <div class="p-3 ps-md-5">

                                                        <div class="card border-danger shadow-sm mb-0">


                                                            <!-- CHILD HEADER -->

                                                            <div class="card-header bg-danger text-white">

                                                                <div class="d-flex justify-content-between
                                                                                                                                                                                                                                                                                                    align-items-center
                                                                                                                                                                                                                                                                                                    flex-wrap gap-2">

                                                                    <h6 class="mb-0">

                                                                        <i class="bi bi-arrow-return-right me-2"></i>

                                                                        Deduction Grade Details for :

                                                                        [ @Model.SelectedDeductionCode ]

                                                                        -

                                                                        @Model.SelectedDeductionName

                                                                    </h6>

                                                                    <span class="badge bg-light text-danger border deduction-selected-summary"
                                                                          data-deduction-code="@Model.SelectedDeductionCode"
                                                                          data-db-count="@Model.DeductionDetails.Count(x => x.IsSelected)">
                                                                        Selected Grades : @Model.DeductionDetails.Count(x => x.IsSelected) / @(Model.Grades?.Count ?? 0)
                                                                    </span>




                                                                </div>

                                                            </div>


                                                            <!-- CHILD BODY -->

                                                            <div class="card-body">


                                                                @if (Model.DeductionDetails != null &&
                                                                                                                    Model.DeductionDetails.Any())
                                                                {
                                                                    <div class="table-responsive">

                                                                        <table class="table
                                                                                                                                                                                                                                                                                                                                                                                      table-bordered
                                                                                                                                                                                                                                                                                                                                                                                      table-striped
                                                                                                                                                                                                                                                                                                                                                                                      table-hover
                                                                                                                                                                                                                                                                                                                                                                                      align-middle
                                                                                                                                                                                                                                                                                                                                                                                      mb-0">

                                                                            <thead class="table-danger">

                                                                                <tr>

                                                                                    <th class="text-center"
                                                                                        style="width:95px;">

                                                                                        <div class="d-flex flex-column align-items-center justify-content-center">

                                                                                            <label for="selectAllDeductionGrades"
                                                                                                   class="mb-1 fw-bold"
                                                                                                   style="cursor:pointer;">
                                                                                                Select All
                                                                                            </label>

                                                                                            <input type="checkbox"
                                                                                                   id="selectAllDeductionGrades"
                                                                                                   class="form-check-input"
                                                                                                   title="Select / Unselect All Deduction Grades" />

                                                                                        </div>

                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Code
                                                                                    </th>

                                                                                    <th>
                                                                                        Name
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Fix Amount
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Calc Code
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Percentage
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Min Limit
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Max Limit
                                                                                    </th>

                                                                                    <th class="text-center">
                                                                                        Min Days
                                                                                    </th>

                                                                                    <th class="text-center"
                                                                                        style="min-width:120px;">
                                                                                        Action
                                                                                    </th>

                                                                                </tr>

                                                                            </thead>


                                                                            <tbody>

                                                                                @foreach (var detail in Model.DeductionDetails)
                                                                                {
                                                                                    <tr>

                                                                                        <!-- SELECT -->

                                                                                        <td class="text-center">

                                                                                            <input type="checkbox"
                                                                                                   class="form-check-input deduction-grade-apply-checkbox"
                                                                                                   value="@detail.Code"
                                                                                                   id="deductionGradeApply_@Model.SelectedDeductionCode@("_")@detail.Code"
                                                                                                   data-deduction-code="@Model.SelectedDeductionCode"
                                                                                                   data-deduction-name="@Model.SelectedDeductionName"
                                                                                                   data-grade-code="@detail.Code"
                                                                                                   data-grade-name="@detail.Name"
                                                                                                   data-db-selected="@(detail.IsSelected ? "true" : "false")"
                                                                                                   checked="@detail.IsSelected"
                                                                                                   title="Selected = Apply 1, Unselected = Apply 0" />

                                                                                        </td>


                                                                                        <!-- CODE FROM dbo.gradmast -->

                                                                                        <td class="text-center">
                                                                                            @detail.Code
                                                                                        </td>


                                                                                        <!-- NAME FROM dbo.gradmast -->

                                                                                        <td>
                                                                                            @detail.Name
                                                                                        </td>


                                                                                        <td class="text-center">
                                                                                            @(detail.FixAmount.HasValue
                                                                                                                                                                    ? detail.FixAmount.Value.ToString("0.00")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>


                                                                                        <td class="text-center">
                                                                                            @(detail.CalcCode.HasValue
                                                                                                                                                                    ? detail.CalcCode.Value.ToString()
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>


                                                                                        <td class="text-center">
                                                                                            @(detail.Percent.HasValue
                                                                                                                                                                    ? detail.Percent.Value.ToString("0.00")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>


                                                                                        <td class="text-center">
                                                                                            @(detail.MinLimit.HasValue
                                                                                                                                                                    ? detail.MinLimit.Value.ToString("0.00")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>


                                                                                        <td class="text-center">
                                                                                            @(detail.MaxLimit.HasValue
                                                                                                                                                                    ? detail.MaxLimit.Value.ToString("0.00")
                                                                                                                                                                    : "")
                                                                                                                                                                     </td>


                                                                                        <td class="text-center">
                                                                                            @(detail.MinDays.HasValue
                                                                                                                                                                    ? detail.MinDays.Value.ToString()
                                                                                                                                                                    : "")
                                                                    </td>


                                                                                        <!-- ACTION -->

                                                                                        <td class="text-center">


                                                                                            <!-- INSERT -->
                                                                                            <!-- UPDATE -->

                                                                                            <button type="button"
                                                                                                    class="btn btn-primary btn-sm btnUpdateDeduction btnEditDeduction @(detail.IsSelected ? "" : "d-none")"
                                                                                                    data-bs-toggle="modal"
                                                                                                    data-bs-target="#updateDeductionModal"
                                                                                                    data-code="@detail.Code"
                                                                                                    data-name="@detail.Name"
                                                                                                    data-fix="@detail.FixAmount"
                                                                                                    data-calc="@detail.CalcCode"
                                                                                                    data-percent="@detail.Percent"
                                                                                                    data-min="@detail.MinLimit"
                                                                                                    data-max="@detail.MaxLimit"
                                                                                                    data-days="@detail.MinDays"
                                                                                                    data-formula="@((ViewBag.DeductionFormulas as Dictionary<int, string>)?.GetValueOrDefault(detail.Code) ?? "")">

                                                                                                <i class="bi bi-pencil-square"></i>
                                                                                                Edit

                                                                                            </button>


                                                                                        </td>

                                                                                    </tr>
                                                                                                                                }

                                                                            </tbody>

                                                                        </table>

                                                                    </div>


                                                                    <div class="mt-2">

                                                                        <strong>
                                                                            Total Records :
                                                                        </strong>

                                                                        @Model.DeductionDetails.Count

                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="alert alert-warning mb-0">

                                                                        <i class="bi bi-exclamation-triangle me-2"></i>

                                                                        No deduction details found for

                                                                        <strong>
                                                                            @Model.SelectedDeductionName
                                                                        </strong>.




                                                                    </div>
                                                                }

                                                            </div>

                                                        </div>

                                                    </div>

                                                </td>

                                            </tr>
                                        }
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="3"
                                            class="text-center text-muted p-4">

                                            No Deduction records found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 INSERT / UPDATE DEDUCTION DETAIL MODALS
            ================================================== -->
            @if (Model.SelectedDeductionCode.HasValue)
            {
                <!-- INSERT DEDUCTION MODAL -->

                <div class="modal fade"
                     id="insertDeductionModal"
                     tabindex="-1"
                     aria-hidden="true">

                    <div class="modal-dialog modal-lg">

                        <div class="modal-content">

                            <form asp-controller="GradeWiseAllowDeduction"
                                  asp-action="InsertDeductionDetail"
                                  method="post">

                                @Html.AntiForgeryToken()


                                <div class="modal-header bg-danger text-white">

                                    <h5 class="modal-title">

                                        <i class="bi bi-plus-circle me-2"></i>

                                        Insert Deduction Detail

                                    </h5>


                                    <button type="button"
                                            class="btn-close btn-close-white"
                                            data-bs-dismiss="modal">
                                    </button>

                                </div>


                                <div class="modal-body">


                                    <input type="hidden"
                                           name="deductionCode"
                                           value="@Model.SelectedDeductionCode" />

                                    <input type="hidden"
