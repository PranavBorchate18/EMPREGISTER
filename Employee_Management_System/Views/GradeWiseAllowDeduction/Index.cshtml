                                                    this.dataset.paydiv || "";


                                                document.getElementById(
                                                    "UpdateFixAmount"
                                                ).value =
                                                    this.dataset.fix || "";


                                                document.getElementById(
                                                    "UpdateCalcCode"
                                                ).value =
                                                    this.dataset.calc || "";


                                                document.getElementById(
                                                    "UpdatePercent"
                                                ).value =
                                                    this.dataset.percent || "";


                                                document.getElementById(
                                                    "UpdateMinLimit"
                                                ).value =
                                                    this.dataset.min || "";


                                                document.getElementById(
                                                    "UpdateMaxLimit"
                                                ).value =
                                                    this.dataset.max || "";


                                                document.getElementById(
                                                    "UpdateMinDays"
                                                ).value =
                                                    this.dataset.days || "";

                                                const formulaInput =
                                                    document.getElementById("UpdateFormula");

                                                const formulaBox =
                                                    document.getElementById("SpecialAllowanceFormulaBox");

                                                const formulaValue =
                                                    this.dataset.formula || "";

                                                if (formulaInput) {
                                                    formulaInput.value = formulaValue;
                                                }

                                                const fixValue = this.dataset.fix || "";
                                                const calcValue = this.dataset.calc || "";
                                                const percentValue = this.dataset.percent || "";

                                                const fixRadio =
                                                    document.getElementById("AllowanceTypeFix");

                                                const percentRadio =
                                                    document.getElementById("AllowanceTypePercent");

                                                const formulaRadio =
                                                    document.getElementById("AllowanceTypeSpecialFormula");

                                                const fixBox =
                                                    document.getElementById("AllowanceFixAmountBox");

                                                const calcBox =
                                                    document.getElementById("AllowanceCalcCodeBox");

                                                const percentBox =
                                                    document.getElementById("AllowancePercentBox");

                                                const fixInput =
                                                    document.getElementById("UpdateFixAmount");

                                                const calcInput =
                                                    document.getElementById("UpdateCalcCode");

                                                const percentInput =
                                                    document.getElementById("UpdatePercent");

                                                const useFormula =
                                                    String(formulaValue).trim() !== "";

                                                const usePercentage =
                                                    !useFormula &&
                                                    (
                                                        (
                                                            String(calcValue).trim() !== "" &&
                                                            Number(calcValue) !== 0
                                                        )
                                                        ||
                                                        (
                                                            String(percentValue).trim() !== "" &&
                                                            Number(percentValue) !== 0
                                                        )
                                                    );

                                                function setAllowanceMode(mode) {

                                                    if (fixRadio) fixRadio.checked = mode === "fix";
                                                    if (percentRadio) percentRadio.checked = mode === "percent";
                                                    if (formulaRadio) formulaRadio.checked = mode === "formula";

                                                    if (fixBox) fixBox.style.display = mode === "fix" ? "" : "none";
                                                    if (calcBox) calcBox.style.display = mode === "percent" ? "" : "none";
                                                    if (percentBox) percentBox.style.display = mode === "percent" ? "" : "none";
                                                    if (formulaBox) formulaBox.style.display = mode === "formula" ? "" : "none";

                                                    if (fixInput) {
                                                        fixInput.disabled = mode !== "fix";
                                                        if (mode === "fix") fixInput.value = fixValue;
                                                    }

                                                    if (calcInput) {
                                                        calcInput.disabled = mode !== "percent";
                                                        if (mode === "percent") calcInput.value = calcValue;
                                                    }

                                                    if (percentInput) {
                                                        percentInput.disabled = mode !== "percent";
                                                        if (mode === "percent") percentInput.value = percentValue;
                                                    }

                                                    if (formulaInput) {
                                                        formulaInput.disabled = mode !== "formula";
                                                        formulaInput.required = mode === "formula";
                                                        if (mode === "formula") formulaInput.value = formulaValue;
                                                    }
                                                }

                                                setAllowanceMode(
                                                    useFormula
                                                        ? "formula"
                                                        : (usePercentage ? "percent" : "fix")
                                                );

                                                if (fixRadio) {
                                                    fixRadio.onchange = function () {
                                                        if (this.checked) setAllowanceMode("fix");
                                                    };
                                                }

                                                if (percentRadio) {
                                                    percentRadio.onchange = function () {
                                                        if (this.checked) setAllowanceMode("percent");
                                                    };
                                                }

                                                if (formulaRadio) {
                                                    formulaRadio.onchange = function () {
                                                        if (this.checked) setAllowanceMode("formula");
                                                    };
                                                }

                                        }
                                    );

                                }
                            );

                        }
                    );

                                    // ============================================================
                    // SPECIAL FORMULA STRICT INPUT
                    // Admin can type only:
                    // B -> BASIC, D -> DA, H -> HRA
                    // numbers 0-9 and + - * / ( ) -- NO SPACES
                    // ============================================================
                    const specialFormulaInput = document.getElementById("UpdateFormula");

                    if (specialFormulaInput) {

                        function expandFormulaToken(character) {
                            const upper = String(character || "").toUpperCase();
                            if (upper === "B") return "BASIC";
                            if (upper === "D") return "DA";
                            if (upper === "H") return "HRA";
                            if (upper === "F") return "FDA1";
                            if (upper === "V") return "VDA";
                            return "";
                        }

                        function sanitizeFormulaValue(value) {
                            const tokens = String(value || "")
                                .toUpperCase()
                                .match(/FDA1|FDA2|BASIC|VDA|HRA|DA|[0-9]+(?:\.[0-9]+)?|[+\-*/()]/g);
                            return tokens ? tokens.join("") : "";
                        }

                        specialFormulaInput.addEventListener("beforeinput", function (event) {
                            // Allow complete variable names to be typed/pasted (FDA1, FDA2, VDA).
                            if (!event.inputType || !event.inputType.startsWith("insert")) return;
                            if (event.inputType === "insertFromPaste") return;
                            if (event.data && !/^[A-Za-z0-9.+\-*/()]+$/.test(event.data))
                                event.preventDefault();
                        });

                        specialFormulaInput.addEventListener("paste", function (event) {
                            event.preventDefault();

                            const input = event.target;
                            const pastedText =
                                (event.clipboardData || window.clipboardData)
                                    .getData("text") || "";

                            const cleanText = sanitizeFormulaValue(pastedText);
                            const start = input.selectionStart ?? input.value.length;
                            const end = input.selectionEnd ?? start;

                            input.value =
                                input.value.substring(0, start) +
                                cleanText +
                                input.value.substring(end);

                            const newCaret = start + cleanText.length;
                            input.setSelectionRange(newCaret, newCaret);
                        });

                        // Final safety check for drag/drop, browser autofill or other input.
                        specialFormulaInput.addEventListener("blur", function () {
                            const cleanValue = sanitizeFormulaValue(this.value);
                            if (this.value !== cleanValue) {
                                this.value = cleanValue;
                                this.setSelectionRange(cleanValue.length, cleanValue.length);
                            }
                        });
                    }

                </script>
            }


        </div>

    </div>

</div>



