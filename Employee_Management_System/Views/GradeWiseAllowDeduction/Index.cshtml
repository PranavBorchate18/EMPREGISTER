                <!-- UPDATE DEDUCTION MODAL JAVASCRIPT -->
                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                        const byId = id => document.getElementById(id);
                        const fixRadio = byId('DeductionTypeFix');
                        const percentRadio = byId('DeductionTypePercent');
                        const formulaRadio = byId('DeductionTypeFormula');
                        const fixInput = byId('UpdateDeductionFixAmount');
                        const calcInput = byId('UpdateDeductionCalcCode');
                        const percentInput = byId('UpdateDeductionPercent');
                        const formulaInput = byId('UpdateDeductionFormula');
                        const suggestion = byId('DeductionFormulaSuggestions');
                        const modal = byId('updateDeductionModal');
                        if (!modal || !formulaInput) return;

                        function setMode(mode) {
                            fixRadio.checked = mode === 'fix';
                            percentRadio.checked = mode === 'percent';
                            formulaRadio.checked = mode === 'formula';
                            byId('DeductionFixAmountBox').style.display = mode === 'fix' ? '' : 'none';
                            byId('DeductionCalcCodeBox').style.display = mode === 'percent' ? '' : 'none';
                            byId('DeductionPercentBox').style.display = mode === 'percent' ? '' : 'none';
                            byId('DeductionFormulaBox').style.display = mode === 'formula' ? '' : 'none';
                            fixInput.disabled = mode !== 'fix';
                            calcInput.disabled = mode !== 'percent';
                            percentInput.disabled = mode !== 'percent';
                            formulaInput.disabled = mode !== 'formula';
                            formulaInput.required = mode === 'formula';
                            if (mode !== 'formula') suggestion.style.display = 'none';
                        }

                        document.querySelectorAll('.btnUpdateDeduction').forEach(button => {
                            button.addEventListener('click', function () {
                                const data = this.dataset;
                                byId('UpdateDeductionGradeCode').value = data.code || '';
                                byId('UpdateDeductionGradeCodeDisplay').value = data.code || '';
                                byId('UpdateDeductionGradeName').value = data.name || '';
                                fixInput.value = data.fix || '';
                                calcInput.value = data.calc || '';
                                percentInput.value = data.percent || '';
                                formulaInput.value = data.formula || '';
                                byId('UpdateDeductionMinLimit').value = data.min || '';
                                byId('UpdateDeductionMaxLimit').value = data.max || '';
                                byId('UpdateDeductionMinDays').value = data.days || '';
                                const hasPercent = Number(data.calc || 0) !== 0 || Number(data.percent || 0) !== 0;
                                setMode(data.formula ? 'formula' : (hasPercent ? 'percent' : 'fix'));
                            });
                        });
                        fixRadio.addEventListener('change', () => { if (fixRadio.checked) setMode('fix'); });
                        percentRadio.addEventListener('change', () => { if (percentRadio.checked) setMode('percent'); });
                        formulaRadio.addEventListener('change', () => { if (formulaRadio.checked) setMode('formula'); });

                        // Suggest SUBTOTAL after typing S; preserve other letters and numbers.
                        formulaInput.addEventListener('input', () => {
                            const caret = formulaInput.selectionStart || 0;
                            const prefix = formulaInput.value.slice(0, caret);
                            suggestion.style.display = /(?:^|[^A-Za-z0-9_])S$/i.test(prefix) ? '' : 'none';
                        });
                        byId('InsertDeductionSubtotal').addEventListener('click', () => {
                            const end = formulaInput.selectionStart ?? formulaInput.value.length;
                            const start = Math.max(0, end - 1);
                            formulaInput.value = formulaInput.value.slice(0, start) + 'SUBTOTAL' + formulaInput.value.slice(end);
                            formulaInput.focus();
                            formulaInput.setSelectionRange(start + 8, start + 8);
                            suggestion.style.display = 'none';
                        });
                        modal.querySelector('form').addEventListener('submit', event => {
                            if (!formulaRadio.checked) return;
                            const value = formulaInput.value.trim().toUpperCase();
                            const rest = value.replace(/SUBTOTAL|FDA1|FDA2|BASIC|VDA|HRA|DA|(?:\d+(?:\.\d+)?|\.\d+)|[+\-*/()\s]/g, '');
                            if (!value || rest) {
                                event.preventDefault();
                                formulaInput.setCustomValidity('Use valid formula variables, numbers and arithmetic operators.');
                                formulaInput.reportValidity();
                            } else {
                                formulaInput.setCustomValidity('');
                            }
                        });
                        formulaInput.addEventListener('input', () => formulaInput.setCustomValidity(''));
                    });
                </script>
            }



