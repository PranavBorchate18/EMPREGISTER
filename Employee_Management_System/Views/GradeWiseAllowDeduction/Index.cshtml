                                        button.addEventListener(
                                            "click",
                                            function () {


                                                document.getElementById(
                                                    "UpdateGradeCode"
                                                ).value =
                                                    this.dataset.code || "";


                                                document.getElementById(
                                                    "UpdateGradeCodeDisplay"
                                                ).value =
