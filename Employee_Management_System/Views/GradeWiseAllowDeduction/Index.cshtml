<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Allowance selection is database-based now.
        // Remove stale browser data left by the old implementation.
        localStorage.removeItem("gradeWiseAllowanceSelections");

        const allowanceCheckboxes =
            Array.from(
                document.querySelectorAll(
                    ".grade-apply-checkbox"
                )
            );

        const totalGrades =
            Number(
                "@(Model.Grades?.Count ?? 0)"
            ) || 0;

        const antiforgeryInput =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

        const antiforgeryToken =
            antiforgeryInput
                ? antiforgeryInput.value
                : "";


        function setEditButton(
            checkbox,
            visible
        ) {
            const row =
                checkbox.closest("tr");

            const editButton =
                row
                    ? row.querySelector(
                        ".btnEditAllowance"
                      )
                    : null;

            if (!editButton) {
                return;
            }

            editButton.classList.toggle(
                "d-none",
                !visible
            );
        }


        function updateSelectedSummary() {

            const selectedCount =
                allowanceCheckboxes
                    .filter(
                        x => x.checked
                    )
                    .length;

            const summary =
                document.querySelector(
                    ".allowance-selected-summary"
                );

            if (summary) {
                summary.textContent =
                    "Selected Grades : " +
                    selectedCount +
                    " / " +
                    totalGrades;
            }

            const selectAll =
                document.getElementById(
                    "selectAllGrades"
                );

            if (selectAll) {
                selectAll.checked =
                    allowanceCheckboxes.length > 0 &&
                    selectedCount ===
                    allowanceCheckboxes.length;

                selectAll.indeterminate =
                    selectedCount > 0 &&
                    selectedCount <
                    allowanceCheckboxes.length;
            }
        }


        async function saveApplyState(
            checkbox,
            isSelected
        ) {
            const body =
                new URLSearchParams();

            body.append(
                "allowanceCode",
                checkbox.dataset.allowanceCode || "0"
            );

            body.append(
                "gradeCode",
                checkbox.dataset.gradeCode || "0"
            );

            body.append(
                "isSelected",
                isSelected ? "true" : "false"
            );

            body.append(
                "__RequestVerificationToken",
                antiforgeryToken
            );


            const response =
                await fetch(
                    '@Url.Action("UpdateAllowanceApply", "GradeWiseAllowDeduction")',
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded; charset=UTF-8"
                        },
                        body:
                            body.toString()
                    }
                );


            if (!response.ok) {
                throw new Error(
                    "Server request failed."
                );
            }

            return await response.json();
        }


        // Initial state comes from dbo.allwfoot.Apply.
        allowanceCheckboxes.forEach(
            function (checkbox) {

                const dbSelected =
                    String(
                        checkbox.dataset.dbSelected ||
                        "false"
                    ).toLowerCase() ===
                    "true";

                checkbox.checked =
                    dbSelected;

                setEditButton(
                    checkbox,
                    dbSelected
                );


                // IMPORTANT:
                // Checkbox select -> only show Edit button.
                // No row is inserted until Admin clicks Edit
                // and saves the modal.
                checkbox.addEventListener(
                    "change",
                    async function (event) {

                        // Block older localStorage handlers.
                        event.stopImmediatePropagation();

                        const isChecked =
                            this.checked;

                        setEditButton(
                            this,
                            isChecked
                        );

                        updateSelectedSummary();


                        // Checked:
                        // UI only. Save happens from Edit modal.
                        if (isChecked) {
                            return;
                        }


                        // Unchecked:
                        // If database row exists, set Apply = 0.
                        // Do not delete values/row.
                        try {
                            const result =
                                await saveApplyState(
                                    this,
                                    false
                                );

                            if (!result.success) {
                                throw new Error(
                                    result.message ||
                                    "Unable to update Apply."
                                );
                            }

                            this.dataset.dbSelected =
                                "false";
                        }
                        catch (error) {

                            // If database update fails, restore
                            // previously saved database state.
                            const dbSelected =
                                String(
                                    this.dataset.dbSelected ||
                                    "false"
                                ).toLowerCase() ===
                                "true";

                            this.checked =
                                dbSelected;

                            setEditButton(
                                this,
                                dbSelected
                            );

                            updateSelectedSummary();

                            alert(
                                "Unable to update Apply. " +
                                error.message
                            );
                        }
                    },
                    true
                );
            }
        );


        // Select All:
        // Checked -> show Edit buttons only.
        // Unchecked -> existing DB rows get Apply = 0.
        const selectAll =
            document.getElementById(
                "selectAllGrades"
            );

        if (selectAll) {

            selectAll.addEventListener(
                "change",
                async function (event) {

                    event.stopImmediatePropagation();

                    const shouldCheck =
                        this.checked;

                    for (const checkbox of allowanceCheckboxes) {

                        checkbox.checked =
                            shouldCheck;

                        setEditButton(
                            checkbox,
                            shouldCheck
                        );

                        if (!shouldCheck) {
                            try {
                                const result =
                                    await saveApplyState(
                                        checkbox,
                                        false
                                    );

                                if (result.success) {
                                    checkbox.dataset.dbSelected =
                                        "false";
                                }
                            }
                            catch {
                                // Keep processing remaining grades.
                            }
                        }
                    }

                    updateSelectedSummary();
                },
                true
            );
        }


        updateSelectedSummary();
    });
</script>


