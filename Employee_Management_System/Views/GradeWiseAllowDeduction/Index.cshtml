                    selectedCount ===
                    deductionCheckboxes.length;

                selectAll.indeterminate =
                    selectedCount > 0 &&
                    selectedCount <
                    deductionCheckboxes.length;
            }
        }


        async function saveDeductionApplyState(
            checkbox,
            isSelected
        ) {
            const body =
                new URLSearchParams();

            body.append(
                "deductionCode",
                checkbox.dataset.deductionCode || "0"
            );

            body.append(
                "gradeCode",
                checkbox.dataset.gradeCode || "0"
            );

            body.append(
                "isSelected",
                isSelected ? "true" : "false"
            );

            body.append(
                "__RequestVerificationToken",
                antiforgeryToken
            );

            const response =
                await fetch(
                    '@Url.Action("UpdateDeductionApply", "GradeWiseAllowDeduction")',
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded; charset=UTF-8"
                        },
